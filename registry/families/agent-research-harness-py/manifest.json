{
  "id": "agent-research-harness-py",
  "description": "Python research harness — propose hypotheses, screen cheaply (1 rep), validate winners (5 rep) with bootstrap CI + Cohen's d. Each hypothesis runs in an isolated tangle-sandbox so treatments cannot contaminate each other. Statistical math (scipy.stats) mirrors the TS sibling family byte-for-byte; verdicts are stable across languages.",
  "tags": [
    "agent-runtime",
    "research-harness",
    "experimentation",
    "tangle-sandbox",
    "scipy",
    "python"
  ],
  "taxonomy": {
    "language": "python",
    "runtime": "python",
    "surface": "research-runner"
  },
  "defaults": {
