{
  "id": "shadcn",
  "description": "Adds shadcn/ui component system with cn() utility, path aliases, and base UI components ready to use.",
  "appliesTo": [
    "react-vite-ts",
    "nextjs-ts",
    "fullstack-ts",
    "remix-ts",
    "electron-desktop-ts",
    "tauri-desktop"
  ],
  "files": [
    {
      "source": "files/shadcn-config.json",
      "target": "shadcn-config.json"
    },
    {
      "source": "files/utils.ts",
      "target": "src/lib/utils.ts"
    },
    {
      "source": "files/alert.tsx",
      "target": "src/components/ui/alert.tsx"
    },
