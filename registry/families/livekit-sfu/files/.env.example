# Copy to .env and replace both values. Secret must be ≥32 bytes. The same
# pair lives in livekit.yaml under `keys:` — keep them in sync.
LIVEKIT_API_KEY={{livekitApiKey}}
LIVEKIT_API_SECRET={{livekitApiSecret}}
LIVEKIT_WS_URL=ws://localhost:{{port}}

# Control-plane HTTP port (the token-minting Express server in src/server.ts).
CONTROL_PORT={{controlPort}}
