# Path to the registry/families/ directory the marketplace lists. Either an
# absolute path on the host (server-render mode) or a URL to a JSON snapshot
# fetched at runtime.
#
# Server mode (default): walks the directory at build / request time, reading
# manifest.json + AGENTS.md from each bundle directory.
CATALOG_REGISTRY_PATH=../starter-foundry/registry/families

# Optional: if set, the client fetches a pre-built JSON snapshot of the catalog
# from this URL instead of reading the local filesystem. Useful when deploying
# the marketplace UI to Vercel / Cloudflare Pages where the foundry repo isn't
# present.
# CATALOG_API_URL=https://api.example.com/catalog/bundles.json

# Optional: backend deploy endpoint. If set, the DeployFlow modal POSTs the
# bundle id + sandbox name + task here instead of showing copy-paste commands.
# Leave unset to operate in copy-paste mode (the default — works without a
# server).
# DEPLOY_API_URL=https://api.example.com/deploy
