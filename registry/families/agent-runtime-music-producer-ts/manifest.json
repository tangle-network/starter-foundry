{
  "id": "agent-runtime-music-producer-ts",
  "description": "Voice-first creative music-producer agent bundle — a collaborative mixing / mastering / arrangement coach who listens before suggesting and never overrides the artist's vision. Demonstrates the agent-runtime substrate composing with phony-voice + structured-output-blocks on the Tangle floor.",
  "tags": [
    "agent-runtime",
    "music-production",
    "creative-agent",
    "voice-first",
    "cloudflare-worker"
  ],
  "taxonomy": {
    "language": "markdown",
    "runtime": "cloudflare-worker",
    "surface": "agent-runtime"
  },
  "includes": [
    "agent-base:tangle",
    "agent-tools:phony-voice",
    "agent-output:blocks"
  ],
  "defaults": {
    "projectType": "agent-runtime-music-producer",
    "agentName": "music-producer",
    "allowedDomains": ["api.tangle.tools"],
    "allowedEnv": ["TANGLE_ROUTER_KEY", "PHONY_API_KEY"],
    "publicVars": ["AGENT_NAME"],
    "routes": [
      { "path": "/api/chat", "auth": "bearer", "callsTools": ["voice-stt", "voice-tts", "arrangement-review", "mix-feedback"] },
      { "path": "/api/health", "auth": "none", "callsTools": [] }
    ],
    "declaredCapabilities": ["arrangement-review", "mix-feedback", "weekly-listening-protocol"],
    "runtime": {
      "sandbox": "tangle",
      "noNewPrivileges": true,
      "capDrop": "ALL"
    }
  },
  "files": [
    { "source": "files/system-prompt.md", "target": "system-prompt.md" },
    { "source": "files/templates/index.json", "target": "templates/index.json" },
    { "source": "files/templates/arrangement-review.md", "target": "templates/arrangement-review.md" },
    { "source": "files/templates/mix-feedback-protocol.md", "target": "templates/mix-feedback-protocol.md" },
    { "source": "files/templates/weekly-listening-prompt.md", "target": "templates/weekly-listening-prompt.md" },
    { "source": "files/wrangler.toml", "target": "wrangler.toml" },
    { "source": "files/README.md", "target": "README.md" }
  ],
  "validationChecks": [
    { "type": "file-exists", "path": "system-prompt.md" },
    { "type": "file-exists", "path": "templates/index.json" },
    { "type": "file-exists", "path": "wrangler.toml" },
    { "type": "prompt-frontmatter-valid", "path": "system-prompt.md" },
    { "type": "template-index-valid", "path": "templates/index.json" },
    { "type": "cron-syntax-valid", "path": "wrangler.toml" }
  ],
  "contextHints": {
    "commands": [],
    "entrypoints": ["system-prompt.md"],
    "extensionPoints": ["templates/", "src/lib/tools/"]
  },
  "keywords": [
    "music-producer",
    "mixing",
    "mastering",
    "arrangement",
    "DAW",
    "voice"
  ],
  "tieredKeywords": {
    "tier1": ["music-producer", "music producer", "music-production-agent", "music production agent", "creative-director-music", "music production"],
    "tier2": ["mixing", "mastering", "arrangement", "DAW", "sample-pack", "stem-separation", "mix feedback"],
    "tier3": ["music"],
    "archetypes": ["agent-in-sandbox", "creative-agent", "voice-first"]
  }
}
