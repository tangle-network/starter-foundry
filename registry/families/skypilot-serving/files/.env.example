# HuggingFace token — needed for gated models (Llama, Mistral, Gemma).
# Pass into sky serve at launch time:
#     sky serve up -n {{endpointName}} service.yaml --env HF_TOKEN=$HF_TOKEN
HF_TOKEN=

# Override the default model without editing service.yaml:
#     sky serve up -n {{endpointName}} service.yaml --env MODEL_ID=$MODEL_ID
MODEL_ID={{modelId}}

# Accelerator pick. SkyPilot-specific strings: A100:1, A100-80GB:1, H100:1, L4:1.
# Cloud-specific instance types go under resources.instance_type in service.yaml.
ACCELERATOR={{acceleratorSpec}}
