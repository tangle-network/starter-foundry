# LLM endpoint used for answer synthesis. Defaults to a local Ollama install.
# Any OpenAI-compatible /api/chat or /v1/chat/completions server works —
# vLLM, TGI, llama.cpp server, LiteLLM, OpenAI itself, etc.
LLM_BASE_URL={{llmBaseUrl}}
LLM_MODEL={{llmModel}}

# Embedding model loaded locally via sentence-transformers.
# Changing this invalidates the Chroma collection — delete VECTOR_DB_DIR.
EMBEDDING_MODEL={{embeddingModel}}

# On-disk Chroma collection.
VECTOR_DB_DIR={{vectorDbDir}}

# Retrieval parameters.
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4

# Source corpus directory.
DOCS_DIR=./docs
