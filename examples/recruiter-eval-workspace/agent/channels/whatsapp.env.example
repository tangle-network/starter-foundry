# WhatsApp Cloud API — Meta's official Graph API path.
# Set up: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
#
# Step-by-step:
#  1. Create a Meta app:                  https://developers.facebook.com/apps/
#  2. Add the "WhatsApp" product to it.
#  3. Copy the access token + phone number ID from the WhatsApp dashboard.
#  4. Copy the App Secret from App Settings → Basic.
#  5. Pick any verify token (a string you choose) — Meta sends it back during
#     the webhook handshake so you can confirm ownership.
#  6. Configure the webhook URL in the WhatsApp dashboard:
#       https://<your-host>/webhooks/whatsapp
#     subscribed to the `messages` field.

# Bearer token for graph.facebook.com calls.
# Source: developers.facebook.com → Your App → WhatsApp → API Setup → Temporary access token
# (Use a permanent System User token in production.)
WHATSAPP_ACCESS_TOKEN=

# Numeric phone number ID issued by Meta (NOT the phone number itself).
# Source: same WhatsApp API Setup page.
WHATSAPP_PHONE_NUMBER_ID=

# App secret used to verify the X-Hub-Signature-256 header on inbound webhooks.
# Source: developers.facebook.com → Your App → Settings → Basic → App Secret
WHATSAPP_APP_SECRET=

# Arbitrary string YOU choose. Meta echoes it back during the GET-challenge
# handshake when subscribing the webhook; verifyWebhook() compares it
# constant-time against this env var.
WHATSAPP_VERIFY_TOKEN=
