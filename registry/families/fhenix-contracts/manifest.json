{
  "id": "fhenix-contracts",
  "description": "Fhenix FHE-enabled Solidity starter for encrypted on-chain computation.",
  "tags": ["fhenix", "fhe", "solidity", "privacy", "contracts"],
  "taxonomy": { "language": "solidity", "runtime": "fhenix", "surface": "contracts" },
  "domainPack": {
    "domain": {
      "family": "fhe",
      "provider": "fhenix",
      "protocol": "cofhe",
      "runtime": "hardhat",
      "surface": "contracts"
    },
    "provides": ["solidity-contracts", "fhe-types", "cofhe", "hardhat-build"],
    "requires": ["hardhat"],
    "ambiguityGroup": "fhe-contracts",
    "validationCommands": ["npx hardhat compile", "npx hardhat test"],
    "authenticitySignals": [
      "euint",
      "ebool",
      "InEuint",
      "FHE.asEuint",
      "FHE.add",
      "FHE.select",
      "FHE.allow",
      "cofhejs",
      "sealed bid",
      "private voting",
      "encrypted balance"
    ],
    "authenticityGroups": [
      {
        "id": "cofhe-sdk",
        "description": "At least one CoFHE package or import signal should survive generation.",
        "minRequired": 1,
        "signals": ["cofhejs", "@fhenixprotocol/cofhe-contracts", "cofhe-contracts"]
      },
      {
        "id": "cofhe-contract-apis",
        "description": "Generated contracts should use encrypted inputs and access-control APIs.",
        "minRequired": 2,
        "signals": ["InEuint", "FHE.asEuint", "FHE.allow", "FHE.select"]
      },
      {
        "id": "fhe-product-behavior",
        "description": "The scaffold should implement a real encrypted workflow, not plain Solidity placeholders.",
        "minRequired": 1,
        "signals": ["sealed bid", "private voting", "encrypted balance"]
      }
    ],
    "routingPrompts": [
      {
        "prompt": "Build a Fhenix Hardhat encrypted counter using cofhejs",
        "expectedFamily": "fhenix-contracts",
        "expectedLayers": ["framework:fhenix-contracts"]
      }
    ]
  },
  "slots": {},
  "defaults": {
    "projectType": "contracts",
    "encryptionScheme": "CoFHE",
    "fhenixNetwork": "nitrogen"
  },
  "files": [
    { "source": "files/package.json", "target": "package.json" }
  ],
  "validationChecks": [
    { "type": "file-exists", "path": "contracts/FHECounter.sol" },
    { "type": "file-exists", "path": "hardhat.config.ts" },
    { "type": "file-exists", "path": "test/FHECounter.test.ts" },
    { "type": "file-exists", "path": "deploy/deploy.ts" }
  ],
  "contextHints": {
    "commands": ["npx hardhat compile", "npx hardhat test"],
    "entrypoints": ["contracts/FHECounter.sol", "hardhat.config.ts", "test/FHECounter.test.ts"],
    "extensionPoints": ["contracts/", "test/", "deploy/"]
  },
  "keywords": ["fhenix", "fhe", "fully homomorphic", "encrypted computation", "euint", "fhevm", "inco"],
  "tieredKeywords": {
    "tier1": ["fhenix", "fhe", "fully homomorphic", "fhevm", "inco"],
    "tier2": ["encrypted computation", "encrypted auction", "encrypted balance", "private stablecoin", "euint", "TFHE"],
    "tier3": []
  }
}
