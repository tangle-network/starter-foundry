{
  "id": "agent-runtime-history-tutor-ts",
  "description": "Voice-first history tutor agent bundle — primary-source analysis, historiographic debate, and timeline reasoning. Explicitly NOT a substitute for a credentialed history teacher, not a source of original archival research, not a replacement for peer-reviewed scholarship. Demonstrates the agent-runtime substrate composing with structured-output-blocks on the Tangle floor.",
  "tags": [
    "agent-runtime",
    "history-tutor",
    "education",
    "primary-sources",
    "historiography",
    "cloudflare-worker"
  ],
  "taxonomy": {
    "language": "markdown",
    "runtime": "cloudflare-worker",
    "surface": "agent-runtime"
  },
  "includes": [
    "agent-base:tangle",
    "agent-base:secure",
    "agent-output:blocks"
  ],
  "defaults": {
    "projectType": "agent-runtime-history-tutor",
    "agentName": "history-tutor",
    "publicVars": [
      "AGENT_NAME"
    ],
    "routes": [
      {
        "path": "/api/chat",
        "auth": "bearer",
        "callsTools": [
          "source-analysis",
          "historiographic-debate",
          "timeline-reasoning"
        ]
      },
      {
        "path": "/api/health",
        "auth": "none",
        "callsTools": []
      }
    ],
    "declaredCapabilities": [
      "source-analysis",
      "historiographic-debate",
      "timeline-reasoning"
    ],
    "runtime": {
      "sandbox": "tangle",
      "noNewPrivileges": true,
      "capDrop": "ALL"
    },
    "stakes": "low",
    "advisoryOnly": false,
    "outboundDomains": [
      "api.tangle.tools"
    ],
    "secrets": [
      "TANGLE_ROUTER_KEY"
    ]
  },
  "files": [
    {
      "source": "files/agent.json",
      "target": "agent.json"
    },
    {
      "source": "files/system-prompt.md",
      "target": "system-prompt.md"
    },
    {
      "source": "files/methodology/index.json",
      "target": "methodology/index.json"
    },
    {
      "source": "files/methodology/source-analysis.md",
      "target": "methodology/source-analysis.md"
    },
    {
      "source": "files/methodology/historiographic-debate.md",
      "target": "methodology/historiographic-debate.md"
    },
    {
      "source": "files/methodology/timeline-reasoning.md",
      "target": "methodology/timeline-reasoning.md"
    },
    {
      "source": "files/README.md",
      "target": "README.md"
    },
    {
      "source": "files/TOOLS.md",
      "target": "TOOLS.md"
    }
  ],
  "contextHints": {
    "commands": [],
    "entrypoints": [
      "system-prompt.md"
    ],
    "extensionPoints": [
      "templates/",
      "src/lib/tools/"
    ]
  },
  "tieredKeywords": {
    "tier1": [
      "history-tutor",
      "history tutor",
      "historiography-agent",
      "historiography agent",
      "source-analysis-agent",
      "source analysis agent",
      "timeline-reasoning-agent",
      "timeline reasoning agent"
    ],
    "tier2": [
      "primary-sources",
      "primary sources",
      "historiographic-debate",
      "historiographic debate",
      "causation",
      "periodization",
      "counterfactual",
      "archival-methods",
      "archival methods"
    ],
    "tier3": [],
    "archetypes": [
      "agent-in-sandbox",
      "tutor-agent"
    ]
  }
}
