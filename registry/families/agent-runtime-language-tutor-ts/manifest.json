{
  "id": "agent-runtime-language-tutor-ts",
  "description": "Voice-first language tutor agent bundle \u2014 Krashen-aligned comprehensible input + spaced-repetition methodology, CEFR-calibrated to the learner's current level. Default target language is Spanish; configurable via `defaults.targetLanguage` (es / ja / fr / zh / etc.). Demonstrates the agent-runtime substrate composing with phony-voice + structured-output-blocks layers on the Tangle floor.",
  "tags": [
    "agent-runtime",
    "language-tutor",
    "education",
    "voice-first",
    "cloudflare-worker"
  ],
  "taxonomy": {
    "language": "markdown",
    "runtime": "cloudflare-worker",
    "surface": "agent-runtime"
  },
  "includes": [
    "agent-base:tangle",
    "agent-base:secure",
    "agent-tools:phony-voice",
    "agent-output:blocks"
  ],
  "defaults": {
    "projectType": "agent-runtime-language-tutor",
    "agentName": "language-tutor",
    "targetLanguage": "es",
    "publicVars": [
      "AGENT_NAME",
      "TARGET_LANGUAGE"
    ],
    "routes": [
      {
        "path": "/api/chat",
        "auth": "bearer",
        "callsTools": [
          "voice-stt",
          "voice-tts",
          "daily-conversation",
          "vocab-drill",
          "shadowing"
        ]
      },
      {
        "path": "/api/health",
        "auth": "none",
        "callsTools": []
      }
    ],
    "declaredCapabilities": [
      "daily-conversation-prompt",
      "vocabulary-drill",
      "shadowing-protocol"
    ],
    "runtime": {
      "sandbox": "tangle",
      "noNewPrivileges": true,
      "capDrop": "ALL"
    },
    "schedule": [
      {
        "id": "scheduled-1",
        "cron": "0 13 * * *",
        "capability": "daily-conversation-prompt"
      }
    ],
    "outboundDomains": [
      "api.tangle.tools"
    ],
    "secrets": [
      "TANGLE_ROUTER_KEY",
      "PHONY_API_KEY"
    ]
  },
  "files": [
    {
      "source": "files/system-prompt.md",
      "target": "system-prompt.md"
    },
    {
      "source": "files/methodology/index.json",
      "target": "methodology/index.json"
    },
    {
      "source": "files/methodology/daily-conversation-prompt.md",
      "target": "methodology/daily-conversation-prompt.md"
    },
    {
      "source": "files/methodology/vocabulary-drill.md",
      "target": "methodology/vocabulary-drill.md"
    },
    {
      "source": "files/methodology/shadowing-protocol.md",
      "target": "methodology/shadowing-protocol.md"
    },
    {
      "source": "files/README.md",
      "target": "README.md"
    },
    {
      "source": "files/TOOLS.md",
      "target": "TOOLS.md"
    }
  ],
  "validationChecks": [
    {
      "type": "file-exists",
      "path": "system-prompt.md"
    },
    {
      "type": "file-exists",
      "path": "methodology/index.json"
    },
    {
      "type": "agents-md-valid",
      "path": "system-prompt.md"
    },
    {
      "type": "methodology-index-valid",
      "path": "methodology/index.json"
    },
    {
      "type": "schedule-valid",
      "path": "manifest.json"
    },
    {
      "type": "file-exists",
      "path": "TOOLS.md"
    }
  ],
  "contextHints": {
    "commands": [],
    "entrypoints": [
      "system-prompt.md"
    ],
    "extensionPoints": [
      "templates/",
      "src/lib/tools/",
      "defaults.targetLanguage"
    ]
  },
  "keywords": [
    "language-tutor",
    "spanish-tutor",
    "japanese-tutor",
    "comprehensible-input",
    "spaced-repetition",
    "shadowing",
    "voice"
  ],
  "tieredKeywords": {
    "tier1": [
      "language-coach-agent",
      "language coach agent"
    ],
    "tier2": [
      "spaced-repetition",
      "spaced repetition",
      "comprehensible-input",
      "comprehensible input",
      "shadowing",
      "tpr",
      "anki",
      "cefr",
      "krashen",
      "second language acquisition"
    ],
    "tier3": [],
    "archetypes": [
      "agent-in-sandbox",
      "tutor-agent",
      "voice-first"
    ]
  }
}
