{
  "id": "tangle-blueprint",
  "description": "Tangle Blueprint workspace with lib, bin, and Solidity service manager.",
  "tags": [
    "tangle",
    "blueprint",
    "rust",
    "infra"
  ],
  "taxonomy": {
    "language": "rust",
    "runtime": "tangle",
    "surface": "blueprint"
  },
  "defaults": {
    "blueprintName": "starter-blueprint",
    "jobName": "ProcessJob"
  },
  "validationChecks": [
    {
      "type": "file-exists",
      "path": "Cargo.toml"
    },
    {
      "type": "file-exists",
      "path": "blueprint.json"
    },
    {
      "type": "file-exists",
      "path": "rust-toolchain.toml"
    },
    {
      "type": "file-exists",
      "path": "contracts/src/HelloBlueprint.sol"
    },
    {
      "type": "file-exists",
      "path": "foundry.toml"
    }
  ],
  "contextHints": {
    "commands": [
      "cargo test -p {{packageName}}-lib",
      "cargo build --release"
    ],
    "entrypoints": [
      "{{packageName}}-bin/src/main.rs",
      "{{packageName}}-lib/src/lib.rs",
      "blueprint.json",
      "contracts/src/HelloBlueprint.sol",
      "Cargo.toml"
    ],
    "preview": null,
    "extensionPoints": [
      "blueprint.json",
      "{{packageName}}-lib/src/lib.rs",
      "contracts/src/HelloBlueprint.sol"
    ]
  },
  "keywords": [
    "tangle blueprint",
    "blueprint sdk",
    "cargo tangle",
    "oracle blueprint",
    "storage blueprint",
    "tangle network",
    "tangle native",
    "tangle oracle",
    "tangle custody",
    "frost blueprint"
  ],
  "tieredKeywords": {
    "tier1": [
      "tangle blueprint",
      "cargo tangle"
    ],
    "tier2": [
      "blueprint sdk",
      "oracle blueprint",
      "storage blueprint",
      "tangle network",
      "tangle native",
      "tangle oracle",
      "tangle custody",
      "frost blueprint"
    ]
  }
}
