// Wrangler config for the Cloudflare Workers deployment target.
// The same Hono app also runs on Node (`pnpm start`) and Bun (`bun run src/index.ts`)
// — pick whichever runtime fits the operator. CF Workers gives you global edge
// + zero-config TLS; Node/Bun give you a regular long-running server.
//
// IMPORTANT: AGENT_PACK_DIR resolves on the local filesystem on Node/Bun. On
// CF Workers, packs MUST be loaded from a manifest URL or bundled — there is
// no persistent fs. See docs/DEPLOYMENT.md for the manifest-URL pattern.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "{{serviceName}}",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "AGENT_PACK_DIR": "./agent-packs",
    "ORCHESTRATOR_ENV": "production"
  }
  // Secrets (set via `wrangler secret put`):
  //   TANGLE_ROUTER_KEY        — router.tangle.tools API key (mandatory)
  //   ORCHESTRATOR_API_KEYS    — comma-separated tenant API keys
  //   WEBHOOK_HMAC_SECRET      — HMAC secret for /webhooks/:event
}
