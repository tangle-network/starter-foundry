{
  "id": "code-editor",
  "description": "Browser code editor using CodeMirror 6 — syntax highlighting, theming, line numbers, autocomplete. For AI coding assistants, markdown editors, configuration UIs, playgrounds, query builders.",
  "appliesTo": [
    "react-vite-ts",
    "nextjs-ts",
    "fullstack-ts",
    "remix-ts",
    "sveltekit-ts",
    "vue-ts"
  ],
  "files": [
    {
      "source": "files/code-editor.tsx",
      "target": "src/components/code-editor.tsx"
    }
  ],
  "packageDeps": {
    "dependencies": {
      "codemirror": "^6.0.1",
      "@codemirror/view": "^6.0.0",
      "@codemirror/state": "^6.0.0",
      "@codemirror/lang-javascript": "^6.0.0",
      "@codemirror/lang-json": "^6.0.0",
      "@codemirror/theme-one-dark": "^6.0.0",
      "@codemirror/commands": "^6.0.0",
      "@codemirror/autocomplete": "^6.0.0"
    }
  },
  "keywords": [
    "code editor",
    "codemirror",
    "monaco",
    "syntax highlight",
    "query editor",
    "playground editor",
    "markdown editor with code"
  ],
  "contextHints": {
    "extensionPoints": [
      "src/components/code-editor.tsx"
    ]
  },
  "buildHints": {
    "whenToUse": "Attach when the product surface exposes a code/query/markup editor — AI code assistants, prompt playgrounds, markdown editors with syntax-highlighted code blocks, SQL query builders, config editors.",
    "firstSteps": [
      "Import CodeEditor from '@/components/code-editor'",
      "Pass `value`, `onChange`, and optionally a `language` ('javascript' | 'json' | 'typescript')"
    ]
  },
  "tieredKeywords": {
    "archetypes": [
      "code editor",
      "query editor",
      "sql editor",
      "prompt playground",
      "code playground",
      "syntax highlight",
      "syntax highlighting",
      "markdown editor",
      "config editor",
      "schema editor",
      "json editor",
      "javascript editor",
      "typescript editor",
      "codemirror"
    ]
  }
}
