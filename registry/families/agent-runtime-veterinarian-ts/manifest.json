{
  "id": "agent-runtime-veterinarian-ts",
  "description": "Veterinary-reference agent bundle for regulated veterinary practice — general-information packets, husbandry framing, vaccination education, and emergency-recognition checklists. Explicitly NOT a licensed DVM; never diagnoses, never prescribes, escalates to a state-licensed veterinarian and ASPCA Animal Poison Control on any clinical or toxin trigger.",
  "tags": [
    "agent-runtime",
    "veterinary",
    "regulated-medical",
    "advisory-agent",
    "cloudflare-worker"
  ],
  "taxonomy": {
    "language": "markdown",
    "runtime": "cloudflare-worker",
    "surface": "agent-runtime"
  },
  "includes": [
    "agent-base:tangle",
    "agent-base:secure",
    "agent-output:blocks"
  ],
  "defaults": {
    "projectType": "agent-runtime-veterinarian",
    "agentName": "veterinary-reference",
    "publicVars": [
      "AGENT_NAME"
    ],
    "routes": [
      {
        "path": "/api/chat",
        "auth": "bearer",
        "callsTools": [
          "husbandry-lookup",
          "vaccination-framework",
          "emergency-triage"
        ]
      },
      {
        "path": "/api/health",
        "auth": "none",
        "callsTools": []
      }
    ],
    "declaredCapabilities": [
      "husbandry-reference",
      "vaccination-framework",
      "emergency-triage",
      "regulated-disclaimer"
    ],
    "runtime": {
      "sandbox": "tangle",
      "noNewPrivileges": true,
      "capDrop": "ALL"
    },
    "disclaimerRequired": true,
    "notLicensedVet": true,
    "poisonControl": {
      "name": "ASPCA Animal Poison Control Center",
      "number": "888-426-4435",
      "type": "call",
      "note": "paid consultation, 24/7"
    },
    "outboundDomains": [
      "api.tangle.tools",
      "avma.org",
      "fda.gov/cvm"
    ],
    "secrets": [
      "TANGLE_ROUTER_KEY"
    ]
  },
  "files": [
    {
      "source": "files/agent.json",
      "target": "agent.json"
    },
    {
      "source": "files/AGENTS.md",
      "target": "AGENTS.md"
    },
    {
      "source": "files/methodology/index.json",
      "target": "methodology/index.json"
    },
    {
      "source": "files/methodology/husbandry-reference.md",
      "target": "methodology/husbandry-reference.md"
    },
    {
      "source": "files/methodology/vaccination-framework.md",
      "target": "methodology/vaccination-framework.md"
    },
    {
      "source": "files/methodology/emergency-triage.md",
      "target": "methodology/emergency-triage.md"
    },
    {
      "source": "files/README.md",
      "target": "README.md"
    },
    {
      "source": "files/TOOLS.md",
      "target": "TOOLS.md"
    }
  ],
  "validationChecks": [
    {
      "type": "file-exists",
      "path": "AGENTS.md"
    },
    {
      "type": "file-exists",
      "path": "methodology/index.json"
    },
    {
      "type": "agents-md-valid",
      "path": "AGENTS.md"
    },
    {
      "type": "methodology-index-valid",
      "path": "methodology/index.json"
    },
    {
      "type": "file-exists",
      "path": "TOOLS.md"
    }
  ],
  "contextHints": {
    "commands": [],
    "entrypoints": [
      "AGENTS.md"
    ],
    "extensionPoints": [
      "templates/",
      "src/lib/tools/"
    ]
  },
  "keywords": [
    "veterinarian",
    "vet",
    "pet-health",
    "animal-care",
    "vaccination",
    "aspca"
  ],
  "tieredKeywords": {
    "tier1": [
      "veterinarian-agent",
      "veterinarian agent",
      "vet-agent",
      "vet agent",
      "veterinary-reference",
      "veterinary reference"
    ],
    "tier2": [
      "pet-health",
      "pet health",
      "animal-care",
      "animal care",
      "vaccination-schedule",
      "vaccination schedule"
    ],
    "tier3": [
      "pet",
      "vet",
      "animal"
    ],
    "archetypes": [
      "agent-in-sandbox",
      "advisory-agent",
      "regulated-medical"
    ]
  }
}
