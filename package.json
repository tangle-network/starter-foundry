{
  "name": "@tangle-network/starter-foundry",
  "version": "0.6.0",
  "description": "Deterministic project scaffold engine for AI coding platforms",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tangle-network/starter-foundry.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": "./dist/lib/index.js",
    "./planner": "./dist/lib/prompt-planner.js",
    "./compose": "./dist/lib/compose.js",
    "./compose-prompt": "./dist/lib/compose-prompt.js",
    "./agent-context": "./dist/lib/agent-context.js",
    "./industries": "./dist/lib/industries.js",
    "./registry": "./dist/lib/registry.js",
    "./context": "./dist/lib/context-pack.js",
    "./build-plan": "./dist/lib/build-plan.js",
    "./workspace": "./dist/lib/workspace.js",
    "./keywords": "./dist/lib/keywords.js",
    "./types": "./dist/types.js"
  },
  "files": [
    "dist/",
    "registry/",
    "corpus/",
    "specs/"
  ],
  "bin": {
    "starter-foundry": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "tsc",
    "pretest": "node scripts/check-toolchain.mjs",
    "test": "tsc && tsc -p tsconfig.test.json && node --test --test-concurrency=1 dist-tests/*.test.js",
    "catalog": "node dist/cli.js catalog",
    "select": "node dist/cli.js select",
    "compose": "node dist/cli.js compose",
    "workspace:compose": "node dist/cli.js workspace-compose",
    "validate": "node dist/cli.js validate",
    "context": "node dist/cli.js context",
    "workspace:context": "node dist/cli.js workspace-context",
    "bench": "node dist/cli.js bench",
    "workspace:bench": "node dist/cli.js workspace-bench",
    "prompt:e2e": "node dist/cli.js prompt-e2e",
    "prove": "node dist/cli.js prove",
    "audit": "node dist/cli.js audit",
    "evaluate": "node dist/cli.js evaluate",
    "release": "node dist/cli.js release",
    "sync:warm-list": "node scripts/sync-warm-list.mjs",
    "sync:warm-list:write": "node scripts/sync-warm-list.mjs --write",
    "audit:visual": "node scripts/visual-audit.mjs",
    "validate:registry": "node scripts/validate-registry.mjs",
    "new:family": "node scripts/new-family.mjs",
    "new:capability": "node scripts/new-capability.mjs",
    "new:partner": "node scripts/new-partner.mjs",
    "repl": "node scripts/repl.mjs",
    "watch": "node scripts/watch.mjs",
    "docs:gen": "node scripts/generate-docs.mjs",
    "scorecard": "node scripts/refresh-scorecard.mjs",
    "changelog": "node scripts/generate-changelog.mjs",
    "propose:capabilities": "node scripts/propose-capabilities.mjs",
    "propose:archive-dead": "node scripts/archive-dead-families.mjs",
    "refresh:partners": "node scripts/refresh-partner-configs.mjs",
    "trend:archive": "node scripts/archive-scorecard-trend.mjs",
    "cve:sweep": "node scripts/cve-sweep.mjs",
    "propose:family": "node scripts/propose-family.mjs",
    "template:sweep": "node scripts/template-quality-sweep.mjs",
    "template:open-prs": "node scripts/open-template-prs.mjs",
    "template:regression-watch": "node scripts/template-regression-watcher.mjs",
    "trend:pass-rate": "node scripts/family-pass-rate-trend.mjs",
    "dep:cascade": "node scripts/dep-cascade-detector.mjs",
    "sla:probe": "node scripts/sla-probe.mjs",
    "sla:rollup": "node scripts/sla-rollup.mjs",
    "rollback:version": "node scripts/rollback-version.mjs",
    "gen:types": "node scripts/gen-types-from-schemas.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@tangle-network/agent-eval": "link:../agent-eval",
    "@types/node": "^20.0.0",
    "knip": "^6.6.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@ax-llm/ax": "^19.0.45",
    "@huggingface/transformers": "^4.0.0",
    "@tangle-network/tcloud": "^0.4.2"
  },
  "optionalDependencies": {
    "@opentelemetry/api": "^1.9.0"
  }
}
