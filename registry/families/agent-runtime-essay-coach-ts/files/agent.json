{
  "name": "essay-coach",
  "description": "Essay coach agent bundle — guides students through thesis development, argument structuring, and revision cycles. Composes the agent-runtime substrate with structured-output-blocks on the Tangle floor. Advisory only — never replaces a human teacher or grader.",
  "version": "0.1.0",
  "tags": [
    "agent-runtime",
    "essay-coach",
    "writing-tutor",
    "education",
    "cloudflare-worker"
  ],
  "prompt": {
    "systemPromptFile": "system-prompt.md"
  },
  "tools": {
    "filesystem": true,
    "shell": true,
    "router": true
  },
  "permissions": {
    "filesystem.write": "ask",
    "shell.exec": "ask",
    "network": "ask"
  },
  "resources": {
    "files": [
      {
        "source": "methodology/",
        "target": "/workspace/methodology/"
      },
      {
        "source": "README.md",
        "target": "/workspace/README.md"
      },
      {
        "source": "TOOLS.md",
        "target": "/workspace/TOOLS.md"
      }
    ]
  }
}
