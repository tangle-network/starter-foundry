# Mandatory — router.tangle.tools API key. The chat-bridge refuses to start
# without it; this is the single egress point for outbound LLM traffic.
TANGLE_ROUTER_KEY=

# Mandatory — comma-separated list of API keys that authorize incoming
# requests. The orchestrator authenticates callers by exact match on the
# `X-API-Key` header. ROTATE BEFORE PROD. See docs/SECURITY.md.
ORCHESTRATOR_API_KEYS=dev-key-rotate-me

# Mandatory if /webhooks/:event is exposed — HMAC-SHA256 secret used to
# verify inbound webhook signatures. Different secret per environment.
WEBHOOK_HMAC_SECRET=

# Where the orchestrator looks for agent packs. Each subdirectory is one
# agent (single-prompt) or one team (agent-roster.json). On CF Workers
# this must be replaced with a manifest URL — see docs/DEPLOYMENT.md.
AGENT_PACK_DIR=./agent-packs

# Override the LLM router URL if proxying through your own gateway.
# LLM_ROUTER_URL=https://router.tangle.tools

# Cheap routing model used by the LLM-routing path (team rosters with no
# defaultRespondent). Defaults to a small model — override if you need more
# accurate role selection.
ROUTING_MODEL=anthropic/claude-haiku-4-5

# Per-key rate limit. Bucket is in-memory; multi-instance deploys MUST swap
# in Redis or the bucket is per-instance, not per-tenant.
RATE_LIMIT_PER_MIN=60

# HTTP port (Node/Bun only — CF Workers ignores this).
PORT=4196
