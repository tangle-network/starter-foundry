{
  "id": "solana-program",
  "description": "Native Solana-style Rust program starter with real cargo validation.",
  "tags": [
    "solana",
    "rust",
    "program",
    "crypto"
  ],
  "taxonomy": {
    "language": "rust",
    "runtime": "solana",
    "surface": "contracts"
  },
  "defaults": {
    "projectType": "contracts",
    "programName": "starter_foundry_solana",
    "instructionName": "InitializeTreasury"
  },
  "validationChecks": [
    {
      "type": "file-exists",
      "path": "Cargo.toml"
    },
    {
      "type": "command-success",
      "command": [
        "cargo",
        "test",
        "--quiet"
      ],
      "expect": "ok"
    }
  ],
  "contextHints": {
    "commands": [
      "cargo test",
      "cargo check"
    ],
    "entrypoints": [
      "src/lib.rs",
      "Cargo.toml"
    ],
    "preview": null,
    "extensionPoints": [
      "client/README.md"
    ]
  },
  "keywords": [
    "solana",
    "anchor",
    "solana program",
    "program derived address",
    "pda",
    "pyth",
    "switchboard",
    "jupiter",
    "openbook"
  ]
}
