{
  "name": "engineering-manager",
  "description": "Engineering manager agent bundle — 1:1 cadence, sprint planning, incident post-mortems, and technical-debt triage. Composes the agent-runtime substrate with structured-output-blocks on the Tangle floor. Advisory only — never replaces the operator's own judgment, team, or HR processes.",
  "version": "0.1.0",
  "tags": [
    "agent-runtime",
    "engineering-manager",
    "advisory-agent",
    "1:1-cadence",
    "sprint-planning",
    "incident-postmortem",
    "tech-debt",
    "cloudflare-worker"
  ],
  "prompt": {
    "systemPromptFile": "system-prompt.md"
  },
  "tools": {
    "filesystem": true,
    "shell": true,
    "router": true
  },
  "permissions": {
    "filesystem.write": "ask",
    "shell.exec": "ask",
    "network": "ask"
  },
  "resources": {
    "files": [
      {
        "source": "methodology/",
        "target": "/workspace/methodology/"
      },
      {
        "source": "README.md",
        "target": "/workspace/README.md"
      },
      {
        "source": "TOOLS.md",
        "target": "/workspace/TOOLS.md"
      }
    ]
  }
}
