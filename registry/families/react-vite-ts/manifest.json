{
  "id": "react-vite-ts",
  "description": "React and Vite ready TypeScript starter for host-managed previews.",
  "tags": [
    "frontend",
    "typescript",
    "react",
    "vite",
    "preview"
  ],
  "taxonomy": {
    "language": "typescript",
    "runtime": "node",
    "surface": "frontend"
  },
  "defaults": {
    "projectType": "frontend",
    "headline": "Starter Foundry React Surface",
    "subheadline": "A React and Vite ready shell for a host-managed preview."
  },
  "slots": {
    "auth": {
      "options": [
        "auth:none",
        "auth:better-auth",
        "auth:clerk",
        "auth:supabase-auth"
      ],
      "default": "auth:none"
    },
    "payments": {
      "options": [
        "payments:none",
        "payments:stripe",
        "payments:coinbase-commerce"
      ],
      "default": "payments:none"
    },
    "sdk": {
      "options": [
        "sdk:none",
        "sdk:coinbase-cdp",
        "sdk:solana-web3",
        "sdk:evm-wallet"
      ],
      "default": "sdk:none"
    }
  },
  "files": [
    {
      "source": "files/package.json",
      "target": "package.json"
    },
    {
      "source": "files/validate-types.mjs",
      "target": "validate-types.mjs"
    },
    {
      "source": "files/src/components/ui/button.tsx",
      "target": "src/components/ui/button.tsx"
    },
    {
      "source": "files/src/components/ui/card.tsx",
      "target": "src/components/ui/card.tsx"
    },
    {
      "source": "files/src/components/ui/badge.tsx",
      "target": "src/components/ui/badge.tsx"
    }
  ],
  "validationChecks": [
    {
      "type": "file-exists",
      "path": "index.html"
    },
    {
      "type": "file-exists",
      "path": "src/main.ts"
    },
    {
      "type": "file-exists",
      "path": "src/App.tsx"
    },
    {
      "type": "command-success",
      "command": [
        "node",
        "validate-types.mjs"
      ],
      "expect": "typescript ok"
    }
  ],
  "contextHints": {
    "commands": [
      "npm run build",
      "npm run validate"
    ],
    "entrypoints": [
      "index.html",
      "src/main.ts",
      "src/App.tsx",
      "vite.config.ts"
    ],
    "preview": {
      "path": "/"
    },
    "extensionPoints": [
      "starter-data.json",
      "starter-brand.json",
      "auth-config.json",
      "payments-config.json",
      "sdk-config.json"
    ]
  },
  "keywords": [
    "react",
    "vite",
    "spa",
    "component",
    "single page",
    "client app"
  ],
  "tieredKeywords": {
    "tier1": [
      "react",
      "vite"
    ],
    "tier2": [
      "spa",
      "component",
      "single page",
      "client app"
    ],
    "archetypes": [
      "figma",
      "design tool",
      "collaborative editor",
      "whiteboard",
      "d3 dashboard",
      "d3.js",
      "data visualization",
      "chart app",
      "visualization tool",
      "interactive charts",
      "game",
      "game app",
      "multiplayer game",
      "browser game",
      "trivia app",
      "quiz game",
      "word game",
      "puzzle game",
      "miro",
      "mural",
      "collaborative whiteboard",
      "brainstorming tool",
      "calculator",
      "converter",
      "unit converter",
      "timer",
      "countdown",
      "stopwatch",
      "pomodoro",
      "weather app",
      "weather dashboard",
      "todo",
      "to-do",
      "task list",
      "checklist",
      "staking calculator",
      "rewards calculator",
      "yield calculator",
      "apy calculator",
      "portfolio tracker",
      "multichain",
      "multichain portfolio",
      "token tracker"
    ]
  },
  "buildHints": {
    "whenToUse": "React single-page app with Vite. Use for client-rich apps without a server surface \u2014 dashboards, tools, games, interactive demos.",
    "firstSteps": [
      "Install: `pnpm install` then `pnpm dev` (Vite dev server with HMR).",
      "Brand strings + copy: `src/personalize.json`. Palette: `src/personalize.css`. Both render-time templated; preview updates on next refresh.",
      "shadcn/ui components under `src/components/ui/`. Import via `@/components/ui/button`. Path alias `@/` \u2192 `src/` is configured.",
      "Build: `pnpm build` outputs to `dist/` \u2014 static assets ready for any CDN."
    ],
    "gotchas": [
      "No SSR \u2014 SEO content must live in `index.html` <head> or be injected post-hydration. Use `nextjs-ts` if SEO is a hard requirement.",
      "Vite dev server is separate from prod build. Some imports (e.g. CSS-in-JS) work in dev but need explicit config for prod."
    ],
    "placeholders": [
      {
        "path": "src/App.tsx",
        "description": "Minimal skeleton shell (header + empty main). Replace the main content with the product's primary view \u2014 shadcn components + path alias are ready."
      },
      {
        "path": "index.html",
        "description": "Root HTML with `<div id=\"app\">` and title templated from personalize. Title + meta tags live here; favicon and fonts too if the product needs them."
      },
      {
        "path": "src/personalize.json",
        "description": "Brand strings \u2014 edit for the product but also rewrite src/App.tsx main content."
      },
      {
        "path": "src/personalize.css",
        "description": "HSL design tokens on :root + .dark. Edit the palette to match the product; Tailwind v4 @theme defaults already compose in."
      }
    ]
  }
}
