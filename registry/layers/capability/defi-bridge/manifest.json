{
  "id": "defi-bridge",
  "description": "Adds cross-chain bridge and messaging patterns with lock/mint, burn/release, and proof verification.",
  "domainPack": {
    "domain": {
      "family": "bridge",
      "protocol": "custom",
      "runtime": "evm",
      "surface": "contracts"
    },
    "provides": ["bridge-patterns", "cross-chain-messaging", "lock-mint"],
    "requires": ["solidity-contracts"],
    "ambiguityGroup": "bridge-contracts",
    "authenticitySignals": ["cross-chain bridge", "lock and mint", "burn and release", "proof verification"]
  },
  "appliesTo": [
    "forge-contracts",
    "hardhat-contracts",
    "api-service",
    "evm-infra-ts"
  ],
  "defaults": {
    "bridgeModel": "lock-and-mint",
    "messagingProtocol": "custom"
  },
  "files": [
    {
      "source": "files/bridge-config.json",
      "target": "bridge-config.json"
    }
  ],
  "contextHints": {
    "extensionPoints": [
      "bridge-config.json"
    ]
  },
  "keywords": [
    "bridge protocol",
    "cross-chain bridge",
    "lock and mint",
    "burn and release",
    "cross-chain messaging",
    "wormhole",
    "axelar",
    "connext"
  ]
}
