  ],
  "provides": [
    "channel:whatsapp"
  ],
  "defaults": {
    "channelId": "whatsapp",
    "graphApiVersion": "v18.0",
    "graphApiBase": "https://graph.facebook.com",
    "signatureHeader": "x-hub-signature-256",
    "envVars": [
      "WHATSAPP_ACCESS_TOKEN",
      "WHATSAPP_PHONE_NUMBER_ID",
      "WHATSAPP_APP_SECRET",
      "WHATSAPP_VERIFY_TOKEN"
    ]
  },
  "files": [
