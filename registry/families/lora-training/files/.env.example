# Required for gated base models (Llama, Mistral, Gemma). Get one at
# https://huggingface.co/settings/tokens (read scope is enough). You must
# ALSO click "accept license" on the model's Hub page — token alone 403s.
HUGGING_FACE_HUB_TOKEN=

# Optional: W&B logging. Set report_to: 'wandb' in config/train.yaml to enable.
WANDB_API_KEY=
WANDB_PROJECT=lora-training
