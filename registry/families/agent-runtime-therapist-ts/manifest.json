{
  "id": "agent-runtime-therapist-ts",
  "description": "Voice-first peer-support agent bundle — explicitly NOT a therapist replacement. Listens, runs validated screeners (PHQ-9 / GAD-7), surfaces escalation paths to real clinicians for any moderate-or-above band or crisis-language detection. Demonstrates the agent-runtime substrate composing with phony-voice + clinical-screeners + structured-output-blocks layers on the Tangle floor.",
  "tags": [
    "agent-runtime",
    "peer-support",
    "voice-first",
    "clinical-screeners",
    "cloudflare-worker"
  ],
  "taxonomy": {
    "language": "markdown",
    "runtime": "cloudflare-worker",
    "surface": "agent-runtime"
  },
  "includes": [
    "agent-base:tangle",
    "agent-base:secure",
    "agent-tools:phony-voice",
    "agent-tools:clinical-screeners",
    "agent-output:blocks"
  ],
  "defaults": {
    "projectType": "agent-runtime-therapist",
    "agentName": "peer-support-companion",
    "publicVars": [
      "AGENT_NAME"
    ],
    "routes": [
      {
        "path": "/api/chat",
        "auth": "bearer",
        "callsTools": [
          "voice-stt",
          "voice-tts",
          "screener",
          "escalation"
        ]
      },
      {
        "path": "/api/health",
        "auth": "none",
        "callsTools": []
      }
    ],
    "declaredCapabilities": [
      "peer-support-listening",
      "phq9-screener",
      "gad7-screener",
      "crisis-escalation"
    ],
    "runtime": {
      "sandbox": "tangle",
      "noNewPrivileges": true,
      "capDrop": "ALL"
    },
    "crisisHotlines": [
      {
        "name": "988 Suicide & Crisis Lifeline",
        "number": "988",
        "type": "call-or-text"
      },
      {
        "name": "Crisis Text Line",
        "number": "741741",
        "type": "text",
        "keyword": "HOME"
      }
    ],
    "schedule": [
      {
        "id": "scheduled-1",
        "cron": "23 14 * * *",
        "capability": "peer-support-listening"
      }
    ],
    "outboundDomains": [
      "api.tangle.tools",
      "988lifeline.org"
    ],
    "secrets": [
      "TANGLE_ROUTER_KEY",
      "PHONY_API_KEY"
    ]
  },
  "files": [
    {
      "source": "files/agent.json",
      "target": "agent.json"
    },
    {
      "source": "files/system-prompt.md",
      "target": "system-prompt.md"
    },
    {
      "source": "files/methodology/index.json",
      "target": "methodology/index.json"
    },
    {
      "source": "files/methodology/listening-protocol.md",
      "target": "methodology/listening-protocol.md"
    },
    {
      "source": "files/README.md",
      "target": "README.md"
    },
    {
      "source": "files/TOOLS.md",
      "target": "TOOLS.md"
    }
  ],
  "validationChecks": [
    {
      "type": "file-exists",
      "path": "system-prompt.md"
    },
    {
      "type": "file-exists",
      "path": "methodology/index.json"
    },
    {
      "type": "agents-md-valid",
      "path": "system-prompt.md"
    },
    {
      "type": "methodology-index-valid",
      "path": "methodology/index.json"
    },
    {
      "type": "schedule-valid",
      "path": "manifest.json"
    },
    {
      "type": "file-exists",
      "path": "TOOLS.md"
    }
  ],
  "contextHints": {
    "commands": [],
    "entrypoints": [
      "system-prompt.md"
    ],
    "extensionPoints": [
      "templates/",
      "src/lib/tools/"
    ]
  },
  "keywords": [
    "therapy",
    "peer-support",
    "mental-health",
    "phq-9",
    "gad-7",
    "voice"
  ],
  "tieredKeywords": {
    "tier1": [
      "peer-support",
      "mental-health-bot"
    ],
    "tier2": [
      "therapy",
      "anxiety",
      "depression",
      "screener"
    ],
    "tier3": [
      "agent"
    ],
    "archetypes": [
      "agent-in-sandbox",
      "voice-first"
    ]
  }
}
