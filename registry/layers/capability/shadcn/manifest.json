{
  "id": "shadcn",
  "description": "Adds shadcn/ui component system with cn() utility, path aliases, and base UI components ready to use.",
  "appliesTo": [
    "react-vite-ts",
    "nextjs-ts",
    "fullstack-ts",
    "remix-ts",
    "electron-desktop-ts",
    "tauri-desktop"
  ],
  "files": [
    { "source": "files/shadcn-config.json", "target": "shadcn-config.json" },
    { "source": "files/utils.ts", "target": "src/lib/utils.ts" },
    { "source": "files/button.tsx", "target": "src/components/ui/button.tsx" },
    { "source": "files/card.tsx", "target": "src/components/ui/card.tsx" },
    { "source": "files/input.tsx", "target": "src/components/ui/input.tsx" },
    { "source": "files/label.tsx", "target": "src/components/ui/label.tsx" },
    { "source": "files/badge.tsx", "target": "src/components/ui/badge.tsx" },
    { "source": "files/separator.tsx", "target": "src/components/ui/separator.tsx" },
    { "source": "files/skeleton.tsx", "target": "src/components/ui/skeleton.tsx" }
  ],
  "contextHints": {
    "extensionPoints": [
      "shadcn-config.json",
      "src/lib/utils.ts",
      "src/components/ui/"
    ]
  },
  "keywords": [
    "shadcn",
    "shadcn/ui",
    "shadcn-ui",
    "radix ui",
    "radix primitives",
    "cn utility",
    "component library",
    "professional",
    "production-ready",
    "design system"
  ],
  "capabilityRequires": [
    "tailwind"
  ],
  "buildHints": {
    "architectureNotes": [
      "shadcn/ui components are pre-installed in src/components/ui/. Import directly: import { Button } from '@/components/ui/button'",
      "Add more components via: npx shadcn@latest add dialog sheet dropdown-menu",
      "The cn() utility in src/lib/utils.ts merges Tailwind classes. Use it in all custom components.",
      "Configure tsconfig.json paths: { '@/*': ['./src/*'] }"
    ]
  }
}
