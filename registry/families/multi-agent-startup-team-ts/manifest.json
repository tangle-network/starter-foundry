  ],
  "defaults": {
    "projectType": "multi-agent-startup-team",
    "agentName": "startup-team",
    "publicVars": [
      "AGENT_NAME"
    ],
    "routes": [
      {
        "path": "/api/chat",
        "auth": "bearer",
        "callsTools": []
      },
      {
        "path": "/api/health",
        "auth": "none",
