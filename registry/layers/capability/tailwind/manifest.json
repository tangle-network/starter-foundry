{
  "id": "tailwind",
  "description": "Adds Tailwind CSS v4 configuration with PostCSS, dark mode support, and design tokens.",
  "appliesTo": [
    "react-vite-ts",
    "nextjs-ts",
    "fullstack-ts",
    "sveltekit-ts",
    "remix-ts",
    "vue-ts",
    "angular-ts",
    "frontend-static",
    "browser-extension-ts",
    "electron-desktop-ts",
    "tauri-desktop"
  ],
  "files": [
    {
      "source": "files/tailwind-config.json",
      "target": "tailwind-config.json"
    },
    {
      "source": "files/design-tokens.json",
      "target": "design-tokens.json"
    }
  ],
  "contextHints": {
    "extensionPoints": [
      "tailwind-config.json",
      "design-tokens.json",
      "src/globals.css"
    ]
  },
  "keywords": [
    "tailwind",
    "tailwindcss",
    "utility css",
    "postcss",
    "professional",
    "production-ready",
    "polished",
    "styled",
    "dark mode",
    "responsive design"
  ],
  "buildHints": {
    "architectureNotes": [
      "Tailwind v4: define colors in @theme block in globals.css, no tailwind.config.ts needed",
      "Add CSS variables from design-tokens.json to @theme block in globals.css",
      "Use class-based dark mode with .dark class toggle"
    ]
  }
}
