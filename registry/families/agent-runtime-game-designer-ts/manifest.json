{
  "id": "agent-runtime-game-designer-ts",
  "description": "Game designer agent bundle — designs game mechanics, narrative systems, and player experience loops. Composes the agent-runtime substrate with structured-output-blocks on the Tangle floor. Advisory only — never replaces a professional game studio's creative director, producer, or QA team.",
  "tags": [
    "agent-runtime",
    "game-design",
    "creative-agent",
    "advisory",
    "cloudflare-worker"
  ],
  "taxonomy": {
    "language": "markdown",
    "runtime": "cloudflare-worker",
    "surface": "agent-runtime"
  },
  "includes": [
    "agent-base:tangle",
    "agent-base:secure",
    "agent-output:blocks"
  ],
  "defaults": {
    "projectType": "agent-runtime-game-designer",
    "agentName": "game-designer",
    "publicVars": [
      "AGENT_NAME"
    ],
    "routes": [
      {
        "path": "/api/chat",
        "auth": "bearer",
        "callsTools": [
          "mechanic-design",
          "narrative-system",
          "player-loop"
        ]
      },
      {
        "path": "/api/health",
        "auth": "none",
        "callsTools": []
      }
    ],
    "declaredCapabilities": [
      "mechanic-design",
      "narrative-system-design",
      "player-loop-design"
    ],
    "runtime": {
      "sandbox": "tangle",
      "noNewPrivileges": true,
      "capDrop": "ALL"
    },
    "stakes": "low",
    "advisoryOnly": true,
    "outboundDomains": [
      "api.tangle.tools"
    ],
    "secrets": [
      "TANGLE_ROUTER_KEY"
    ]
  },
  "files": [
    {
      "source": "files/agent.json",
      "target": "agent.json"
    },
    {
      "source": "files/AGENTS.md",
      "target": "AGENTS.md"
    },
    {
      "source": "files/methodology/index.json",
      "target": "methodology/index.json"
    },
    {
      "source": "files/methodology/mechanic-design.md",
      "target": "methodology/mechanic-design.md"
    },
    {
      "source": "files/methodology/narrative-system.md",
      "target": "methodology/narrative-system.md"
    },
    {
      "source": "files/methodology/player-loop.md",
      "target": "methodology/player-loop.md"
    },
    {
      "source": "files/README.md",
      "target": "README.md"
    },
    {
      "source": "files/TOOLS.md",
      "target": "TOOLS.md"
    }
  ],
  "contextHints": {
    "commands": [],
    "entrypoints": [
      "AGENTS.md"
    ],
    "extensionPoints": [
      "templates/",
      "src/lib/tools/"
    ]
  },
  "tieredKeywords": {
    "tier1": [
      "game-designer",
      "game designer",
      "game-designer-agent",
      "game designer agent",
      "creative-game-designer",
      "creative game designer",
      "game-mechanics-designer",
      "game mechanics designer"
    ],
    "tier2": [
      "mechanic-design",
      "mechanic design",
      "narrative-system",
      "narrative system",
      "player-loop",
      "player loop",
      "game-loop",
      "game loop",
      "core-loop",
      "core loop",
      "progression-system",
      "progression system"
    ],
    "tier3": [
      "game design",
      "game-design"
    ],
    "archetypes": [
      "agent-in-sandbox",
      "creative-agent"
    ]
  }
}
