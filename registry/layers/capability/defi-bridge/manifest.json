      "bridge-config.json"
    ]
  },
  "keywords": [
    "bridge protocol",
    "cross-chain bridge",
    "lock and mint",
    "burn and release",
    "cross-chain messaging",
    "wormhole",
    "axelar",
    "connext"
  ]
}
