# Required — single LLM egress through router.tangle.tools
TANGLE_ROUTER_KEY=sk-tan-replace-me

# Required — HMAC secret used to sign tenant session tokens (auth.ts).
# Rotate this on suspicion of compromise. 32+ random bytes.
AUTH_SECRET=replace-with-32-byte-random-hex

# Required if /api/webhooks/* is enabled. Per-webhook secret recommended in prod.
WEBHOOK_HMAC_SECRET=replace-with-32-byte-random-hex

# Where the worker reads agent packs from. Each subdirectory is one pack:
#   <AGENT_PACK_DIR>/<agent-id>/system-prompt.md
#   <AGENT_PACK_DIR>/<agent-id>/methodology/index.json
# In Cloudflare Workers, packs are baked into the bundle at build time —
# the runtime reads them via static imports / R2. Locally, this is a
# filesystem path used by the dev-time loader.
AGENT_PACK_DIR=./agents

# Public — exposed to the client via Vite. Document these in README.md.
VITE_AGENT_NAME={{agentName}}
