{
  "id": "agent-code-review",
  "description": "Adds code review pipeline with diff analysis, rule checking, and inline comment generation.",
  "appliesTo": [
    "agent-service-ts",
    "agent-service-py",
    "agent-service-rust"
  ],
  "defaults": {
    "reviewLanguages": "typescript,python",
    "reviewRules": "security,performance,style"
  },
  "files": [
    {
      "source": "files/review-config.json",
      "target": "review-config.json"
    },
    {
      "source": "files/review-pipeline.mjs",
      "target": "review-pipeline.mjs"
    }
  ],
  "contextHints": {
    "extensionPoints": [
      "review-config.json",
      "review-pipeline.mjs"
    ]
  },
  "keywords": [
    "code review agent",
    "code analysis agent",
    "pr reviewer agent",
    "code quality agent",
    "linting agent",
    "code audit agent"
  ]
}
