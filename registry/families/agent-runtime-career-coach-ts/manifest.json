      "market-positioning",
      "decision-framework"
    ],
    "runtime": {
      "sandbox": "tangle",
      "noNewPrivileges": true,
      "capDrop": "ALL"
    },
    "stakes": "moderate",
    "advisoryOnly": true,
    "outboundDomains": [
      "api.tangle.tools"
    ],
    "secrets": [
      "TANGLE_API_KEY"
    ]
  },
  "files": [
