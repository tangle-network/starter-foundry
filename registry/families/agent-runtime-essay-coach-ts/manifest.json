{
  "id": "agent-runtime-essay-coach-ts",
  "description": "Essay coach agent bundle \u2014 guides students through thesis development, argument structuring, and revision cycles. Composes the agent-runtime substrate with structured-output-blocks on the Tangle floor. Advisory only \u2014 never replaces a human teacher or grader.",
  "tags": [
    "agent-runtime",
    "essay-coach",
    "writing-tutor",
    "education",
    "cloudflare-worker"
  ],
  "taxonomy": {
    "language": "markdown",
    "runtime": "cloudflare-worker",
    "surface": "agent-runtime"
  },
  "includes": [
    "agent-base:tangle",
    "agent-base:secure",
    "agent-output:blocks",
    "agent-base:memory",
    "agent-base:scheduler",
    "agent-base:mcp-registry",
    "agent-channels:telegram",
    "agent-channels:discord",
    "agent-channels:slack",
    "agent-channels:whatsapp",
    "agent-channels:imessage",
    "agent-channels:gmail",
    "agent-channels:linear"
  ],
  "defaults": {
    "projectType": "agent-runtime-essay-coach",
    "agentName": "essay-coach",
    "publicVars": [
      "AGENT_NAME"
    ],
    "routes": [
      {
        "path": "/api/chat",
        "auth": "bearer",
        "callsTools": [
          "thesis-development",
          "argument-structuring",
          "revision-cycle"
        ]
      },
      {
        "path": "/api/health",
        "auth": "none",
        "callsTools": []
      }
    ],
    "declaredCapabilities": [
      "thesis-development",
      "argument-structuring",
      "revision-cycle"
    ],
    "runtime": {
      "sandbox": "tangle",
      "noNewPrivileges": true,
      "capDrop": "ALL"
    },
    "stakes": "low",
    "advisoryOnly": true,
    "outboundDomains": [
      "api.tangle.tools"
    ],
    "secrets": [
      "TANGLE_ROUTER_KEY"
    ]
  },
  "files": [
    {
      "source": "files/agent.json",
      "target": "agent.json"
    },
    {
      "source": "files/AGENTS.md",
      "target": "AGENTS.md"
    },
    {
      "source": "files/methodology/index.json",
      "target": "methodology/index.json"
    },
    {
      "source": "files/methodology/thesis-development.md",
      "target": "methodology/thesis-development.md"
    },
    {
      "source": "files/methodology/argument-structuring.md",
      "target": "methodology/argument-structuring.md"
    },
    {
      "source": "files/methodology/revision-cycle.md",
      "target": "methodology/revision-cycle.md"
    },
    {
      "source": "files/README.md",
      "target": "README.md"
    },
    {
      "source": "files/TOOLS.md",
      "target": "TOOLS.md"
    }
  ],
  "contextHints": {
    "commands": [],
    "entrypoints": [
      "AGENTS.md"
    ],
    "extensionPoints": [
      "templates/",
      "src/lib/tools/"
    ]
  },
  "tieredKeywords": {
    "tier1": [
      "essay-coach",
      "essay coach",
      "writing-tutor-agent",
      "writing tutor agent",
      "essay-tutor",
      "essay tutor",
      "academic-writing-coach",
      "academic writing coach"
    ],
