{
  "name": "two-role-team",
  "description": "Multi-agent fixture with one lead and one researcher subagent.",
  "version": "0.1.0",
  "prompt": {
    "systemPromptFile": "AGENTS.md"
  },
  "subagents": {
    "lead": {
      "description": "Routes work and reviews drafts",
      "systemPromptFile": "roles/lead/AGENTS.md",
      "model": "anthropic/claude-sonnet-4-7",
      "tools": { "bash": true },
      "permissions": { "bash": "ask" },
      "temperature": 0.2,
      "maxSteps": 5
    },
    "researcher": {
      "description": "Reads papers and writes summaries",
      "systemPromptFile": "roles/researcher/AGENTS.md",
      "tools": { "webfetch": true },
      "permissions": { "webfetch": "allow" }
    }
  },
  "resources": {
    "files": [{ "source": "roles" }]
  }
}
