{
  "id": "agent-trading",
  "description": "Adds trading strategy seams with market data, order execution, and risk management.",
  "appliesTo": [
    "agent-service-ts",
    "agent-service-py",
    "agent-service-rust"
  ],
  "defaults": {
    "exchangeMode": "paper",
    "tradingPairs": "BTC/USDT,ETH/USDT"
  },
  "files": [
    {
      "source": "files/trading-config.json",
      "target": "trading-config.json"
    },
    {
      "source": "files/strategy.ts",
      "target": "strategy.ts"
    }
  ],
  "contextHints": {
    "extensionPoints": [
      "trading-config.json",
      "strategy.ts"
    ]
  },
  "keywords": [
    "trading agent",
    "trading bot agent",
    "market analysis agent",
    "trading strategy agent",
    "exchange api agent",
    "order execution agent",
    "backtesting agent"
  ],
  "buildHints": {
    "apiRoutes": [
      "/api/strategy",
      "/api/positions",
      "/api/risk"
    ],
    "components": [
      "StrategyConfig",
      "PositionTable",
      "PnLChart",
      "RiskDashboard"
    ],
    "dataModels": [
      "Position",
      "Order",
      "Signal",
      "RiskLimit"
    ],
    "integrations": [
      "Exchange API (from exchange config)",
      "Market data WebSocket"
    ]
  }
}
