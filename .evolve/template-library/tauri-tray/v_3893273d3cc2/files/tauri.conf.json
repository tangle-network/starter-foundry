{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "{{projectName}}",
  "version": "0.1.0",
  "identifier": "com.starterfoundry.{{packageName}}",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
