    "tailwind-merge":              { "capability": "capability:shadcn", "confidence": 0.9 },
    "@radix-ui/react-slot":        { "capability": "capability:shadcn", "confidence": 0.95 },
    "@radix-ui/react-dialog":      { "capability": "capability:shadcn", "confidence": 0.9 },
    "@radix-ui/react-dropdown-menu": { "capability": "capability:shadcn", "confidence": 0.9 },

    "tailwindcss":                 { "capability": "capability:tailwind", "confidence": 0.98 },
    "@tailwindcss/vite":           { "capability": "capability:tailwind", "confidence": 0.98 },
    "@tailwindcss/postcss":        { "capability": "capability:tailwind", "confidence": 0.98 },
    "postcss":                     { "capability": "capability:tailwind", "confidence": 0.4 },

    "recharts":                    { "capability": "capability:chart-widget", "confidence": 0.95 },
