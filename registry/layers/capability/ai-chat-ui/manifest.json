{
  "id": "ai-chat-ui",
  "description": "Adds streaming AI chat interface with message history and markdown rendering.",
  "appliesTo": [
    "react-vite-ts",
    "nextjs-ts",
    "fullstack-ts"
  ],
  "defaults": {
    "chatModel": "gpt-4o"
  },
  "files": [
    {
      "source": "files/chat-config.json",
      "target": "chat-config.json"
    },
    {
      "source": "files/chat-data.json",
      "target": "chat-data.json"
    }
  ],
  "contextHints": {
    "extensionPoints": [
      "chat-config.json",
      "chat-data.json"
    ]
  },
  "capabilityRequires": [
    "layout-chat"
  ],
  "keywords": [
    "chat interface",
    "chat ui",
    "streaming chat",
    "chatbot ui",
    "ai chat",
    "conversation ui",
    "chat app",
    "chatgpt clone"
  ],
  "buildHints": {
    "pages": [
      "/chat",
      "/chat/[id]"
    ],
    "apiRoutes": [
      "/api/chat",
      "/api/chat/history"
    ],
    "components": [
      "ChatMessage",
      "ChatInput",
      "MessageList",
      "StreamingIndicator",
      "CodeBlock"
    ],
    "dataModels": [
      "Message",
      "Conversation",
      "ToolCallResult"
    ],
    "integrations": [
      "Server-Sent Events for streaming",
      "Markdown rendering"
    ]
  },
  "packageDeps": {
    "dependencies": {
      "ai": "^4.0.0",
      "@ai-sdk/react": "^1.0.0"
    }
  },
