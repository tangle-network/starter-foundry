{
  "id": "agent-runtime-wealth-manager-ts",
  "description": "Personal wealth-manager agent bundle \u2014 peer-style information on asset allocation, tax-loss harvesting, and retirement projection. Explicitly NOT a registered investment adviser, NOT a fiduciary, NOT licensed financial advice. Demonstrates the agent-runtime substrate composing on a regulated-finance role with structured-output blocks (:::artifact, :::escalation) and a hard refusal contract for actionable trade picks.",
  "tags": [
    "agent-runtime",
    "personal-finance",
    "wealth-management",
    "regulated-finance",
    "cloudflare-worker"
  ],
  "taxonomy": {
    "language": "markdown",
    "runtime": "cloudflare-worker",
    "surface": "agent-runtime"
  },
  "includes": [
    "agent-base:tangle",
    "agent-base:secure",
    "agent-base:privacy",
    "agent-output:blocks",
    "agent-base:memory",
    "agent-base:scheduler",
    "agent-base:mcp-registry",
    "agent-channels:telegram",
    "agent-channels:discord",
    "agent-channels:slack",
    "agent-channels:whatsapp",
    "agent-channels:imessage",
    "agent-channels:gmail",
    "agent-channels:linear"
  ],
  "defaults": {
    "projectType": "agent-runtime-wealth-manager",
    "agentName": "wealth-manager",
    "publicVars": [
      "AGENT_NAME"
    ],
    "routes": [
      {
        "path": "/api/chat",
        "auth": "bearer",
        "callsTools": [
          "allocation-review",
          "tax-lot-scan",
          "projection"
        ]
      },
      {
        "path": "/api/health",
        "auth": "none",
        "callsTools": []
      }
    ],
    "declaredCapabilities": [
      "asset-allocation-review",
      "tax-loss-harvesting",
      "retirement-projection",
      "regulatory-disclaimer"
    ],
    "runtime": {
      "sandbox": "tangle",
      "noNewPrivileges": true,
      "capDrop": "ALL"
    },
    "disclaimerRequired": true,
    "notFiduciary": true,
    "regulatoryDisclaimer": true,
    "schedule": [
      {
        "id": "scheduled-1",
        "cron": "0 14 1 * *",
        "capability": "asset-allocation-review"
      }
    ],
    "outboundDomains": [
      "api.tangle.tools",
      "sec.gov",
      "irs.gov"
    ],
    "secrets": [
      "TANGLE_API_KEY"
    ]
  },
  "files": [
    {
      "source": "files/agent.json",
      "target": "agent.json"
    },
    {
      "source": "files/AGENTS.md",
      "target": "AGENTS.md"
    },
    {
      "source": "files/methodology/index.json",
      "target": "methodology/index.json"
    },
    {
      "source": "files/methodology/allocation-review.md",
      "target": "methodology/allocation-review.md"
    },
    {
      "source": "files/methodology/tax-loss-harvest-protocol.md",
      "target": "methodology/tax-loss-harvest-protocol.md"
    },
    {
      "source": "files/methodology/retirement-projection.md",
      "target": "methodology/retirement-projection.md"
    },
    {
      "source": "files/README.md",
      "target": "README.md"
    },
    {
      "source": "files/TOOLS.md",
      "target": "TOOLS.md"
    }
  ],
  "validationChecks": [
    {
      "type": "file-exists",
      "path": "AGENTS.md"
    },
    {
      "type": "file-exists",
      "path": "methodology/index.json"
    },
    {
      "type": "agents-md-valid",
      "path": "AGENTS.md"
    },
    {
      "type": "methodology-index-valid",
      "path": "methodology/index.json"
    },
    {
      "type": "schedule-valid",
      "path": "manifest.json"
    },
    {
      "type": "file-exists",
      "path": "TOOLS.md"
    }
  ],
  "contextHints": {
    "commands": [],
    "entrypoints": [
      "AGENTS.md"
    ],
    "extensionPoints": [
      "templates/",
      "src/lib/tools/"
    ]
  },
  "keywords": [
    "wealth",
    "investing",
    "asset-allocation",
    "tax-loss-harvesting",
    "retirement",
    "rebalancing"
  ],
  "tieredKeywords": {
    "tier1": [
      "wealth-manager",
      "wealth manager",
      "financial-planner-agent",
      "financial planner",
      "personal-cfo",
      "personal cfo",
      "personal wealth"
    ],
    "tier2": [
      "asset-allocation",
      "asset allocation",
      "tax-loss-harvesting",
      "tax loss harvesting",
      "retirement-planning",
      "retirement planning",
      "estate",
      "529"
    ],
    "tier3": [
      "investing",
      "portfolio",
      "rebalancing",
      "ira"
    ],
    "archetypes": [
      "agent-in-sandbox",
      "advisory-agent",
      "regulated-finance"
    ]
  }
}
