{
  "name": "designer",
  "description": "Product design agent bundle — UX strategy, design critique, and prototyping guidance. Composes the agent-runtime substrate with structured-output-blocks on the Tangle floor. Advisory only — never replaces the operator's design team or user research.",
  "version": "0.1.0",
  "tags": [
    "agent-runtime",
    "product-design",
    "ux-design",
    "design-critique",
    "advisory-agent",
    "cloudflare-worker"
  ],
  "prompt": {
    "systemPromptFile": "system-prompt.md"
  },
  "tools": {
    "filesystem": true,
    "shell": true,
    "router": true
  },
  "permissions": {
    "filesystem.write": "ask",
    "shell.exec": "ask",
    "network": "ask"
  },
  "resources": {
    "files": [
      {
        "source": "methodology/",
        "target": "/workspace/methodology/"
      },
      {
        "source": "README.md",
        "target": "/workspace/README.md"
      },
      {
        "source": "TOOLS.md",
        "target": "/workspace/TOOLS.md"
      }
    ]
  }
}
