{
  "id": "agent-eval-harness-py",
  "description": "Python eval harness for agent-under-test scoring. Loads scenarios, runs them against an agent (URL or local fn) inside an isolated tangle-sandbox, scores with multi-dim LLM judges via router.tangle.tools, emits a scorecard.json that matches the TS sibling 1:1 (cross-language compare works), and gates regression with bootstrap CI + Cohen's d + Welch's t-test (scipy). Operator entrypoint: `python -m eval run`.",
  "tags": [
    "agent-eval",
    "python",
    "eval-harness",
    "llm-judge",
    "tangle-sandbox",
    "regression-gate"
  ],
  "taxonomy": {
    "language": "python",
    "runtime": "python",
    "surface": "eval-runner"
  },
  "defaults": {
    "projectType": "agent-eval-harness-py",
    "entrypoint": "python -m eval",
    "routerBaseUrl": "https://router.tangle.tools/v1",
    "judgeModel": "anthropic/claude-sonnet-4.5",
    "bootstrapResamples": 1000,
    "bootstrapAlpha": 0.05,
    "secrets": [
      "TANGLE_ROUTER_KEY",
      "TANGLE_SANDBOX_API_KEY"
    ]
  },
