{
  "id": "supabase-auth",
  "slot": "auth",
  "description": "Supabase Auth with email, social login, and row-level security.",
  "appliesTo": [
    "agent-service-py",
    "agent-service-rust",
    "agent-service-ts",
    "angular-ts",
    "api-service",
    "browser-extension-ts",
    "bun-http",
    "cloudflare-worker-ts",
    "dspy-pipeline-py",
    "electron-desktop-ts",
    "evm-infra-ts",
    "expo-react-native-ts",
    "fullstack-ts",
    "go-api",
    "mcp-server-ts",
    "nextjs-ts",
    "python-api",
    "react-vite-ts",
    "remix-ts",
    "rust-service",
    "sveltekit-ts",
    "tauri-desktop",
    "vue-ts",
    "x402-service",
    "zk-prover-service"
  ],
  "defaults": {
    "authProvider": "supabase-auth"
  },
  "files": [
    {
      "source": "files/auth-config.json",
      "target": "auth-config.json"
    }
  ],
  "buildHints": {
    "pages": [
      "/login",
      "/signup",
      "/auth/callback"
    ],
    "apiRoutes": [
      "/auth/callback"
    ],
    "components": [
      "LoginForm",
      "SignupForm",
      "AuthProvider"
    ],
    "integrations": [
      "Supabase Auth",
      "Supabase RLS policies"
    ],
    "architectureNotes": [
      "Create lib/supabase/server.ts with createServerClient() using cookies.",
      "Create lib/supabase/client.ts with createBrowserClient().",
      "Add middleware.ts that calls supabase.auth.getUser() to refresh session.",
      "Auth callback route handles OAuth redirects from Supabase.",
      "All database queries go through the authenticated Supabase client \u2014 RLS enforces permissions."
    ]
  },
  "keywords": []
}
