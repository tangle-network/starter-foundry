    "@ai-sdk/openai":              { "capability": "capability:ai-agent-dashboard", "confidence": 0.6 },

    "@openzeppelin/contracts":     { "capability": "capability:evm-deploy-foundry", "confidence": 0.85 },
    "viem":                        { "capability": null, "confidence": 0, "note": "generic EVM RPC client — used for contracts, events, signing, wallet UIs, everything. Signal alone is not enough to pick a capability." },
