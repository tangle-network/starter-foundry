# Workspace-level env (Gen-16). Copy to `.env` and fill in.
#
# TANGLE_ROUTER_KEY — required for the rubric-quality LLM judge to call
#   router.tangle.tools (/v1/chat/completions). When absent, the judge
#   returns a structured `unmeasured` rather than fake-success.
#
# EVAL_TARGET_URL — the agent endpoint the eval harness targets. Default
#   wires to http://localhost:3001 (the agent dev server). Override for
#   running against a deployed sandbox.

TANGLE_ROUTER_KEY=
EVAL_TARGET_URL=http://localhost:3001
