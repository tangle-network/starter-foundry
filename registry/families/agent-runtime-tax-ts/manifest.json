{
  "id": "agent-runtime-tax-ts",
  "description": "Tax-prep agent bundle — drafts filings, tracks deadlines, never substitutes for a CPA. Demonstrates the agent-runtime substrate composing on a regulated-domain role with structured-output blocks (:::filing, :::deadline, :::question) and a strict refusal contract.",
  "tags": [
    "agent-runtime",
    "tax",
    "fintech",
    "regulated-domain",
    "cloudflare-worker"
  ],
  "taxonomy": {
    "language": "markdown",
    "runtime": "cloudflare-worker",
    "surface": "agent-runtime"
  },
  "includes": [
    "agent-base:tangle",
    "agent-base:secure",
    "agent-base:privacy",
    "agent-output:blocks"
  ],
  "defaults": {
    "projectType": "agent-runtime-tax",
    "agentName": "tax-prep-companion",
    "publicVars": [
      "AGENT_NAME"
    ],
    "routes": [
      {
        "path": "/api/chat",
        "auth": "bearer",
        "callsTools": [
          "form-fill",
          "deadline-lookup"
        ]
      },
      {
        "path": "/api/health",
        "auth": "none",
        "callsTools": []
      }
    ],
    "declaredCapabilities": [
      "filing-drafting",
      "deadline-tracking",
      "form-mapping",
      "compliance-disclaimer"
    ],
    "runtime": {
      "sandbox": "tangle",
      "noNewPrivileges": true,
      "capDrop": "ALL"
    },
    "circular230Notice": true,
    "schedule": [
      {
        "id": "scheduled-1",
        "cron": "0 9 1,15 * *",
        "capability": "filing-drafting"
      },
      {
        "id": "scheduled-2",
        "cron": "0 9 * * 1",
        "capability": "deadline-tracking"
      }
    ],
    "outboundDomains": [
      "api.tangle.tools",
      "irs.gov"
    ],
    "secrets": [
      "TANGLE_ROUTER_KEY"
    ]
  },
  "files": [
    {
      "source": "files/agent.json",
      "target": "agent.json"
    },
    {
      "source": "files/system-prompt.md",
      "target": "system-prompt.md"
    },
    {
      "source": "files/methodology/index.json",
      "target": "methodology/index.json"
    },
    {
      "source": "files/methodology/filing-1040.md",
      "target": "methodology/filing-1040.md"
    },
    {
      "source": "files/methodology/deadlines.md",
      "target": "methodology/deadlines.md"
    },
    {
      "source": "files/methodology/refusal-protocol.md",
      "target": "methodology/refusal-protocol.md"
    },
    {
      "source": "files/README.md",
      "target": "README.md"
    },
    {
      "source": "files/TOOLS.md",
      "target": "TOOLS.md"
    }
  ],
  "validationChecks": [
    {
      "type": "file-exists",
      "path": "system-prompt.md"
    },
    {
      "type": "file-exists",
      "path": "methodology/index.json"
    },
    {
      "type": "agents-md-valid",
      "path": "system-prompt.md"
    },
    {
      "type": "methodology-index-valid",
      "path": "methodology/index.json"
    },
    {
      "type": "schedule-valid",
      "path": "manifest.json"
    },
    {
      "type": "file-exists",
      "path": "TOOLS.md"
    }
  ],
  "contextHints": {
    "commands": [],
    "entrypoints": [
      "system-prompt.md"
    ],
    "extensionPoints": [
      "templates/",
      "src/lib/tools/"
    ]
  },
  "keywords": [
    "tax",
    "irs",
    "1040",
    "filing",
    "deadline",
    "cpa"
  ],
  "tieredKeywords": {
    "tier1": [
      "tax-prep",
      "tax-filer",
      "irs-filing"
    ],
    "tier2": [
      "1040",
      "tax-deadline",
      "schedule-c",
      "k-1",
      "estimated-tax"
    ],
    "tier3": [
      "filing",
      "deadline"
    ],
    "archetypes": [
      "agent-in-sandbox",
      "regulated-domain-agent"
    ]
  }
}
