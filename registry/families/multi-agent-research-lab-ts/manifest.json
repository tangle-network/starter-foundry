    },
    {
      "source": "files/roles/biology-researcher/system-prompt.md",
      "target": "roles/biology-researcher/system-prompt.md"
    },
    {
      "source": "files/roles/biology-researcher/methodology/protein-structure-analysis.md",
      "target": "roles/biology-researcher/methodology/protein-structure-analysis.md"
    },
    {
      "source": "files/roles/biology-researcher/methodology/bioinformatics-survey.md",
      "target": "roles/biology-researcher/methodology/bioinformatics-survey.md"
    }
  ],
  "validationChecks": [
