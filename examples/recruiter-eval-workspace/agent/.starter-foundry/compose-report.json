    "src/lib/mcp/README.md": "agent-base:mcp-registry",
    "channels/telegram.ts": "agent-channels:telegram",
    "channels/telegram.env.example": "agent-channels:telegram",
    "channels/discord.ts": "agent-channels:discord",
    "channels/discord.env.example": "agent-channels:discord",
    "channels/slack.ts": "agent-channels:slack",
    "channels/slack.env.example": "agent-channels:slack",
    "channels/whatsapp.ts": "agent-channels:whatsapp",
    "channels/whatsapp.env.example": "agent-channels:whatsapp",
    "channels/imessage.ts": "agent-channels:imessage",
    "channels/imessage.env.example": "agent-channels:imessage",
    "channels/gmail.ts": "agent-channels:gmail",
    "channels/gmail.env.example": "agent-channels:gmail",
    "channels/linear.ts": "agent-channels:linear",
    "channels/linear.env.example": "agent-channels:linear"
  },
