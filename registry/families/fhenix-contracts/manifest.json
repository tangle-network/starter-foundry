{
  "id": "fhenix-contracts",
  "description": "Fhenix FHE-enabled Solidity starter for encrypted on-chain computation.",
  "tags": ["fhenix", "fhe", "solidity", "privacy", "contracts"],
  "taxonomy": { "language": "solidity", "runtime": "fhenix", "surface": "contracts" },
  "slots": {},
  "defaults": {
    "projectType": "contracts",
    "encryptionScheme": "TFHE",
    "fhenixNetwork": "helium"
  },
  "files": [
    { "source": "files/package.json", "target": "package.json" }
  ],
  "validationChecks": [
    { "type": "file-exists", "path": "contracts/FHECounter.sol" },
    { "type": "file-exists", "path": "hardhat.config.ts" }
  ],
  "contextHints": {
    "commands": ["npx hardhat compile", "npx hardhat test"],
    "entrypoints": ["contracts/FHECounter.sol", "hardhat.config.ts", "test/FHECounter.test.ts"],
    "extensionPoints": ["contracts/", "test/", "deploy/"]
  },
  "keywords": ["fhenix", "fhe", "fully homomorphic", "encrypted computation", "euint", "fhevm", "inco"],
  "tieredKeywords": {
    "tier1": ["fhenix", "fhe", "fully homomorphic", "fhevm", "inco"],
    "tier2": ["encrypted computation", "encrypted auction", "encrypted balance", "private stablecoin", "euint", "TFHE"],
    "tier3": []
  }
}
