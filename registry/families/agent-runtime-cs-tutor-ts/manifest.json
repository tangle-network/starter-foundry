{
  "id": "agent-runtime-cs-tutor-ts",
  "description": "CS tutoring agent bundle \u2014 teaches programming fundamentals, data structures, algorithms, and debugging. Composes the agent-runtime substrate with the blocks output layer on the Tangle floor. Advisory only \u2014 never replaces a human instructor or academic advisor.",
  "tags": [
    "agent-runtime",
    "cs-tutor",
    "programming-tutor",
    "education",
    "cloudflare-worker"
  ],
  "taxonomy": {
    "language": "markdown",
    "runtime": "cloudflare-worker",
    "surface": "agent-runtime"
  },
  "includes": [
    "agent-base:tangle",
    "agent-base:secure",
    "agent-output:blocks",
    "agent-base:memory",
    "agent-base:scheduler",
    "agent-base:mcp-registry",
    "agent-channels:telegram",
    "agent-channels:discord",
    "agent-channels:slack",
    "agent-channels:whatsapp",
    "agent-channels:imessage",
    "agent-channels:gmail",
    "agent-channels:linear"
  ],
  "defaults": {
    "projectType": "agent-runtime-cs-tutor",
    "agentName": "cs-tutor",
    "publicVars": [
      "AGENT_NAME"
    ],
    "routes": [
      {
        "path": "/api/chat",
        "auth": "bearer",
        "callsTools": [
          "explain-concept",
          "debug-code",
          "generate-exercise"
        ]
      },
      {
        "path": "/api/health",
        "auth": "none",
        "callsTools": []
      }
    ],
    "declaredCapabilities": [
      "explain-concept",
      "debug-code",
      "generate-exercise"
    ],
    "runtime": {
      "sandbox": "tangle",
      "noNewPrivileges": true,
      "capDrop": "ALL"
    },
    "stakes": "low",
    "advisoryOnly": true,
    "outboundDomains": [
      "api.tangle.tools"
    ],
    "secrets": [
      "TANGLE_ROUTER_KEY"
    ]
  },
  "files": [
    {
      "source": "files/agent.json",
      "target": "agent.json"
    },
    {
      "source": "files/AGENTS.md",
      "target": "AGENTS.md"
    },
    {
      "source": "files/methodology/index.json",
      "target": "methodology/index.json"
    },
    {
      "source": "files/methodology/explain-concept.md",
      "target": "methodology/explain-concept.md"
    },
    {
      "source": "files/methodology/debug-code.md",
      "target": "methodology/debug-code.md"
    },
    {
      "source": "files/methodology/generate-exercise.md",
      "target": "methodology/generate-exercise.md"
    },
    {
      "source": "files/README.md",
      "target": "README.md"
    },
    {
      "source": "files/TOOLS.md",
      "target": "TOOLS.md"
    }
  ],
  "contextHints": {
    "commands": [],
    "entrypoints": [
      "AGENTS.md"
    ],
    "extensionPoints": [
      "templates/",
      "src/lib/tools/"
    ]
  },
  "tieredKeywords": {
    "tier1": [
      "cs-tutor",
      "cs tutor",
      "programming-tutor",
      "programming tutor",
      "coding-tutor",
      "coding tutor",
      "computer-science-tutor",
      "computer science tutor"
    ],
    "tier2": [
      "algorithms",
      "data-structures",
      "data structures",
      "debugging",
      "big-o",
      "big O",
      "time-complexity",
      "time complexity",
      "space-complexity",
      "space complexity"
    ],
    "tier3": [],
    "archetypes": [
      "agent-in-sandbox",
      "tutor-agent"
    ]
  }
}
