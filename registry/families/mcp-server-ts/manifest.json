{
  "id": "mcp-server-ts",
  "description": "Minimal TypeScript-flavored MCP server starter.",
  "tags": ["mcp", "server", "typescript", "ai"],
  "taxonomy": {
    "language": "javascript",
    "runtime": "node",
    "surface": "mcp-server"
  },
  "slots": {
    "database": {
      "options": [
        "database:sqlite",
        "database:postgres",
        "database:mongodb",
        "database:convex"
      ],
      "default": "database:sqlite"
    },
    "sdk": {
      "options": [
        "sdk:none",
        "sdk:coinbase-cdp",
        "sdk:solana-web3"
      ],
      "default": "sdk:none"
    },
    "auth": {
      "options": [
        "auth:none",
        "auth:better-auth",
        "auth:clerk",
        "auth:supabase-auth"
      ],
      "default": "auth:none"
    },
    "payments": {
      "options": [
        "payments:none",
        "payments:stripe",
        "payments:coinbase-commerce"
      ],
      "default": "payments:none"
    },
    "queue": {
      "options": [
        "queue:none",
        "queue:bullmq",
        "queue:trigger-dev"
      ],
      "default": "queue:none"
    }
  },
  "files": [
    {
      "source": "files/package.json",
      "target": "package.json"
    }
  ],
  "defaults": {
    "serverName": "starter-foundry-mcp"
  },
  "validationChecks": [
    {
      "type": "file-exists",
      "path": "server.mjs"
    },
    {
      "type": "node-syntax",
      "path": "server.mjs"
    },
    {
      "type": "command-success",
      "command": ["node", "server.mjs"],
      "env": {
        "RUN_ONCE": "1"
      },
      "expect": "mcp server ok"
    }
  ],
  "contextHints": {
    "commands": ["node server.mjs"],
    "entrypoints": ["server.mjs", "mcp.config.json"],
    "preview": null,
    "extensionPoints": ["mcp.config.json", "tools"]
  }
}
