{
  "id": "agent-runtime-cmo-advisor-ts",
  "description": "CMO-level marketing strategy advisor bundle. Works alongside an operator on positioning, ICP, and channel-experiment design — not a replacement for hands-on board-level diligence. Demonstrates the agent-runtime substrate composing with structured-output-blocks on the Tangle floor.",
  "tags": [
    "agent-runtime",
    "marketing-strategy",
    "advisory-agent",
    "cmo",
    "cloudflare-worker"
  ],
  "taxonomy": {
    "language": "markdown",
    "runtime": "cloudflare-worker",
    "surface": "agent-runtime"
  },
  "includes": [
    "agent-base:tangle",
    "agent-output:blocks"
  ],
  "defaults": {
    "projectType": "agent-runtime-cmo-advisor",
    "agentName": "cmo-advisor",
    "allowedDomains": ["api.tangle.tools"],
    "allowedEnv": ["TANGLE_ROUTER_KEY"],
    "publicVars": ["AGENT_NAME"],
    "routes": [
      { "path": "/api/chat", "auth": "bearer", "callsTools": ["positioning", "channel-experiment", "icp-research"] },
      { "path": "/api/health", "auth": "none", "callsTools": [] }
    ],
    "declaredCapabilities": ["positioning-strategy", "channel-experiment-design", "icp-research"],
    "runtime": {
      "sandbox": "tangle",
      "noNewPrivileges": true,
      "capDrop": "ALL"
    }
  },
  "files": [
    { "source": "files/system-prompt.md", "target": "system-prompt.md" },
    { "source": "files/templates/index.json", "target": "templates/index.json" },
    { "source": "files/templates/positioning-canvas.md", "target": "templates/positioning-canvas.md" },
    { "source": "files/templates/channel-experiment-design.md", "target": "templates/channel-experiment-design.md" },
    { "source": "files/templates/icp-deep-dive.md", "target": "templates/icp-deep-dive.md" },
    { "source": "files/wrangler.toml", "target": "wrangler.toml" },
    { "source": "files/README.md", "target": "README.md" }
  ],
  "validationChecks": [
    { "type": "file-exists", "path": "system-prompt.md" },
    { "type": "file-exists", "path": "templates/index.json" },
    { "type": "file-exists", "path": "wrangler.toml" },
    { "type": "prompt-frontmatter-valid", "path": "system-prompt.md" },
    { "type": "template-index-valid", "path": "templates/index.json" },
    { "type": "cron-syntax-valid", "path": "wrangler.toml" }
  ],
  "contextHints": {
    "commands": [],
    "entrypoints": ["system-prompt.md"],
    "extensionPoints": ["templates/", "src/lib/tools/"]
  },
  "keywords": [
    "cmo",
    "marketing-strategy",
    "positioning",
    "go-to-market",
    "icp",
    "channel-mix"
  ],
  "tieredKeywords": {
    "tier1": ["cmo-advisor", "cmo advisor", "marketing-strategy-agent", "marketing strategy agent", "growth-strategist", "growth strategist", "marketing strategy"],
    "tier2": ["positioning", "go-to-market", "go to market", "ICP", "channel-mix", "channel mix", "lifecycle-marketing", "lifecycle marketing"],
    "tier3": ["cmo", "marketing"],
    "archetypes": ["agent-in-sandbox", "advisory-agent"]
  }
}
