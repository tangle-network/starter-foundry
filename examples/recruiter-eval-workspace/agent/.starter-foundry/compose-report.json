{
  "spec": {
    "projectName": "recruiter-eval-workspace-agent",
    "family": "agent-runtime-recruiter-ts",
    "layers": [],
    "partner": null,
    "slots": {},
    "variables": {}
  },
  "components": {
    "family": "agent-runtime-recruiter-ts",
    "layers": [
      "agent-base:tangle",
      "agent-base:secure",
      "agent-base:privacy",
      "agent-output:blocks",
      "agent-base:memory",
      "agent-base:scheduler",
      "agent-base:mcp-registry",
      "agent-channels:telegram",
      "agent-channels:discord",
      "agent-channels:slack",
      "agent-channels:whatsapp",
      "agent-channels:imessage",
      "agent-channels:gmail",
      "agent-channels:linear"
    ],
    "partner": null,
    "slots": {}
  },
  "variables": {
    "projectName": "recruiter-eval-workspace-agent",
    "packageName": "recruiter-eval-workspace-agent",
    "crateName": "recruiter_eval_workspace_agent",
    "projectType": "agent-runtime-recruiter",
    "agentName": "technical-recruiter",
    "publicVars": ["AGENT_NAME"],
    "routes": [
      {
        "path": "/api/chat",
        "auth": "bearer",
        "callsTools": ["jd-drafter", "rubric-builder", "loop-composer"]
      },
      {
        "path": "/api/health",
        "auth": "none",
        "callsTools": []
      }
    ],
    "declaredCapabilities": ["jd-drafting", "screening-rubric-design", "interview-loop-design"],
    "runtime": {
      "sandbox": "tangle",
      "noNewPrivileges": true,
      "capDrop": "ALL"
    },
    "biasSafeguards": {
      "protectedClassRefusal": true,
      "compensationPolicy": "published-bands-only",
      "inclusiveLanguageAudit": true,
      "structuredInterviewDefault": true
    },
    "schedule": [
      {
        "id": "scheduled-1",
        "cron": "0 13 * * 1",
        "capability": "jd-drafting"
      }
    ],
    "outboundDomains": ["api.tangle.tools"],
    "secrets": ["TANGLE_API_KEY"],
    "tangleBase": true,
    "llmRouterUrl": "https://router.tangle.tools",
    "sandboxProvider": "tangle",
    "tcloudAvailable": true,
    "tangleSandboxSdk": "@tangle-network/sandbox-sdk",
    "tcloudSdk": "@tangle-network/tcloud",
    "secureLayer": true,
    "secretsBackend": "dotenvx",
    "workspaceRoot": "/workspace",
    "auditDir": ".audit",
    "identityAlgorithm": "Ed25519",
    "identityTtlSec": 3600,
    "webhookSignatureHeader": "X-Tangle-Signature",
    "webhookReplayWindowSec": 300,
    "webhookOutMaxRetries": 3,
    "webhookOutCircuitBreakerThreshold": 5,
    "webhookOutCircuitBreakerCooldownSec": 60,
    "privacyLayer": true,
    "structuredDetectors": ["ssn", "email", "phone", "credit-card", "ip", "api-key", "dob"],
    "semanticBackend": "none-by-default-opt-in-via-bundle",
    "structuredOutputBlocks": true,
    "blockTypes": ["proposal", "filing", "artifact", "screener-result", "escalation", "survey"],
    "memoryEnabled": true,
    "conversationsDir": "/home/agent/conversations",
    "schedulerEnabled": true,
    "schedulerStatePath": "/home/agent/scheduler/state.json",
    "schedulerSweepIntervalMs": 60000,
    "mcpRegistryPath": "/home/agent/.mcp.json",
    "mcpServers": ["filesystem", "fetch", "github", "memory", "scheduler"],
    "channelTelegramAvailable": true,
    "channelDiscordAvailable": true,
    "channelSlackAvailable": true,
    "channelId": "imessage",
    "graphApiVersion": "v18.0",
    "graphApiBase": "https://graph.facebook.com",
    "signatureHeader": "x-hub-signature-256",
    "envVars": ["BLUEBUBBLES_SERVER_URL", "BLUEBUBBLES_PASSWORD"],
    "transport": "bluebubbles-http",
    "channelGmailAvailable": true,
    "channelLinearAvailable": true
  },
  "fileOwnership": {
    "agent.json": "agent-runtime-recruiter-ts",
    "AGENTS.md": "agent-runtime-recruiter-ts",
    "methodology/index.json": "agent-runtime-recruiter-ts",
