{
  "heartbeatMs": "{{wsHeartbeatMs}}",
  "maxConnections": "{{wsMaxConnections}}",
  "rooms": true,
  "presence": true,
  "channels": ["default"],
  "events": {
    "join": "room:join",
    "leave": "room:leave",
    "message": "room:message",
    "presence": "room:presence"
  },
  "reconnect": {
    "enabled": true,
    "maxRetries": 5,
    "backoffMs": 1000,
    "maxBackoffMs": 30000
  }
}
