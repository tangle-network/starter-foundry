{
  "id": "rust-service",
  "description": "Minimal Rust HTTP service starter.",
  "tags": [
    "rust",
    "backend"
  ],
  "taxonomy": {
    "language": "rust",
    "runtime": "rust",
    "surface": "service"
  },
  "slots": {
    "database": {
      "options": [
        "database:sqlite",
        "database:postgres",
        "database:mongodb",
        "database:convex"
      ],
      "default": "database:sqlite"
    },
    "sdk": {
      "options": [
        "sdk:none",
        "sdk:coinbase-cdp",
        "sdk:solana-web3",
        "sdk:evm-wallet"
      ],
      "default": "sdk:none"
    },
    "auth": {
      "options": [
        "auth:none",
        "auth:better-auth",
        "auth:clerk",
        "auth:supabase-auth"
      ],
      "default": "auth:none"
    },
    "payments": {
      "options": [
        "payments:none",
        "payments:stripe",
        "payments:coinbase-commerce"
      ],
      "default": "payments:none"
    },
    "queue": {
      "options": [
        "queue:none",
        "queue:bullmq",
        "queue:trigger-dev"
      ],
      "default": "queue:none"
    }
  },
  "defaults": {
    "serviceName": "starter-foundry-rust",
    "port": 8091,
    "databaseProvider": "sqlite"
  },
  "validationChecks": [
    {
      "type": "file-exists",
      "path": "Cargo.toml"
    },
    {
      "type": "http-start",
      "command": [
        "cargo",
        "run",
        "--quiet"
      ],
      "path": "/health",
      "expect": "\"{{serviceName}}\""
    }
  ],
  "contextHints": {
    "commands": [
      "cargo run",
      "cargo check"
    ],
    "entrypoints": [
      "src/main.rs",
      "Cargo.toml"
    ],
    "preview": {
      "path": "/health"
    },
    "extensionPoints": [
      "database-config.json",
      "auth-config.json",
      "payments-config.json",
      "queue-config.json",
      "sdk-config.json"
    ]
  },
  "keywords": [
    "rust",
    "rust service",
    "axum",
    "rust api",
    "rust backend",
    "cargo"
  ],
  "scoring": {
    "boost": {
      "rust": 2
    }
  }
}
