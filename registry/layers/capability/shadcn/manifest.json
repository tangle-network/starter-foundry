{
  "id": "shadcn",
  "description": "Adds shadcn/ui component system with cn() utility, path aliases, and base UI components ready to use.",
  "appliesTo": [
    "react-vite-ts",
    "nextjs-ts",
    "fullstack-ts",
    "remix-ts",
    "electron-desktop-ts",
    "tauri-desktop",
    "electron-native-os",
    "multimodal-agent"
  ],
  "files": [
    {
      "source": "files/shadcn-config.json",
      "target": "shadcn-config.json"
    },
    {
      "source": "files/utils.ts",
      "target": "src/lib/utils.ts"
    },
    {
      "source": "files/alert.tsx",
      "target": "src/components/ui/alert.tsx"
    },
    {
      "source": "files/avatar.tsx",
      "target": "src/components/ui/avatar.tsx"
    },
    {
      "source": "files/badge.tsx",
      "target": "src/components/ui/badge.tsx"
    },
    {
      "source": "files/breadcrumb.tsx",
      "target": "src/components/ui/breadcrumb.tsx"
    },
    {
      "source": "files/button.tsx",
      "target": "src/components/ui/button.tsx"
    },
    {
      "source": "files/card.tsx",
      "target": "src/components/ui/card.tsx"
    },
    {
