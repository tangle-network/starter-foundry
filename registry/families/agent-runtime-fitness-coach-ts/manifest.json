{
  "id": "agent-runtime-fitness-coach-ts",
  "description": "Voice-first personal fitness coach agent bundle \u2014 general strength & conditioning programming, technique cues, and deload protocols. Explicitly NOT a licensed physical therapist, not a doctor, not a registered dietitian. Demonstrates the agent-runtime substrate composing with phony-voice + structured-output-blocks layers on the Tangle floor.",
  "tags": [
    "agent-runtime",
    "fitness-coach",
    "personal-trainer",
    "voice-first",
    "cloudflare-worker"
  ],
  "taxonomy": {
    "language": "markdown",
    "runtime": "cloudflare-worker",
    "surface": "agent-runtime"
  },
  "includes": [
    "agent-base:tangle",
    "agent-base:secure",
    "agent-tools:phony-voice",
    "agent-output:blocks",
    "agent-base:memory",
    "agent-base:scheduler",
    "agent-base:mcp-registry",
    "agent-channels:telegram",
    "agent-channels:discord",
    "agent-channels:slack",
    "agent-channels:whatsapp",
    "agent-channels:imessage",
    "agent-channels:gmail",
    "agent-channels:linear"
  ],
  "defaults": {
    "projectType": "agent-runtime-fitness-coach",
    "agentName": "fitness-coach",
    "publicVars": [
      "AGENT_NAME"
    ],
    "routes": [
      {
        "path": "/api/chat",
        "auth": "bearer",
        "callsTools": [
          "voice-stt",
          "voice-tts",
          "weekly-program",
          "form-check",
          "deload"
        ]
      },
      {
        "path": "/api/health",
        "auth": "none",
        "callsTools": []
      }
    ],
    "declaredCapabilities": [
      "weekly-program",
      "form-check-protocol",
      "deload-prompt"
    ],
    "runtime": {
      "sandbox": "tangle",
      "noNewPrivileges": true,
      "capDrop": "ALL"
    },
    "schedule": [
      {
        "id": "scheduled-1",
        "cron": "0 14 * * *",
        "capability": "weekly-program"
      }
    ],
    "outboundDomains": [
      "api.tangle.tools"
    ],
    "secrets": [
      "TANGLE_ROUTER_KEY",
      "PHONY_API_KEY"
    ]
  },
  "files": [
    {
      "source": "files/agent.json",
      "target": "agent.json"
    },
    {
      "source": "files/AGENTS.md",
      "target": "AGENTS.md"
    },
    {
      "source": "files/methodology/index.json",
      "target": "methodology/index.json"
    },
    {
      "source": "files/methodology/weekly-program.md",
      "target": "methodology/weekly-program.md"
    },
    {
      "source": "files/methodology/form-check-protocol.md",
      "target": "methodology/form-check-protocol.md"
    },
    {
      "source": "files/methodology/deload-prompt.md",
      "target": "methodology/deload-prompt.md"
    },
    {
      "source": "files/README.md",
      "target": "README.md"
    },
    {
      "source": "files/TOOLS.md",
      "target": "TOOLS.md"
    }
  ],
  "validationChecks": [
    {
      "type": "file-exists",
      "path": "AGENTS.md"
    },
    {
      "type": "file-exists",
      "path": "methodology/index.json"
    },
    {
      "type": "agents-md-valid",
      "path": "AGENTS.md"
    },
    {
      "type": "methodology-index-valid",
      "path": "methodology/index.json"
    },
    {
      "type": "schedule-valid",
      "path": "manifest.json"
    },
    {
      "type": "file-exists",
      "path": "TOOLS.md"
    }
  ],
  "contextHints": {
    "commands": [],
    "entrypoints": [
      "AGENTS.md"
    ],
    "extensionPoints": [
      "templates/",
      "src/lib/tools/"
    ]
  },
  "keywords": [
    "fitness-coach",
    "personal-trainer",
    "workout-coach",
    "strength-training",
    "rpe",
    "deload",
    "voice"
  ],
  "tieredKeywords": {
    "tier1": [
      "fitness-coach",
      "fitness coach",
      "personal-trainer-agent",
      "personal trainer agent",
      "workout-coach",
      "workout coach",
      "strength-coach",
      "strength coach"
    ],
    "tier2": [
      "macros",
      "rpe",
      "rir",
      "progressive-overload",
      "progressive overload",
      "deload",
      "mobility",
      "hypertrophy",
      "periodization",
      "form check"
    ],
    "tier3": [
      "coaching agent",
      "trainer agent"
    ],
    "archetypes": [
      "agent-in-sandbox",
      "coaching-agent",
      "voice-first"
    ]
  }
}
