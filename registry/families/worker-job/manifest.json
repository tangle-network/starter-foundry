{
  "id": "worker-job",
  "description": "Runnable worker starter for bots and background jobs.",
  "tags": [
    "worker",
    "bot"
  ],
  "taxonomy": {
    "language": "javascript",
    "runtime": "node",
    "surface": "worker"
  },
  "defaults": {
    "projectType": "worker",
    "workerName": "Starter Foundry Worker",
    "databaseProvider": "none"
  },
  "slots": {
    "queue": {
      "options": [
        "queue:none",
        "queue:bullmq",
        "queue:trigger-dev"
      ],
      "default": "queue:none"
    }
  },
  "files": [
    {
      "source": "files/package.json",
      "target": "package.json"
    }
  ],
  "validationChecks": [
    {
      "type": "file-exists",
      "path": "worker.mjs"
    },
    {
      "type": "node-syntax",
      "path": "worker.mjs"
    },
    {
      "type": "command-success",
      "command": [
        "node",
        "worker.mjs"
      ],
      "env": {
        "RUN_ONCE": "1"
      },
      "expect": "cycle complete"
    }
  ],
  "contextHints": {
    "commands": [
      "npm run start"
    ],
    "entrypoints": [
      "worker.mjs"
    ],
    "preview": null,
    "extensionPoints": [
      "market-feed.json",
      "hooks.mjs",
      "queue-config.json"
    ]
  },
  "keywords": [
    "bot",
    "worker",
    "trading",
    "queue",
    "cron",
    "stream",
    "telegram bot",
    "telegram trading"
  ]
}
