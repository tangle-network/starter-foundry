{
  "id": "realtime-ws",
  "description": "Adds WebSocket server with rooms, presence tracking, and pub/sub broadcast.",
  "appliesTo": [
    "api-service",
    "fullstack-ts"
  ],
  "defaults": {
    "wsHeartbeatMs": 30000,
    "wsMaxConnections": 1000
  },
  "files": [
    {
      "source": "files/realtime-config.json",
      "target": "realtime-config.json"
    },
    {
      "source": "files/ws-types.ts",
      "target": "lib/ws-types.ts"
    },
    {
      "source": "files/ws-server.ts",
      "target": "lib/ws-server.ts"
    },
    {
      "source": "files/ws-client.ts",
      "target": "hooks/use-websocket.ts"
    }
  ],
  "contextHints": {
    "extensionPoints": [
      "realtime-config.json",
      "lib/ws-server.ts",
      "hooks/use-websocket.ts"
    ]
  },
  "keywords": [
    "websocket",
    "websocket server",
    "real-time updates",
    "realtime api",
    "live updates",
    "pub/sub server",
    "presence tracking",
    "websocket api"
  ],
  "buildHints": {
    "apiRoutes": [
      "/api/ws"
    ],
    "components": [
      "PresenceIndicator",
      "OnlineUsers",
      "LiveUpdates"
    ],
    "dataModels": [
      "Room",
      "Presence",
      "Message"
    ],
    "integrations": [
      "WebSocket upgrade handler",
      "Room-based pub/sub"
    ]
  }
}
