{
  "id": "agent-runtime-career-coach-ts",
  "description": "Career coach agent bundle \u2014 helps professionals navigate career transitions, job searches, and professional growth. Provides structured frameworks for self-assessment, market positioning, and decision-making. Advisory only \u2014 never replaces a licensed career counselor, therapist, or recruiter.",
  "tags": [
    "agent-runtime",
    "career-coach",
    "advisory",
    "career-transition",
    "job-search",
    "professional-development",
    "cloudflare-worker"
  ],
  "taxonomy": {
    "language": "markdown",
    "runtime": "cloudflare-worker",
    "surface": "agent-runtime"
  },
  "includes": [
    "agent-base:tangle",
    "agent-base:secure",
    "agent-output:blocks",
    "agent-base:memory",
    "agent-base:scheduler",
    "agent-base:mcp-registry",
