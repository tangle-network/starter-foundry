{
  "id": "agent-runtime-travel-planner-ts",
  "description": "Voice-first travel planning agent bundle — itinerary design, budget optimization, and trip logistics. Not a licensed travel agent, not a booking platform, not a substitute for real-time flight/hotel availability. Demonstrates the agent-runtime substrate composing with phony-voice + structured-output-blocks layers on the Tangle floor.",
  "tags": [
    "agent-runtime",
    "travel-planner",
    "itinerary",
    "voice-first",
    "cloudflare-worker"
  ],
  "taxonomy": {
    "language": "markdown",
    "runtime": "cloudflare-worker",
    "surface": "agent-runtime"
  },
  "includes": [
    "agent-base:tangle",
    "agent-base:secure",
    "agent-output:blocks"
  ],
  "defaults": {
    "projectType": "agent-runtime-travel-planner",
    "agentName": "travel-planner",
    "publicVars": [
      "AGENT_NAME"
    ],
    "routes": [
      {
        "path": "/api/chat",
        "auth": "bearer",
        "callsTools": [
          "itinerary-design",
          "budget-optimization",
          "logistics-check"
        ]
      },
      {
        "path": "/api/health",
        "auth": "none",
        "callsTools": []
      }
    ],
    "declaredCapabilities": [
      "itinerary-design",
      "budget-optimization",
      "logistics-check"
    ],
    "runtime": {
      "sandbox": "tangle",
      "noNewPrivileges": true,
      "capDrop": "ALL"
    },
    "stakes": "low",
    "advisoryOnly": true,
    "outboundDomains": [
      "api.tangle.tools"
    ],
    "secrets": [
      "TANGLE_ROUTER_KEY"
    ]
  },
  "files": [
    {
      "source": "files/agent.json",
      "target": "agent.json"
    },
    {
      "source": "files/system-prompt.md",
      "target": "system-prompt.md"
    },
    {
      "source": "files/methodology/index.json",
      "target": "methodology/index.json"
    },
    {
      "source": "files/methodology/itinerary-design.md",
      "target": "methodology/itinerary-design.md"
    },
    {
      "source": "files/methodology/budget-optimization.md",
      "target": "methodology/budget-optimization.md"
    },
    {
      "source": "files/methodology/logistics-check.md",
      "target": "methodology/logistics-check.md"
    },
    {
      "source": "files/README.md",
      "target": "README.md"
    },
    {
      "source": "files/TOOLS.md",
      "target": "TOOLS.md"
    }
  ],
  "contextHints": {
    "commands": [],
    "entrypoints": [
      "system-prompt.md"
    ],
    "extensionPoints": [
      "templates/",
      "src/lib/tools/"
    ]
  },
  "tieredKeywords": {
    "tier1": [
      "trip planner agent"
    ],
    "tier2": [
      "packing-list",
      "packing list"
    ],
    "tier3": [],
    "archetypes": [
      "agent-in-sandbox",
      "coaching-agent"
    ]
  }
}
