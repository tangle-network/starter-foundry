{
  "id": "agent-rag",
  "description": "Adds RAG pipeline seams with vector DB config, embedding strategy, and retrieval hooks.",
  "appliesTo": [
    "agent-service-ts",
    "agent-service-py",
    "agent-service-rust"
  ],
  "defaults": {
    "vectorDb": "chromadb",
    "embeddingModel": "text-embedding-3-small",
    "chunkSize": 512
  },
  "files": [
    {
      "source": "files/rag-config.json",
      "target": "rag-config.json"
    },
    {
      "source": "files/retrieval-pipeline.ts",
      "target": "retrieval-pipeline.ts"
    }
  ],
  "contextHints": {
    "extensionPoints": [
      "rag-config.json",
      "retrieval-pipeline.ts"
    ]
  },
  "keywords": [
    "rag",
    "retrieval augmented",
    "vector database",
    "knowledge base",
    "document qa",
    "embeddings",
    "semantic search",
    "pinecone",
    "chromadb",
    "weaviate",
    "qdrant"
  ],
  "buildHints": {
    "apiRoutes": [
      "/api/ingest",
      "/api/query"
    ],
    "components": [
      "DocumentUploader",
      "SearchResults",
      "SourceCitation"
    ],
    "dataModels": [
      "Document",
      "Chunk",
      "Embedding",
      "SearchResult"
    ],
    "integrations": [
      "Vector database",
      "Embedding API",
      "Document parser"
    ]
  }
}
