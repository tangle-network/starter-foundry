{
  "name": "{{projectName}}",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names api,web \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "pnpm typecheck && vite build && tsc -p tsconfig.server.json",
    "preview": "pnpm start",
    "start": "node server-dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.0.10",
    "@hocuspocus/provider": "^4.4.0",
    "@nanostores/react": "1.1.0",
    "@tangle-network/agent-interface": "0.36.0",
    "@tangle-network/brand": "1.1.0",
    "@tangle-network/sandbox-ui": "0.90.3",
    "@tangle-network/sandbox": "0.15.2",
    "@tangle-network/ui": "11.2.1",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-collaboration": "^3.29.2",
    "@tiptap/extension-collaboration-caret": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "dotenv": "^17.4.2",
    "hono": "^4.12.32",
    "nanostores": "1.4.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.4",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.3"
  }
}
