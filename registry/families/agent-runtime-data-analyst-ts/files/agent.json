{
  "name": "data-analyst",
  "description": "Data analyst agent bundle — SQL, Python, and visualization for ad-hoc analytics, dashboards, and data-quality checks. Composes the agent-runtime substrate with the tangle layer and structured-output-blocks. Advisory only — never replaces a dedicated data-engineering or BI team.",
  "version": "0.1.0",
  "tags": [
    "agent-runtime",
    "data-analyst",
    "analytics",
    "sql",
    "python",
    "visualization",
    "cloudflare-worker"
  ],
  "prompt": {
    "systemPromptFile": "AGENTS.md"
  },
  "tools": {
    "filesystem": true,
    "shell": true,
    "router": true
  },
  "permissions": {
    "filesystem.write": "ask",
    "shell.exec": "ask",
    "network": "ask"
  },
  "resources": {
    "files": [
      {
        "source": "methodology/",
        "target": "/workspace/methodology/"
      },
      {
        "source": "README.md",
        "target": "/workspace/README.md"
      },
      {
        "source": "TOOLS.md",
        "target": "/workspace/TOOLS.md"
      }
    ]
  }
}
