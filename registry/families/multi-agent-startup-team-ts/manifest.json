{
  "id": "multi-agent-startup-team-ts",
  "description": "Curated multi-agent startup leadership team — CEO / CTO / CMO / HR / CFO-advisor with hand-tuned coordination protocols, explicit handoff blocks, and a default-respondent routing rule. Single deploy, five roles, baked-in cadence: weekly review (CEO), 1:1 + tech-debt triage (CTO), positioning + channel experiments (CMO), recruiting loop + interview rubric (HR), burn / runway / fundraise prep (CFO). Each role's system prompt explicitly references the others and routes via :::handoff blocks rather than improvising.",
  "tags": [
    "multi-agent",
    "team",
    "startup",
    "advisory",
    "exec-pod",
    "leadership-team-agent",
    "cloudflare-worker"
  ],
