{
  "id": "agent-runtime-meditation-coach-ts",
  "description": "Voice-first meditation coach agent bundle \u2014 guided sessions, technique cues, and mindfulness protocols. Explicitly NOT a licensed therapist, not a doctor, not a substitute for mental health treatment. Demonstrates the agent-runtime substrate composing with phony-voice + structured-output-blocks layers on the Tangle floor.",
  "tags": [
    "agent-runtime",
    "meditation-coach",
    "mindfulness",
    "voice-first",
    "cloudflare-worker"
  ],
  "taxonomy": {
    "language": "markdown",
    "runtime": "cloudflare-worker",
    "surface": "agent-runtime"
  },
  "includes": [
    "agent-base:tangle",
    "agent-base:secure",
    "agent-tools:phony-voice",
    "agent-output:blocks"
  ],
  "defaults": {
    "projectType": "agent-runtime-meditation-coach",
    "agentName": "meditation-coach",
    "publicVars": [
      "AGENT_NAME"
    ],
    "routes": [
      {
        "path": "/api/chat",
        "auth": "bearer",
        "callsTools": [
          "voice-stt",
          "voice-tts",
          "guided-session",
          "technique-cue",
          "mindfulness-check"
        ]
      },
      {
        "path": "/api/health",
        "auth": "none",
        "callsTools": []
      }
    ],
    "declaredCapabilities": [
      "guided-session",
      "technique-cue",
      "mindfulness-check"
    ],
    "runtime": {
      "sandbox": "tangle",
      "noNewPrivileges": true,
      "capDrop": "ALL"
    },
    "stakes": "low",
    "advisoryOnly": true,
    "outboundDomains": [
      "api.tangle.tools"
    ],
    "secrets": [
      "TANGLE_ROUTER_KEY",
      "PHONY_API_KEY"
    ]
  },
  "files": [
    {
      "source": "files/system-prompt.md",
      "target": "system-prompt.md"
    },
    {
      "source": "files/methodology/index.json",
      "target": "methodology/index.json"
    },
    {
      "source": "files/methodology/guided-session.md",
      "target": "methodology/guided-session.md"
    },
    {
      "source": "files/methodology/technique-cue.md",
      "target": "methodology/technique-cue.md"
    },
    {
      "source": "files/methodology/mindfulness-check.md",
      "target": "methodology/mindfulness-check.md"
    },
    {
      "source": "files/README.md",
      "target": "README.md"
    },
    {
      "source": "files/TOOLS.md",
      "target": "TOOLS.md"
    }
  ],
  "contextHints": {
    "commands": [],
    "entrypoints": [
      "system-prompt.md"
    ],
    "extensionPoints": [
      "templates/",
      "src/lib/tools/"
    ]
  },
  "tieredKeywords": {
    "tier1": [
      "meditation-coach-agent",
      "meditation coach agent",
      "mindfulness-agent",
      "mindfulness agent",
      "guided-meditation-coach",
      "guided meditation coach"
    ],
    "tier2": [
      "breathing-exercises",
      "breathing exercises",
      "body-scan",
      "body scan",
      "loving-kindness",
      "loving kindness",
      "mindfulness-check",
      "mindfulness check",
      "technique-cue",
      "technique cue"
    ],
    "tier3": [],
    "archetypes": [
      "agent-in-sandbox",
      "coaching-agent",
      "voice-first"
    ]
  }
}
