{
  "id": "clerk",
  "slot": "auth",
  "description": "Clerk auth with sign-in, sign-up, user management, and middleware protection.",
  "appliesTo": [
    "react-vite-ts",
    "nextjs-ts",
    "fullstack-ts",
    "api-service",
    "cloudflare-worker-ts",
    "python-api",
    "rust-service",
    "go-api",
    "expo-react-native-ts",
    "browser-extension-ts",
    "electron-desktop-ts",
    "tauri-desktop",
    "mcp-server-ts",
    "dspy-pipeline-py",
    "agent-service-ts",
    "agent-service-py",
    "agent-service-rust",
    "x402-service",
    "zk-prover-service",
    "evm-infra-ts",
    "angular-ts",
    "remix-ts",
    "sveltekit-ts",
    "vue-ts"
  ],
  "defaults": {
    "authProvider": "clerk"
  },
  "files": [
    {
      "source": "files/auth-config.json",
      "target": "auth-config.json"
    }
  ],
  "buildHints": {
    "pages": [
      "/sign-in",
      "/sign-up",
      "/profile"
    ],
    "apiRoutes": [
      "/api/webhooks/clerk"
    ],
    "components": [
      "SignInButton",
      "SignUpButton",
      "UserButton",
      "ClerkProvider"
    ],
    "integrations": [
      "Clerk hosted auth",
      "Clerk webhooks for user sync"
    ],
    "architectureNotes": [
      "Wrap root layout with <ClerkProvider publishableKey={...}>.",
      "Add middleware.ts with clerkMiddleware() and route matcher.",
      "Protected pages check auth() server-side or useAuth() client-side.",
      "Webhook endpoint verifies Clerk signature and syncs user data to DB."
    ]
  },
  "keywords": []
}
