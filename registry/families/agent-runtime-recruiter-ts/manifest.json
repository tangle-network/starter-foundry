{
  "id": "agent-runtime-recruiter-ts",
  "description": "Technical-recruiter agent bundle \u2014 drafts JDs, designs structured screening rubrics, and composes interview loops. Hard-refuses any input or inference about protected-class attributes (race / gender / age / national-origin / disability). Hiring decisions stay with humans; the agent produces artifacts (`:::artifact`) the hiring team reviews, edits, and signs off on. Demonstrates the agent-runtime substrate composing with structured-output-blocks on the Tangle floor for a moderate-stakes operations workflow.",
  "tags": [
    "agent-runtime",
    "recruiting",
    "talent-acquisition",
    "structured-interviews",
    "cloudflare-worker"
  ],
  "taxonomy": {
    "language": "markdown",
    "runtime": "cloudflare-worker",
    "surface": "agent-runtime"
  },
  "includes": [
    "agent-base:tangle",
    "agent-base:secure",
    "agent-base:privacy",
    "agent-output:blocks",
    "agent-base:memory",
    "agent-base:scheduler",
    "agent-base:mcp-registry",
    "agent-channels:telegram",
    "agent-channels:discord",
    "agent-channels:slack",
    "agent-channels:whatsapp",
    "agent-channels:imessage",
    "agent-channels:gmail",
    "agent-channels:linear"
  ],
  "defaults": {
    "projectType": "agent-runtime-recruiter",
    "agentName": "technical-recruiter",
    "publicVars": [
      "AGENT_NAME"
    ],
    "routes": [
      {
        "path": "/api/chat",
        "auth": "bearer",
        "callsTools": [
          "jd-drafter",
          "rubric-builder",
          "loop-composer"
        ]
      },
      {
        "path": "/api/health",
        "auth": "none",
        "callsTools": []
      }
    ],
    "declaredCapabilities": [
      "jd-drafting",
      "screening-rubric-design",
      "interview-loop-design"
    ],
    "runtime": {
      "sandbox": "tangle",
      "noNewPrivileges": true,
      "capDrop": "ALL"
    },
    "biasSafeguards": {
      "protectedClassRefusal": true,
      "compensationPolicy": "published-bands-only",
      "inclusiveLanguageAudit": true,
      "structuredInterviewDefault": true
    },
    "schedule": [
      {
        "id": "scheduled-1",
        "cron": "0 13 * * 1",
        "capability": "jd-drafting"
      }
    ],
    "outboundDomains": [
      "api.tangle.tools"
    ],
    "secrets": [
      "TANGLE_API_KEY"
    ]
  },
  "files": [
    {
      "source": "files/agent.json",
      "target": "agent.json"
    },
    {
      "source": "files/AGENTS.md",
      "target": "AGENTS.md"
    },
    {
      "source": "files/methodology/index.json",
      "target": "methodology/index.json"
    },
    {
      "source": "files/methodology/jd-drafting-protocol.md",
      "target": "methodology/jd-drafting-protocol.md"
    },
    {
      "source": "files/methodology/screening-rubric.md",
      "target": "methodology/screening-rubric.md"
    },
    {
      "source": "files/methodology/interview-loop-design.md",
      "target": "methodology/interview-loop-design.md"
    },
    {
      "source": "files/README.md",
      "target": "README.md"
    },
    {
      "source": "files/TOOLS.md",
      "target": "TOOLS.md"
    }
  ],
  "validationChecks": [
    {
      "type": "file-exists",
      "path": "AGENTS.md"
    },
    {
      "type": "file-exists",
      "path": "methodology/index.json"
    },
    {
      "type": "agents-md-valid",
      "path": "AGENTS.md"
    },
    {
      "type": "methodology-index-valid",
      "path": "methodology/index.json"
    },
    {
      "type": "schedule-valid",
      "path": "manifest.json"
    },
    {
      "type": "file-exists",
      "path": "TOOLS.md"
    }
  ],
  "contextHints": {
    "commands": [],
    "entrypoints": [
      "AGENTS.md"
    ],
    "extensionPoints": [
      "templates/",
      "src/lib/tools/"
    ]
  },
  "keywords": [
    "recruiting",
    "talent-acquisition",
    "technical-recruiter",
    "screening",
    "interview-design",
    "compensation-bands"
  ],
  "tieredKeywords": {
    "tier1": [
      "technical-recruiter",
      "technical recruiter",
      "recruiter-agent",
      "recruiter agent",
      "talent-pipeline",
      "talent pipeline",
      "talent acquisition"
    ],
    "tier2": [
      "sourcing",
      "screening",
      "interview-design",
      "interview design",
      "leveling",
      "compensation-bands",
      "compensation bands",
      "interview-loop",
      "interview loop"
    ],
    "tier3": [
      "recruiter",
      "hiring"
    ],
    "archetypes": [
      "agent-in-sandbox",
      "operations-agent"
    ]
  }
}
