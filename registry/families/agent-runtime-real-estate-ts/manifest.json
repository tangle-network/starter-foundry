{
  "id": "agent-runtime-real-estate-ts",
  "description": "Real-estate advisor agent bundle — explicitly NOT a licensed real-estate broker. Drafts comparable-market-analysis worksheets, cap-rate / NOI / cash-on-cash math, and offer-strategy frameworks for the user's own decision-making. Jurisdiction-agnostic; all binding-decision support (offer drafting, escrow, title, tenant disputes, HOA interpretation, jurisdiction-specific tax/title) escalates to a licensed agent. Fair Housing Act compliant: analyzes property attributes only, never neighborhood social characteristics.",
  "tags": [
    "agent-runtime",
    "real-estate",
    "advisory",
    "cloudflare-worker"
  ],
  "taxonomy": {
    "language": "markdown",
    "runtime": "cloudflare-worker",
    "surface": "agent-runtime"
  },
  "includes": [
    "agent-base:tangle",
    "agent-output:blocks"
  ],
  "defaults": {
    "projectType": "agent-runtime-real-estate",
    "agentName": "real-estate-advisor",
    "allowedDomains": ["api.tangle.tools", "irs.gov", "hud.gov"],
    "allowedEnv": ["TANGLE_ROUTER_KEY"],
    "publicVars": ["AGENT_NAME"],
    "routes": [
      { "path": "/api/chat", "auth": "bearer", "callsTools": ["comp-analysis", "cap-rate-worksheet", "offer-strategy", "escalation"] },
      { "path": "/api/health", "auth": "none", "callsTools": [] }
    ],
    "declaredCapabilities": ["comp-analysis", "cap-rate-worksheet", "offer-strategy"],
    "disclaimerRequired": true,
    "runtime": {
      "sandbox": "tangle",
      "noNewPrivileges": true,
      "capDrop": "ALL"
    }
  },
  "files": [
    { "source": "files/system-prompt.md", "target": "system-prompt.md" },
    { "source": "files/templates/index.json", "target": "templates/index.json" },
    { "source": "files/templates/comp-analysis.md", "target": "templates/comp-analysis.md" },
    { "source": "files/templates/cap-rate-worksheet.md", "target": "templates/cap-rate-worksheet.md" },
    { "source": "files/templates/offer-strategy.md", "target": "templates/offer-strategy.md" },
    { "source": "files/wrangler.toml", "target": "wrangler.toml" },
    { "source": "files/README.md", "target": "README.md" }
  ],
  "validationChecks": [
    { "type": "file-exists", "path": "system-prompt.md" },
    { "type": "file-exists", "path": "templates/index.json" },
    { "type": "file-exists", "path": "wrangler.toml" },
    { "type": "prompt-frontmatter-valid", "path": "system-prompt.md" },
    { "type": "template-index-valid", "path": "templates/index.json" }
  ],
  "contextHints": {
    "commands": [],
    "entrypoints": ["system-prompt.md"],
    "extensionPoints": ["templates/", "src/lib/tools/"]
  },
  "keywords": [
    "real-estate",
    "real estate",
    "property",
    "comps",
    "cap-rate",
    "1031-exchange"
  ],
  "tieredKeywords": {
    "tier1": [
      "real-estate-agent",
      "real estate agent",
      "property-advisor",
      "property advisor",
      "real-estate-bot",
      "real estate bot"
    ],
    "tier2": [
      "comps",
      "comparables",
      "cap-rate",
      "cap rate",
      "1031-exchange",
      "1031 exchange",
      "title",
      "escrow",
      "buyer-broker",
      "buyer broker",
      "NOI",
      "cash-on-cash"
    ],
    "tier3": ["agent", "advisor"],
    "archetypes": ["agent-in-sandbox", "advisory-agent"]
  }
}
