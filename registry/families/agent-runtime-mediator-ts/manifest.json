{
  "id": "agent-runtime-mediator-ts",
  "description": "Voice-first mediator / conflict-coach agent bundle — facilitates structured dialogue, de-escalation protocols, and agreement drafting for interpersonal and small-group conflicts. Explicitly NOT a licensed therapist, not a lawyer, not a substitute for professional mediation in legal or HR contexts. Composes the agent-runtime substrate with phony-voice + structured-output-blocks layers on the Tangle floor.",
  "tags": [
    "agent-runtime",
    "mediator",
    "conflict-coach",
    "voice-first",
    "cloudflare-worker"
  ],
  "taxonomy": {
    "language": "markdown",
    "runtime": "cloudflare-worker",
    "surface": "agent-runtime"
  },
  "includes": [
    "agent-base:tangle",
    "agent-base:secure",
    "agent-tools:phony-voice",
    "agent-output:blocks"
  ],
  "defaults": {
    "projectType": "agent-runtime-mediator",
    "agentName": "mediator",
    "publicVars": [
      "AGENT_NAME"
    ],
    "routes": [
      {
        "path": "/api/chat",
        "auth": "bearer",
        "callsTools": [
          "voice-stt",
          "voice-tts",
          "structured-dialogue",
          "de-escalation",
          "agreement-draft"
        ]
      },
      {
        "path": "/api/health",
        "auth": "none",
        "callsTools": []
      }
    ],
    "declaredCapabilities": [
      "structured-dialogue",
      "de-escalation-protocol",
      "agreement-drafting"
    ],
    "runtime": {
      "sandbox": "tangle",
      "noNewPrivileges": true,
      "capDrop": "ALL"
    },
    "stakes": "moderate",
    "advisoryOnly": true,
    "outboundDomains": [
      "api.tangle.tools"
    ],
    "secrets": [
      "TANGLE_ROUTER_KEY",
      "PHONY_API_KEY"
    ]
  },
  "files": [
    {
      "source": "files/agent.json",
      "target": "agent.json"
    },
    {
      "source": "files/system-prompt.md",
      "target": "system-prompt.md"
    },
    {
      "source": "files/methodology/index.json",
      "target": "methodology/index.json"
    },
    {
      "source": "files/methodology/structured-dialogue.md",
      "target": "methodology/structured-dialogue.md"
    },
    {
      "source": "files/methodology/de-escalation-protocol.md",
      "target": "methodology/de-escalation-protocol.md"
    },
    {
      "source": "files/methodology/agreement-drafting.md",
      "target": "methodology/agreement-drafting.md"
    },
    {
      "source": "files/README.md",
      "target": "README.md"
    },
    {
      "source": "files/TOOLS.md",
      "target": "TOOLS.md"
    }
  ],
  "contextHints": {
    "commands": [],
    "entrypoints": [
      "system-prompt.md"
    ],
    "extensionPoints": [
      "templates/",
      "src/lib/tools/"
    ]
  },
  "tieredKeywords": {
    "tier1": [
      "mediator-agent",
      "mediator agent",
      "conflict-coach-agent",
      "conflict coach agent",
      "conflict-mediator",
      "conflict mediator"
    ],
    "tier2": [
      "de-escalation",
      "structured-dialogue",
      "structured dialogue",
      "agreement-drafting",
      "agreement drafting",
      "active-listening",
      "active listening",
      "restorative-practices",
      "restorative practices"
    ],
    "tier3": [],
    "archetypes": [
      "agent-in-sandbox",
      "coaching-agent",
      "voice-first"
    ]
  }
}
