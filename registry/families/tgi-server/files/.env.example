# HuggingFace Hub model id. Gated repos (Llama/Mistral/Gemma) require a token
# AND acceptance of the model license on huggingface.co.
MODEL_ID={{modelId}}

# Required for gated models. Create at https://huggingface.co/settings/tokens
# (read scope is sufficient). Never commit the real token.
HUGGING_FACE_HUB_TOKEN=

# Request budget. MAX_INPUT_LENGTH must be STRICTLY LESS than MAX_TOTAL_TOKENS;
# the difference is the generation budget per request.
MAX_INPUT_LENGTH={{maxInputLength}}
MAX_TOTAL_TOKENS={{maxTotalTokens}}

# Optional quantization: awq | gptq | eetq | bitsandbytes-nf4 | bitsandbytes-fp4
# Leave empty for bf16/fp16 depending on model dtype.
QUANTIZE=

# Tensor-parallel shard count. Set to your GPU count for large models.
NUM_SHARD=1

# Local TGI URL the Python client hits.
TGI_URL=http://localhost:{{port}}
