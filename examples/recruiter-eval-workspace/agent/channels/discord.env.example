# Discord channel adapter
# DISCORD_BOT_TOKEN: https://discord.com/developers/applications → your app →
#   Bot → Reset Token. Used as the Authorization: Bot <token> header.
DISCORD_BOT_TOKEN=

# DISCORD_PUBLIC_KEY: same dashboard → General Information → Public Key (hex).
#   Used to verify Ed25519 signatures on every inbound interaction. Discord
#   rejects your endpoint immediately if you don't verify these.
DISCORD_PUBLIC_KEY=

# After deploy, set Interactions Endpoint URL in the Discord dashboard to:
#   <your-https-url>/channels/discord
# Discord will PING the URL once; the adapter returns null for PING so the
# server should respond with HTTP 200 + body {"type":1}.
