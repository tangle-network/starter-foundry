{
  "id": "saas-teams",
  "description": "Adds multi-tenant teams with roles, invitations, and permission boundaries.",
  "appliesTo": [
    "nextjs-ts",
    "fullstack-ts",
    "api-service"
  ],
  "defaults": {
    "defaultRole": "member"
  },
  "files": [
    {
      "source": "files/teams-config.json",
      "target": "teams-config.json"
    },
    {
      "source": "files/teams-middleware.mjs",
      "target": "teams-middleware.mjs"
    }
  ],
  "contextHints": {
    "extensionPoints": [
      "teams-config.json",
      "teams-middleware.mjs"
    ]
  },
  "keywords": [
    "team management",
    "multi-tenant",
    "organization management",
    "team roles",
    "invitation system",
    "rbac",
    "workspace management"
  ],
  "buildHints": {
    "pages": [
      "/settings/team",
      "/settings/members",
      "/invite"
    ],
    "apiRoutes": [
      "/api/team/invite",
      "/api/team/members",
      "/api/team/roles"
    ],
    "components": [
      "TeamMemberList",
      "InviteForm",
      "RoleSelector",
      "TeamSwitcher"
    ],
    "dataModels": [
      "Team",
      "TeamMember",
      "Invitation",
      "Role"
    ],
    "integrations": [
      "Email invitations",
      "Role-based access control"
    ]
  }
}
