# HuggingFace model id. Gated repos need HUGGING_FACE_HUB_TOKEN plus license
# acceptance on huggingface.co.
MODEL_ID={{modelId}}
HUGGING_FACE_HUB_TOKEN=

# SGLang listens on 30000 by default (not 8000 — update LB/firewall rules).
PORT={{port}}
SGLANG_URL=http://localhost:{{port}}/v1

# Context length SGLang will allocate KV cache for.
CONTEXT_LENGTH={{contextLength}}

# Fraction of GPU memory reserved for static weights + KV cache.
# 0.85 is the safe default; > 0.90 risks OOM once KV cache fills.
MEM_FRACTION_STATIC=0.85

# Tensor-parallel size. Set to your GPU count for 70B-class models.
TP_SIZE=1

# Optional bearer token; set to require Authorization on /v1/*.
SGLANG_API_KEY=
