{
  "id": "admin-crud",
  "description": "Adds admin dashboard patterns with entity definitions, data tables, and bulk actions.",
  "appliesTo": [
    "nextjs-ts",
    "fullstack-ts"
  ],
  "files": [
    {
      "source": "files/admin-config.json",
      "target": "admin-config.json"
    },
    {
      "source": "files/admin-data.json",
      "target": "admin-data.json"
    }
  ],
  "contextHints": {
    "extensionPoints": [
      "admin-config.json",
      "admin-data.json"
    ]
  },
  "keywords": [
    "admin dashboard",
    "admin panel",
    "crud app",
    "back office",
    "internal tool",
    "data management",
    "admin console"
  ],
  "buildHints": {
    "pages": [
      "/admin",
      "/admin/users",
      "/admin/orders"
    ],
    "apiRoutes": [
      "/api/admin/entities",
      "/api/admin/bulk"
    ],
    "components": [
      "DataTable",
      "EntityForm",
      "BulkActionBar",
      "SearchFilter",
      "ExportButton"
    ],
    "dataModels": [
      "Entity schema from admin-config.json"
    ],
    "integrations": [
      "CSV export",
      "Bulk operations"
    ]
  }
}
