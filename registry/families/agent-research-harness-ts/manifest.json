{
  "id": "agent-research-harness-ts",
  "description": "Node-only TypeScript research workflow using @tangle-network/agent-eval. Ranks steering variants with PairwiseSteeringOptimizer, runs multi-turn search with runOptimization and runImprovementLoop, and analyzes repeated runs using analyzeRuns, bootstrap intervals, and Pareto frontiers. CLI: `pnpm research propose|screen|validate|sweep`. Results: `research-results/`.",
  "tags": [
    "research-harness",
    "agent-eval",
    "optimization-loop",
    "prompt-evolution",
    "hypothesis-loop",
    "node",
    "typescript"
  ],
  "taxonomy": {
    "language": "typescript",
    "runtime": "node",
    "surface": "research-runner"
  },
  "includes": [
    "agent-base:tangle",
    "agent-base:secure",
    "agent-eval:scenarios",
    "agent-eval:judge-rubric",
    "agent-eval:regression",
    "agent-eval:auto-research"
  ],
  "defaults": {
    "projectType": "agent-research-harness",
    "appName": "my-research-harness",
    "publicVars": [
      "RESEARCH_RESULTS_DIR",
      "TANGLE_API_KEY"
    ],
    "resultsDir": "research-results",
    "screenerReps": 1,
    "validatorReps": 5
  },
  "files": [
    { "source": "files/agent.json", "target": "agent.json" },
    { "source": "files/AGENTS.md", "target": "AGENTS.md" },
    { "source": "files/package.json", "target": "package.json" },
    { "source": "files/tsconfig.json", "target": "tsconfig.json" },
    { "source": "files/README.md", "target": "README.md" },
    { "source": "files/src/research/runner.ts", "target": "src/research/runner.ts" },
    { "source": "files/src/research/proposer.ts", "target": "src/research/proposer.ts" },
    { "source": "files/src/research/screener.ts", "target": "src/research/screener.ts" },
    { "source": "files/src/research/validator.ts", "target": "src/research/validator.ts" },
    { "source": "files/src/research/cli.ts", "target": "src/research/cli.ts" },
    { "source": "files/src/research/types.ts", "target": "src/research/types.ts" },
    { "source": "files/hypotheses/queue.json", "target": "hypotheses/queue.json" },
    { "source": "files/hypotheses/example.json", "target": "hypotheses/example.json" },
    { "source": "files/hypotheses/README.md", "target": "hypotheses/README.md" },
    { "source": "files/.github/workflows/research.yml", "target": ".github/workflows/research.yml" },
    { "source": "files/tests/research-runner.test.ts", "target": "tests/research-runner.test.ts" },
    { "source": "files/pnpm-workspace.yaml", "target": "pnpm-workspace.yaml" }
  ],
  "validationChecks": [
    { "type": "file-exists", "path": "AGENTS.md" },
    { "type": "file-exists", "path": "agent.json" },
    { "type": "file-exists", "path": "package.json" },
    { "type": "file-exists", "path": "src/research/runner.ts" },
    { "type": "file-exists", "path": "src/research/proposer.ts" },
    { "type": "file-exists", "path": "src/research/screener.ts" },
    { "type": "file-exists", "path": "src/research/validator.ts" },
    { "type": "file-exists", "path": "src/research/cli.ts" },
    { "type": "file-exists", "path": "hypotheses/queue.json" },
    { "type": "file-exists", "path": "tests/research-runner.test.ts" },
