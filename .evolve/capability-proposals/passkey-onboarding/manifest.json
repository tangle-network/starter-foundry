{
  "id": "passkey-onboarding",
  "description": "WebAuthn passkey-based sign-in + account creation flow. Adds passkey registration UI, biometric-gated sign-in, recovery flow.",
  "appliesTo": [
    "nextjs-ts",
    "react-vite-ts",
    "kyc-onboarding"
  ],
  "defaults": {
    "passkeyConfig": {
      "rpId": "example.com",
      "rpName": "Example Inc.",
      "challengeSize": 128
    }
  },
  "files": [
    {
      "source": "files/src/passkey-onboarding-config.json",
      "target": "src/passkey-onboarding-config.json"
    },
    {
      "source": "files/src/components/PasskeyRegister.tsx",
      "target": "src/components/PasskeyRegister.tsx"
    },
    {
      "source": "files/src/components/PasskeySignIn.tsx",
      "target": "src/components/PasskeySignIn.tsx"
    },
    {
      "source": "files/passkey-onboarding.md",
      "target": "passkey-onboarding.md"
    }
  ],
  "contextHints": {
    "extensionPoints": [
      "passkey-registration-ui",
      "biometric-gated-sign-in",
      "recovery-flow",
      "custom-passkey-configuration"
    ]
  },
  "capabilityRequires": [
    "webauthn-support",
    "biometric-authentication",
    "recovery-mechanism"
  ],
  "keywords": [
    "WebAuthn",
    "passkey",
    "biometric",
    "sign-in",
    "account-creation",
    "authentication",
    "authorization",
    "security",
    "recovery",
    "onboarding"
  ],
  "tieredKeywords": {
    "tier1": [
      "WebAuthn",
      "passkey",
      "biometric",
      "sign-in",
      "account-creation"
    ],
    "tier2": [
      "authentication",
      "authorization",
      "security",
      "recovery",
      "onboarding"
    ]
  },
  "buildHints": {
    "whenToUse": "When implementing WebAuthn passkey-based sign-in and account creation flows, particularly in applications requiring biometric-gated sign-in and recovery flows."
  }
}
