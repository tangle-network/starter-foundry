    "@rainbow-me/rainbowkit":      { "capability": "capability:evm-wallet-dashboard", "confidence": 0.9 },

    "snarkjs":                     { "capability": null, "confidence": 0, "note": "JS-based zk tooling, low priority. Real zk path is Rust (sp1/risc0). If an agent reaches for snarkjs, route them to framework:zk-prover-service instead." },
    "circomlibjs":                 { "capability": null, "confidence": 0, "note": "same as snarkjs" },
    "sp1":                         { "capability": null, "confidence": 0, "note": "Rust crate, not npm. Framework-level signal for framework:zk-prover-service." },
