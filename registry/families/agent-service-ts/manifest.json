{
  "id": "agent-service-ts",
  "description": "TypeScript AI agent service starter with a lightweight control surface.",
  "tags": ["ai", "agent", "typescript", "service"],
  "taxonomy": {
    "language": "javascript",
    "runtime": "node",
    "surface": "agent-service"
  },
  "slots": {
    "database": {
      "options": [
        "database:sqlite",
        "database:postgres",
        "database:mongodb",
        "database:convex"
      ],
      "default": "database:sqlite"
    },
    "sdk": {
      "options": [
        "sdk:none",
        "sdk:coinbase-cdp",
        "sdk:solana-web3",
        "sdk:evm-wallet"
      ],
      "default": "sdk:none"
    },
    "auth": {
      "options": [
        "auth:none",
        "auth:better-auth",
        "auth:clerk",
        "auth:supabase-auth"
      ],
      "default": "auth:none"
    },
    "payments": {
      "options": [
        "payments:none",
        "payments:stripe",
        "payments:coinbase-commerce"
      ],
      "default": "payments:none"
    },
    "queue": {
      "options": [
        "queue:none",
        "queue:bullmq",
        "queue:trigger-dev"
      ],
      "default": "queue:none"
    }
  },
  "defaults": {
    "projectType": "agent-service",
    "serviceName": "starter-foundry-agent-ts",
    "port": 4192,
    "agentLibrary": "openai-agents",
    "agentSurface": "service"
  },
  "files": [
    {
      "source": "files/package.json",
      "target": "package.json"
    }
  ],
  "validationChecks": [
    {
      "type": "file-exists",
      "path": "agent.mjs"
    },
    {
      "type": "node-syntax",
      "path": "agent.mjs"
    },
    {
      "type": "http-start",
      "command": ["node", "agent.mjs"],
      "port": "{{port}}",
      "path": "/health",
      "expect": "\"agent\""
    }
  ],
  "contextHints": {
    "commands": ["node agent.mjs"],
    "entrypoints": ["agent.mjs", "agent.config.json"],
    "preview": {
      "port": "{{port}}",
      "path": "/health"
    },
    "extensionPoints": ["agent.config.json", "hooks.mjs", "sdk-config.json", "queue-config.json", "database-config.json"]
  }
}
