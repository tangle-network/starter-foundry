{
  "id": "saas-billing",
  "description": "Adds SaaS billing with plan tiers, usage metering, and subscription webhook handling.",
  "appliesTo": ["nextjs-ts", "fullstack-ts", "api-service"],
  "defaults": {
    "billingProvider": "stripe"
  },
  "files": [
    { "source": "files/billing-config.json", "target": "billing-config.json" },
    { "source": "files/billing-hooks.mjs", "target": "billing-hooks.mjs" }
  ],
  "contextHints": {
    "extensionPoints": ["billing-config.json", "billing-hooks.mjs"]
  }
}
