  "provides": [
    "channel:slack"
  ],
  "requires": [
    "secure:webhook-in"
  ],
  "defaults": {
    "channelSlackAvailable": true
  },
  "files": [
    {
      "source": "files/channels/slack.ts",
      "target": "channels/slack.ts"
    },
    {
      "source": "files/channels/slack.env.example",
      "target": "channels/slack.env.example"
    }
  ],
  "validationChecks": [
    {
      "type": "file-exists",
      "path": "channels/slack.ts"
    }
