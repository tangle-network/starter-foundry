{
  "id": "evm-layerzero-oft",
  "description": "Specializes a Foundry contract lane for omnichain token and bridge flows.",
  "domainPack": {
    "domain": {
      "family": "bridge",
      "provider": "layerzero",
      "protocol": "oft",
      "runtime": "foundry",
      "surface": "contracts"
    },
    "provides": ["bridge-contracts", "layerzero-oft", "omnichain-token", "forge-build"],
    "requires": ["solidity-contracts"],
    "ambiguityGroup": "bridge-contracts",
    "validationCommands": ["forge build", "forge test"],
    "authenticitySignals": ["LayerZero", "OFT", "sendTokens", "omnichain", "bridge"],
    "authenticityGroups": [
      {
        "id": "layerzero-sdk",
        "description": "At least one LayerZero package, endpoint, or OApp import signal should survive generation.",
        "minRequired": 1,
        "signals": [
          "@layerzerolabs/lz-evm-oapp-v2",
          "@layerzerolabs/lz-evm-protocol-v2",
          "@layerzerolabs/oapp-evm",
          "EndpointV2"
        ]
      },
      {
        "id": "oft-contract",
        "description": "Generated contracts should use OFT/OApp wiring, not generic ERC20 bridge placeholders.",
        "minRequired": 2,
        "signals": ["OFT", "OApp", "setPeer", "quoteSend", "send", "sendTokens"]
      },
      {
        "id": "bridge-deploy-config",
        "description": "The project should carry deploy/config evidence for cross-chain peers and execution settings.",
        "minRequired": 1,
        "signals": ["SendTokens.s.sol", "bridge-config.json", "trusted remotes", "enforced options", "DVN", "executor"]
      }
    ],
    "routingPrompts": [
      {
        "prompt": "Build a LayerZero OFT bridge token with Foundry",
        "expectedFamily": "forge-contracts",
        "expectedLayers": ["framework:forge-foundation", "capability:evm-layerzero-oft"]
      },
      {
        "prompt": "Build an omnichain ERC20 contract using LayerZero OFT with forge deploy scripts",
        "expectedFamily": "forge-contracts",
        "expectedLayers": ["framework:forge-foundation", "capability:evm-layerzero-oft"]
      },
      {
        "prompt": "Build a cross-chain token bridge contract with sendTokens, trusted remotes, and LayerZero endpoint config",
        "expectedFamily": "forge-contracts",
        "expectedLayers": ["framework:forge-foundation", "capability:evm-layerzero-oft"]
      }
    ]
  },
  "appliesTo": [
    "forge-contracts"
  ],
  "defaults": {
    "contractName": "OmnichainToken"
  },
  "files": [
    {
      "source": "files/OmnichainToken.sol",
      "target": "src/{{contractName}}.sol"
    },
    {
      "source": "files/OmnichainToken.t.sol",
      "target": "test/{{contractName}}.t.sol"
    },
    {
      "source": "files/SendTokens.s.sol",
      "target": "script/SendTokens.s.sol"
    },
    {
      "source": "files/bridge-config.json",
      "target": "bridge-config.json"
    }
  ],
  "contextHints": {
    "extensionPoints": [
      "src/{{contractName}}.sol",
      "script/SendTokens.s.sol",
      "bridge-config.json"
    ]
  },
  "keywords": [
    "layerzero",
    "oft",
    "omnichain fungible token",
    "bridge tokens",
    "sendtokens"
  ]
}
