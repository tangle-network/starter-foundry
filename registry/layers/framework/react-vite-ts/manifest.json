{
  "id": "react-vite-ts",
  "description": "React and Vite framework layer with Tailwind CSS and shadcn/ui support.",
  "appliesTo": ["react-vite-ts"],
  "defaults": {
    "headline": "Starter Foundry React Surface",
    "subheadline": "A React and Vite ready shell with room for rapid agent edits."
  },
  "files": [
    {
      "source": "files/index.html",
      "target": "index.html"
    },
    {
      "source": "files/styles.css",
      "target": "src/styles.css"
    },
    {
      "source": "files/personalize.css",
      "target": "src/personalize.css"
    },
    {
      "source": "files/preview-client.js",
      "target": "preview-client.js"
    },
    {
      "source": "files/vite.config.ts",
      "target": "vite.config.ts"
    },
    {
      "source": "files/tsconfig.json",
      "target": "tsconfig.json"
    },
    {
      "source": "files/main.ts",
      "target": "src/main.ts"
    },
    {
      "source": "files/App.tsx",
      "target": "src/App.tsx"
    }
  ]
}
