{
  "id": "cloudflare-worker-ts",
  "description": "Minimal Cloudflare Worker TypeScript starter.",
  "tags": [
    "edge",
    "cloudflare",
    "typescript"
  ],
  "taxonomy": {
    "language": "typescript",
    "runtime": "workerd",
    "surface": "edge-api"
  },
  "slots": {
    "database": {
      "options": [
        "database:sqlite",
        "database:postgres",
        "database:mongodb",
        "database:convex"
      ],
      "default": "database:sqlite"
    },
    "sdk": {
      "options": [
        "sdk:none",
        "sdk:coinbase-cdp",
        "sdk:solana-web3",
        "sdk:evm-wallet"
      ],
      "default": "sdk:none"
    },
    "auth": {
      "options": [
        "auth:none",
        "auth:better-auth",
        "auth:clerk",
        "auth:supabase-auth"
      ],
      "default": "auth:none"
    },
    "payments": {
      "options": [
        "payments:none",
        "payments:stripe",
        "payments:coinbase-commerce"
      ],
      "default": "payments:none"
    },
    "queue": {
      "options": [
        "queue:none",
        "queue:bullmq",
        "queue:trigger-dev"
      ],
      "default": "queue:none"
    }
  },
  "defaults": {
    "serviceName": "starter-foundry-edge",
    "databaseProvider": "sqlite"
  },
  "files": [
    {
      "source": "files/package.json",
      "target": "package.json"
    },
    {
      "source": "files/wrangler.jsonc",
      "target": "wrangler.jsonc"
    },
    {
      "source": "files/validate-worker.mjs",
      "target": "validate-worker.mjs"
    }
  ],
  "validationChecks": [
    {
      "type": "file-exists",
      "path": "src/worker.ts"
    },
    {
      "type": "command-success",
      "command": [
        "node",
        "--experimental-strip-types",
        "validate-worker.mjs"
      ],
      "expect": "worker ok"
    }
  ],
  "contextHints": {
    "commands": [
      "node --experimental-strip-types validate-worker.mjs",
      "wrangler dev"
    ],
    "entrypoints": [
      "src/worker.ts",
      "wrangler.jsonc"
    ],
    "preview": null,
    "extensionPoints": [
      "database-config.json",
      "auth-config.json",
      "payments-config.json",
      "queue-config.json",
      "sdk-config.json"
    ]
  },
  "keywords": [
    "cloudflare",
    "durable object",
    "edge api",
    "edge function",
    "hono edge",
    "workerd"
  ]
}
