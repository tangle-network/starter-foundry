{
  "id": "agent-runtime-grant-writer-ts",
  "description": "Grant writer agent bundle \u2014 helps nonprofit operators draft compelling grant proposals, manage deadlines, and track reporting requirements. Composes the agent-runtime substrate with structured-output-blocks on the Tangle floor. Advisory only \u2014 never replaces a professional grant writer or fundraising consultant.",
  "tags": [
    "agent-runtime",
    "grant-writing",
    "nonprofit",
    "advisory-agent",
    "cloudflare-worker"
  ],
  "taxonomy": {
    "language": "markdown",
    "runtime": "cloudflare-worker",
    "surface": "agent-runtime"
  },
  "includes": [
    "agent-base:tangle",
    "agent-base:secure",
    "agent-output:blocks",
    "agent-base:memory",
    "agent-base:scheduler",
    "agent-base:mcp-registry",
