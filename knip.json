{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/**/*.ts",
    "tests/**/*.test.ts",
    "src/training/**/run*.ts",
    "src/training/**/train.ts",
    "src/training/**/flow.ts",
    "src/training/variant_b/brief-loader.ts",
    "src/training/variant_b/generate.ts",
    "src/training/variant_b/judge.ts",
    "src/training/template_v1/run.ts",
    "src/training/family_proposer/propose.ts",
    "src/training/capability_proposer/propose.ts",
    "src/eval/replay.ts",
    "src/eval/diagnoser.ts",
    "src/eval/propose.ts",
    "src/eval/scaffold-bridge.ts",
    "src/lib/buildout-traces.ts",
    "src/lib/capability-inferrer.ts",
    "src/lib/promoter-gates.ts",
    "src/lib/template-quality.ts",
    "src/lib/vb-outcomes.ts"
  ],
  "project": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.test.ts"],
  "ignore": ["registry/**", "src/types/registry-schemas.generated.ts"],
  "ignoreExportsUsedInFile": true,
  "paths": {
    "../dist/*": ["src/*"]
  }
}
