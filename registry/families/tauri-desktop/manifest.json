{
  "id": "tauri-desktop",
  "description": "Tauri desktop starter with a web shell preview and native app structure.",
  "tags": ["desktop", "tauri", "rust", "typescript"],
  "taxonomy": {
    "language": "rust",
    "runtime": "tauri",
    "surface": "desktop"
  },
  "slots": {
    "auth": {
      "options": [
        "auth:none",
        "auth:better-auth",
        "auth:clerk",
        "auth:supabase-auth"
      ],
      "default": "auth:none"
    },
    "payments": {
      "options": [
        "payments:none",
        "payments:stripe",
        "payments:coinbase-commerce"
      ],
      "default": "payments:none"
    },
    "sdk": {
      "options": [
        "sdk:none",
        "sdk:coinbase-cdp",
        "sdk:solana-web3"
      ],
      "default": "sdk:none"
    }
  },
  "defaults": {
    "projectType": "desktop",
    "port": 4186,
    "headline": "Starter Foundry Tauri App",
    "subheadline": "A native desktop shell with a lightweight web surface and Rust host layer."
  },
  "files": [
    {
      "source": "files/package.json",
      "target": "package.json"
    },
    {
      "source": "files/preview-server.mjs",
      "target": "preview-server.mjs"
    },
    {
      "source": "files/validate-types.mjs",
      "target": "validate-types.mjs"
    }
  ],
  "validationChecks": [
    {
      "type": "file-exists",
      "path": "src-tauri/Cargo.toml"
    },
    {
      "type": "command-success",
      "command": ["node", "validate-types.mjs"],
      "expect": "tauri starter ok"
    },
    {
      "type": "http-start",
      "command": ["node", "preview-server.mjs"],
      "path": "/",
      "expect": "{{headline}}"
    }
  ],
  "contextHints": {
    "commands": ["npm install", "node preview-server.mjs", "cargo tauri dev"],
    "entrypoints": ["src-tauri/Cargo.toml", "src-tauri/src/main.rs", "web/index.html"],
    "preview": {
      "path": "/"
    },
    "extensionPoints": ["auth-config.json", "payments-config.json", "sdk-config.json"]
  }
}
