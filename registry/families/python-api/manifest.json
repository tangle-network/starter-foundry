{
  "id": "python-api",
  "description": "Minimal Python API starter with health endpoint.",
  "tags": [
    "python",
    "api"
  ],
  "taxonomy": {
    "language": "python",
    "runtime": "python",
    "surface": "api"
  },
  "slots": {
    "database": {
      "options": [
        "database:sqlite",
        "database:postgres",
        "database:mongodb",
        "database:convex"
      ],
      "default": "database:sqlite"
    },
    "sdk": {
      "options": [
        "sdk:none",
        "sdk:coinbase-cdp",
        "sdk:solana-web3",
        "sdk:evm-wallet"
      ],
      "default": "sdk:none"
    },
    "auth": {
      "options": [
        "auth:none",
        "auth:better-auth",
        "auth:clerk",
        "auth:supabase-auth"
      ],
      "default": "auth:none"
    },
    "payments": {
      "options": [
        "payments:none",
        "payments:stripe",
        "payments:coinbase-commerce"
      ],
      "default": "payments:none"
    },
    "queue": {
      "options": [
        "queue:none",
        "queue:bullmq",
        "queue:trigger-dev"
      ],
      "default": "queue:none"
    }
  },
  "defaults": {
    "serviceName": "starter-foundry-python",
    "port": 8090,
    "databaseProvider": "sqlite"
  },
  "files": [
    {
      "source": "files/requirements.txt",
      "target": "requirements.txt"
    }
  ],
  "validationChecks": [
    {
      "type": "file-exists",
      "path": "app.py"
    },
    {
      "type": "python-compile",
      "path": "app.py"
    },
    {
      "type": "http-start",
      "command": [
        "python3",
        "app.py"
      ],
      "path": "/health",
      "expect": "\"{{serviceName}}\""
    }
  ],
  "contextHints": {
    "commands": [
      "python3 app.py"
    ],
    "entrypoints": [
      "app.py"
    ],
    "preview": {
      "path": "/health"
    },
    "extensionPoints": [
      "database-config.json",
      "auth-config.json",
      "payments-config.json",
      "queue-config.json",
      "sdk-config.json"
    ]
  },
  "keywords": [
    "python",
    "fastapi",
    "flask",
    "django",
    "api in python"
  ],
  "scoring": {
    "boost": {
      "python": 2
    }
  },
  "tieredKeywords": {
    "tier1": [
      "python",
      "fastapi",
      "flask",
      "django",
      "api in python"
    ],
    "archetypes": [
      "inference api",
      "model serving",
      "ml api",
      "prediction api",
      "hugging face",
      "huggingface",
      "model hub",
      "model registry",
      "whisper",
      "speech recognition",
      "transcription",
      "audio transcription"
    ]
  }
}
