{
  "id": "coinbase-cdp",
  "slot": "sdk",
  "description": "Coinbase CDP-ready dependency profile.",
  "appliesTo": [
    "agent-service-py",
    "agent-service-rust",
    "agent-service-ts",
    "angular-ts",
    "api-service",
    "browser-extension-ts",
    "cloudflare-worker-ts",
    "dspy-pipeline-py",
    "electron-desktop-ts",
    "electron-native-os",
    "evm-infra-ts",
    "expo-react-native-ts",
    "expo-rn-rich",
    "flutter-app",
    "fullstack-ts",
    "go-api",
    "kotlin-multiplatform",
    "mcp-server-ts",
    "nextjs-ts",
    "python-api",
    "react-vite-ts",
    "realtime-audio-ts",
    "remix-ts",
    "rust-service",
    "sveltekit-ts",
    "tauri-desktop",
    "tauri-menubar",
    "tauri-tray",
    "vue-ts",
    "x402-service",
    "zk-prover-service"
  ],
  "defaults": {
    "sdkProvider": "coinbase-cdp"
  },
  "files": [
    {
      "source": "files/sdk-config.json",
      "target": "sdk-config.json"
    }
  ],
  "buildHints": {
    "components": [
      "OnchainKitProvider",
      "Identity",
      "WalletDefault",
      "TransactionDefault",
      "SwapDefault"
    ],
    "integrations": [
      "Coinbase OnchainKit",
      "CDP Server Wallet",
      "Base chain"
    ],
    "architectureNotes": [
      "Wrap root layout with <OnchainKitProvider chain={base} apiKey={...}>.",
      "Use <WalletDefault /> for instant connect button (Smart Wallet enabled).",
      "Use <TransactionDefault /> for one-click transactions.",
      "<Identity> resolves ENS/Basenames and shows avatar + name.",
      "Server-side: use CDP SDK for wallet creation, signing, and faucet."
    ]
  }
}
