{
  "id": "agent-runtime-math-tutor-ts",
  "description": "Voice-first math tutor agent bundle — calculus, algebra, and general math tutoring with step-by-step explanations and adaptive problem generation. Explicitly NOT a substitute for a certified math teacher or exam proctor. Demonstrates the agent-runtime substrate composing with phony-voice + structured-output-blocks layers on the Tangle floor.",
  "tags": [
    "agent-runtime",
    "math-tutor",
    "calculus-tutor",
    "voice-first",
    "cloudflare-worker"
  ],
  "taxonomy": {
    "language": "markdown",
    "runtime": "cloudflare-worker",
    "surface": "agent-runtime"
  },
  "includes": [
    "agent-base:tangle",
    "agent-base:secure",
    "agent-output:blocks"
  ],
  "defaults": {
    "projectType": "agent-runtime-math-tutor",
    "agentName": "math-tutor",
    "publicVars": [
      "AGENT_NAME"
    ],
    "routes": [
      {
        "path": "/api/chat",
        "auth": "bearer",
        "callsTools": [
          "problem-generator",
          "step-by-step",
          "concept-explainer"
        ]
      },
      {
        "path": "/api/health",
        "auth": "none",
        "callsTools": []
      }
    ],
    "declaredCapabilities": [
      "problem-generation",
      "step-by-step-solution",
      "concept-explanation"
    ],
    "runtime": {
      "sandbox": "tangle",
      "noNewPrivileges": true,
      "capDrop": "ALL"
    },
    "stakes": "low",
    "advisoryOnly": false,
    "outboundDomains": [
      "api.tangle.tools"
    ],
    "secrets": [
      "TANGLE_ROUTER_KEY"
    ]
  },
  "files": [
    {
      "source": "files/agent.json",
      "target": "agent.json"
    },
    {
      "source": "files/AGENTS.md",
      "target": "AGENTS.md"
    },
    {
      "source": "files/methodology/index.json",
      "target": "methodology/index.json"
    },
    {
      "source": "files/methodology/problem-generation.md",
      "target": "methodology/problem-generation.md"
    },
    {
      "source": "files/methodology/step-by-step-solution.md",
      "target": "methodology/step-by-step-solution.md"
    },
    {
      "source": "files/methodology/concept-explanation.md",
      "target": "methodology/concept-explanation.md"
    },
    {
      "source": "files/README.md",
      "target": "README.md"
    },
    {
      "source": "files/TOOLS.md",
      "target": "TOOLS.md"
    }
  ],
  "contextHints": {
    "commands": [],
    "entrypoints": [
      "AGENTS.md"
    ],
    "extensionPoints": [
      "templates/",
      "src/lib/tools/"
    ]
  },
  "tieredKeywords": {
    "tier1": [
      "math-tutor-agent",
      "math tutor agent",
      "calculus-tutor",
      "calculus tutor",
      "algebra-tutor",
      "algebra tutor",
      "math-tutor",
      "math tutor"
    ],
    "tier2": [
      "step-by-step",
      "problem-solving",
      "problem solving",
      "derivatives",
      "integrals",
      "limits",
      "functions",
      "equations"
    ],
    "tier3": [],
    "archetypes": [
      "agent-in-sandbox",
      "tutor-agent"
    ]
  }
}
