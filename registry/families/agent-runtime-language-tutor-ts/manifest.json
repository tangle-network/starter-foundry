{
  "id": "agent-runtime-language-tutor-ts",
  "description": "Voice-first language tutor agent bundle — Krashen-aligned comprehensible input + spaced-repetition methodology, CEFR-calibrated to the learner's current level. Default target language is Spanish; configurable via `defaults.targetLanguage` (es / ja / fr / zh / etc.). Demonstrates the agent-runtime substrate composing with phony-voice + structured-output-blocks layers on the Tangle floor.",
  "tags": [
    "agent-runtime",
    "language-tutor",
    "education",
    "voice-first",
    "cloudflare-worker"
  ],
  "taxonomy": {
    "language": "markdown",
    "runtime": "cloudflare-worker",
    "surface": "agent-runtime"
  },
  "includes": [
    "agent-base:tangle",
    "agent-tools:phony-voice",
    "agent-output:blocks"
  ],
  "defaults": {
    "projectType": "agent-runtime-language-tutor",
    "agentName": "language-tutor",
    "targetLanguage": "es",
    "allowedDomains": ["api.tangle.tools"],
    "allowedEnv": ["TANGLE_ROUTER_KEY", "PHONY_API_KEY"],
    "publicVars": ["AGENT_NAME", "TARGET_LANGUAGE"],
    "routes": [
      { "path": "/api/chat", "auth": "bearer", "callsTools": ["voice-stt", "voice-tts", "daily-conversation", "vocab-drill", "shadowing"] },
      { "path": "/api/health", "auth": "none", "callsTools": [] }
    ],
    "declaredCapabilities": ["daily-conversation-prompt", "vocabulary-drill", "shadowing-protocol"],
    "runtime": {
      "sandbox": "tangle",
      "noNewPrivileges": true,
      "capDrop": "ALL"
    }
  },
  "files": [
    { "source": "files/system-prompt.md", "target": "system-prompt.md" },
    { "source": "files/templates/index.json", "target": "templates/index.json" },
    { "source": "files/templates/daily-conversation-prompt.md", "target": "templates/daily-conversation-prompt.md" },
    { "source": "files/templates/vocabulary-drill.md", "target": "templates/vocabulary-drill.md" },
    { "source": "files/templates/shadowing-protocol.md", "target": "templates/shadowing-protocol.md" },
    { "source": "files/wrangler.toml", "target": "wrangler.toml" },
    { "source": "files/README.md", "target": "README.md" }
  ],
  "validationChecks": [
    { "type": "file-exists", "path": "system-prompt.md" },
    { "type": "file-exists", "path": "templates/index.json" },
    { "type": "file-exists", "path": "wrangler.toml" },
    { "type": "prompt-frontmatter-valid", "path": "system-prompt.md" },
    { "type": "template-index-valid", "path": "templates/index.json" },
    { "type": "cron-syntax-valid", "path": "wrangler.toml" }
  ],
  "contextHints": {
    "commands": [],
    "entrypoints": ["system-prompt.md"],
    "extensionPoints": ["templates/", "src/lib/tools/", "defaults.targetLanguage"]
  },
  "keywords": [
    "language-tutor",
    "spanish-tutor",
    "japanese-tutor",
    "comprehensible-input",
    "spaced-repetition",
    "shadowing",
    "voice"
  ],
  "tieredKeywords": {
    "tier1": [
      "language-tutor",
      "language tutor",
      "language-coach-agent",
      "language coach agent",
      "spanish-tutor",
      "spanish tutor",
      "japanese-tutor",
      "japanese tutor",
      "french-tutor",
      "french tutor",
      "mandarin-tutor",
      "mandarin tutor"
    ],
    "tier2": [
      "spaced-repetition",
      "spaced repetition",
      "comprehensible-input",
      "comprehensible input",
      "shadowing",
      "tpr",
      "anki",
      "cefr",
      "krashen",
      "second language acquisition"
    ],
    "tier3": ["language", "tutor", "lesson", "vocabulary"],
    "archetypes": ["agent-in-sandbox", "tutor-agent", "voice-first"]
  }
}
