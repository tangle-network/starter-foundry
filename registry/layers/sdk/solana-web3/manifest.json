{
  "id": "solana-web3",
  "slot": "sdk",
  "description": "Solana web3-ready dependency profile.",
  "appliesTo": [
    "api-service",
    "cloudflare-worker-ts",
    "python-api",
    "rust-service",
    "react-vite-ts",
    "nextjs-ts",
    "fullstack-ts",
    "go-api",
    "expo-react-native-ts",
    "browser-extension-ts",
    "electron-desktop-ts",
    "tauri-desktop",
    "mcp-server-ts",
    "dspy-pipeline-py",
    "agent-service-ts",
    "agent-service-py",
    "agent-service-rust",
    "x402-service",
    "zk-prover-service",
    "evm-infra-ts",
    "angular-ts",
    "remix-ts",
    "sveltekit-ts",
    "vue-ts"
  ],
  "defaults": {
    "sdkProvider": "solana-web3"
  },
  "files": [
    {
      "source": "files/sdk-config.json",
      "target": "sdk-config.json"
    }
  ],
  "buildHints": {
    "components": [
      "WalletMultiButton",
      "ConnectionProvider",
      "WalletProvider"
    ],
    "integrations": [
      "Solana Wallet Adapter",
      "Phantom",
      "Solflare",
      "Anchor"
    ],
    "architectureNotes": [
      "Create lib/solana.ts with Connection and wallet adapter config.",
      "Wrap root: ConnectionProvider → WalletProvider → WalletModalProvider.",
      "Use useWallet() for connect/disconnect, useConnection() for RPC calls.",
      "For program interaction: new Program(idl, programId, provider)."
    ]
  }
}
