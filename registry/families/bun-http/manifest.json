{
  "id": "bun-http",
  "description": "Bun HTTP API starter using Bun.serve() — zero-transpile TS, native Bun runtime, instant cold start.",
  "tags": [
    "bun",
    "api",
    "backend",
    "typescript"
  ],
  "taxonomy": {
    "language": "typescript",
    "runtime": "bun",
    "surface": "api"
  },
  "slots": {
    "database": {
      "options": [
        "database:sqlite",
        "database:postgres",
        "database:mongodb",
        "database:convex"
      ],
      "default": "database:sqlite"
    },
    "auth": {
      "options": [
        "auth:none",
        "auth:better-auth",
        "auth:clerk"
      ],
      "default": "auth:none"
    },
    "payments": {
      "options": [
        "payments:none",
        "payments:stripe"
      ],
      "default": "payments:none"
    },
    "queue": {
      "options": [
        "queue:none",
        "queue:bullmq",
        "queue:trigger-dev"
      ],
      "default": "queue:none"
    }
  },
  "defaults": {
    "projectType": "api",
    "serviceName": "starter-foundry-bun",
    "port": 8095,
    "databaseProvider": "sqlite"
  },
  "files": [
    {
      "source": "files/package.json",
      "target": "package.json"
    },
    {
      "source": "files/tsconfig.json",
      "target": "tsconfig.json"
    },
    {
      "source": "files/bunfig.toml",
      "target": "bunfig.toml"
    },
    {
      "source": "files/validate-bun.mjs",
      "target": "validate-bun.mjs"
    }
  ],
  "validationChecks": [
    {
      "type": "file-exists",
      "path": "src/server.ts"
    },
    {
      "type": "file-exists",
      "path": "package.json"
    },
    {
      "type": "command-success",
      "command": [
        "node",
        "validate-bun.mjs"
      ],
      "expect": "bun starter ok"
    }
  ],
  "contextHints": {
    "commands": [
      "bun install",
      "bun run dev",
      "bun test"
    ],
    "entrypoints": [
      "src/server.ts",
      "src/handlers.ts",
      "package.json"
    ],
    "preview": {
      "path": "/health"
    },
    "extensionPoints": [
      "database-config.json",
      "auth-config.json",
      "payments-config.json",
      "queue-config.json"
    ]
  },
  "keywords": [
    "bun",
    "bun.js",
    "bunjs",
    "bun runtime",
    "bun http",
    "bun.serve",
    "bun api"
  ],
  "scoring": {
    "boost": {
      "bun": 3
    }
  },
  "tieredKeywords": {
    "tier1": [
      "bun",
      "bun.serve",
      "bun runtime"
    ],
    "tier2": [
      "bun api",
      "bun http",
      "bun.js"
    ]
  }
}
