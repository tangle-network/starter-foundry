{
  "id": "agent-runtime-real-estate-ts",
  "description": "Real-estate advisor agent bundle \u2014 explicitly NOT a licensed real-estate broker. Drafts comparable-market-analysis worksheets, cap-rate / NOI / cash-on-cash math, and offer-strategy frameworks for the user's own decision-making. Jurisdiction-agnostic; all binding-decision support (offer drafting, escrow, title, tenant disputes, HOA interpretation, jurisdiction-specific tax/title) escalates to a licensed agent. Fair Housing Act compliant: analyzes property attributes only, never neighborhood social characteristics.",
  "tags": [
    "agent-runtime",
    "real-estate",
    "advisory",
    "cloudflare-worker"
  ],
  "taxonomy": {
    "language": "markdown",
    "runtime": "cloudflare-worker",
    "surface": "agent-runtime"
  },
  "includes": [
    "agent-base:tangle",
    "agent-base:secure",
    "agent-output:blocks",
    "agent-base:memory",
    "agent-base:scheduler",
    "agent-base:mcp-registry",
    "agent-channels:telegram",
    "agent-channels:discord",
    "agent-channels:slack",
    "agent-channels:whatsapp",
    "agent-channels:imessage",
    "agent-channels:gmail",
    "agent-channels:linear"
  ],
  "defaults": {
    "projectType": "agent-runtime-real-estate",
    "agentName": "real-estate-advisor",
    "publicVars": [
      "AGENT_NAME"
    ],
    "routes": [
      {
        "path": "/api/chat",
        "auth": "bearer",
        "callsTools": [
          "comp-analysis",
          "cap-rate-worksheet",
          "offer-strategy",
          "escalation"
        ]
      },
      {
        "path": "/api/health",
        "auth": "none",
        "callsTools": []
      }
    ],
    "declaredCapabilities": [
      "comp-analysis",
      "cap-rate-worksheet",
      "offer-strategy"
    ],
    "disclaimerRequired": true,
    "runtime": {
      "sandbox": "tangle",
      "noNewPrivileges": true,
      "capDrop": "ALL"
    },
    "outboundDomains": [
      "api.tangle.tools",
      "irs.gov",
      "hud.gov"
    ],
    "secrets": [
      "TANGLE_ROUTER_KEY"
    ]
  },
  "files": [
    {
      "source": "files/agent.json",
      "target": "agent.json"
    },
    {
      "source": "files/AGENTS.md",
      "target": "AGENTS.md"
    },
    {
      "source": "files/methodology/index.json",
      "target": "methodology/index.json"
    },
    {
      "source": "files/methodology/comp-analysis.md",
      "target": "methodology/comp-analysis.md"
    },
    {
      "source": "files/methodology/cap-rate-worksheet.md",
      "target": "methodology/cap-rate-worksheet.md"
    },
    {
      "source": "files/methodology/offer-strategy.md",
      "target": "methodology/offer-strategy.md"
    },
    {
      "source": "files/README.md",
      "target": "README.md"
    },
    {
      "source": "files/TOOLS.md",
      "target": "TOOLS.md"
    }
  ],
  "validationChecks": [
    {
      "type": "file-exists",
      "path": "AGENTS.md"
    },
    {
      "type": "file-exists",
      "path": "methodology/index.json"
    },
    {
      "type": "agents-md-valid",
      "path": "AGENTS.md"
    },
    {
      "type": "methodology-index-valid",
      "path": "methodology/index.json"
    },
    {
      "type": "file-exists",
      "path": "TOOLS.md"
    }
  ],
  "contextHints": {
    "commands": [],
    "entrypoints": [
      "AGENTS.md"
    ],
    "extensionPoints": [
      "templates/",
      "src/lib/tools/"
    ]
  },
  "keywords": [
    "real-estate",
    "real estate",
    "property",
    "comps",
    "cap-rate",
    "1031-exchange"
  ],
  "tieredKeywords": {
    "tier1": [
      "real-estate-agent",
      "real estate agent",
      "property-advisor",
      "property advisor",
      "real-estate-bot",
      "real estate bot"
    ],
    "tier2": [
