{
  "id": "agent-runtime-research",
  "description": "Greenfield agent-runtime bundle: research-assistant agent that reads templates from its own filesystem, runs daily cron, and emits structured proposal blocks. Demonstrates the full agent-runtime substrate end-to-end with no external extraction source.",
  "tags": [
    "agent-runtime",
    "research",
    "cloudflare-worker",
    "greenfield"
  ],
  "taxonomy": {
    "language": "markdown",
    "runtime": "cloudflare-worker",
    "surface": "agent-runtime"
  },
  "slots": {
    "agent-base": {
      "options": [
        "agent-base:tangle"
      ],
      "default": "agent-base:tangle"
    },
    "agent-tools": {
      "options": [
        "agent-tools:research-corpus",
        "agent-tools:phony-voice",
        "agent-tools:clinical-screeners"
      ],
      "default": "agent-tools:research-corpus"
    },
    "agent-output": {
      "options": [
        "agent-output:blocks"
      ],
      "default": "agent-output:blocks"
    }
  },
  "defaults": {
    "projectType": "agent-runtime-research",
    "agentName": "research-assistant",
    "publicVars": [
      "AGENT_NAME"
    ],
    "routes": [
      {
        "path": "/api/chat",
        "auth": "bearer",
        "callsTools": [
          "search",
          "summarize"
        ]
      },
      {
        "path": "/api/health",
        "auth": "none",
        "callsTools": []
      }
    ],
    "declaredCapabilities": [
      "literature-survey",
      "proposal-drafting"
    ],
    "runtime": {
      "sandbox": "tangle",
      "noNewPrivileges": true,
      "capDrop": "ALL"
    },
    "schedule": [
      {
        "id": "scheduled-1",
        "cron": "17 7 * * *",
        "capability": "literature-survey"
      },
      {
        "id": "scheduled-2",
        "cron": "17 7 * * 1",
        "capability": "proposal-drafting"
      }
    ],
    "outboundDomains": [
      "api.tangle.tools"
    ],
    "secrets": []
  },
  "files": [
    {
      "source": "files/agent.json",
      "target": "agent.json"
    },
    {
      "source": "files/AGENTS.md",
      "target": "AGENTS.md"
    },
    {
      "source": "files/methodology/index.json",
      "target": "methodology/index.json"
    },
    {
      "source": "files/methodology/literature-survey.md",
      "target": "methodology/literature-survey.md"
    },
    {
      "source": "files/methodology/proposal-drafting.md",
      "target": "methodology/proposal-drafting.md"
    },
    {
      "source": "files/README.md",
      "target": "README.md"
    },
    {
      "source": "files/TOOLS.md",
      "target": "TOOLS.md"
    }
  ],
  "validationChecks": [
    {
      "type": "file-exists",
      "path": "AGENTS.md"
    },
    {
      "type": "file-exists",
      "path": "methodology/index.json"
    },
    {
      "type": "agents-md-valid",
      "path": "AGENTS.md"
    },
    {
      "type": "methodology-index-valid",
      "path": "methodology/index.json"
    },
    {
      "type": "schedule-valid",
      "path": "manifest.json"
    },
    {
      "type": "file-exists",
      "path": "TOOLS.md"
    }
  ],
  "contextHints": {
    "commands": [],
    "entrypoints": [
      "AGENTS.md"
    ],
    "extensionPoints": [
      "templates/",
      "skills/"
    ]
  },
  "keywords": [
    "research",
    "literature-survey",
    "proposal",
    "agent",
    "sandbox"
  ],
  "tieredKeywords": {
    "tier1": [
      "research-agent",
      "literature-survey",
      "general-research-agent",
      "general research agent"
    ],
    "tier2": [
      "research",
      "proposal",
      "draft"
    ],
    "tier3": [
      "agent"
    ],
    "archetypes": [
      "agent-in-sandbox"
    ]
  },
  "includes": [
    "agent-base:tangle",
    "agent-base:secure"
  ]
}
