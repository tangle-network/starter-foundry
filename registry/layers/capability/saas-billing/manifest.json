{
  "id": "saas-billing",
  "description": "Adds SaaS billing with plan tiers, usage metering, and subscription webhook handling.",
  "appliesTo": [
    "nextjs-ts",
    "fullstack-ts",
    "api-service"
  ],
  "defaults": {
    "billingProvider": "stripe"
  },
  "files": [
    {
      "source": "files/billing-config.json",
      "target": "billing-config.json"
    },
    {
      "source": "files/billing-api.ts",
      "target": "lib/billing-api.ts"
    },
    {
      "source": "files/billing-guard.ts",
      "target": "lib/billing-guard.ts"
    },
    {
      "source": "files/billing-ui.tsx",
      "target": "components/pricing-table.tsx"
    }
  ],
  "contextHints": {
    "extensionPoints": [
      "billing-config.json",
      "lib/billing-api.ts",
      "lib/billing-guard.ts"
    ]
  },
  "keywords": [
    "saas billing",
    "subscription billing",
    "pricing plans",
    "usage metering",
    "plan tiers",
    "freemium",
    "saas pricing"
  ],
  "buildHints": {
    "pages": [
      "/pricing",
      "/settings/billing",
      "/checkout"
    ],
    "apiRoutes": [
      "/api/webhooks/stripe",
      "/api/billing/portal"
    ],
    "components": [
      "PricingCard",
      "BillingPortalButton",
      "UsageMeter",
      "PlanBadge"
    ],
    "dataModels": [
      "Subscription",
      "Plan",
      "UsageRecord"
    ],
    "integrations": [
      "Stripe Checkout",
      "Stripe Customer Portal",
      "Stripe Webhooks"
    ]
  },
  "packageDeps": {
    "dependencies": {
      "stripe": "^17.0.0"
    }
  }
}
