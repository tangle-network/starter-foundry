{
  "name": "{{packageName}}",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --import tsx src/server.ts",
    "sfu:up": "docker compose up -d",
    "sfu:down": "docker compose down",
    "sfu:logs": "docker compose logs -f livekit",
    "validate": "node validate-livekit.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "livekit-server-sdk": "^2.9.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "vite": "^6.4.2"
  },
  "pnpm": {
    "overrides": {
      "vite": "^6.4.2"
    }
  }
}
