{
  "id": "agent-github",
  "description": "Adds GitHub webhook handling for PR review, issue triage, and commit analysis.",
  "appliesTo": [
    "agent-service-ts",
    "agent-service-py",
    "agent-service-rust"
  ],
  "defaults": {
    "githubActions": "review,label,comment"
  },
  "files": [
    {
      "source": "files/github-config.json",
      "target": "github-config.json"
    },
    {
      "source": "files/github-handler.ts",
      "target": "github-handler.ts"
    }
  ],
  "contextHints": {
    "extensionPoints": [
      "github-config.json",
      "github-handler.ts"
    ]
  },
  "keywords": [
    "github bot",
    "github integration",
    "pr review agent",
    "issue triage",
    "github agent",
    "github webhook agent"
  ]
}
