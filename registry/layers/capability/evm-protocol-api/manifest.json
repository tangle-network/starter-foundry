{
  "id": "evm-protocol-api",
  "description": "Adds protocol-service seams for EVM relayers, indexers, paymasters, and analytics APIs.",
  "appliesTo": [
    "api-service",
    "evm-infra-ts"
  ],
  "defaults": {
    "protocolRole": "indexer",
    "protocolScope": "evm"
  },
  "files": [
    {
      "source": "files/protocol-config.json",
      "target": "protocol-config.json"
    },
    {
      "source": "files/hooks.mjs",
      "target": "hooks.mjs"
    }
  ],
  "contextHints": {
    "extensionPoints": [
      "protocol-config.json",
      "hooks.mjs"
    ]
  },
  "keywords": [
    "indexer",
    "subgraph",
    "protocol api",
    "evm indexer",
    "event indexer",
    "relayer api"
  ]
}
