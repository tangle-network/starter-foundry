  "appliesTo": [
    "forge-contracts",
    "hardhat-contracts",
    "api-service",
    "evm-infra-ts"
  ],
  "defaults": {
    "bridgeModel": "lock-and-mint",
    "messagingProtocol": "custom"
  },
  "files": [
    {
      "source": "files/bridge-config.json",
      "target": "bridge-config.json"
    }
  ],
  "contextHints": {
