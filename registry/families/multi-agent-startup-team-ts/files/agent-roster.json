{
  "$schema": "https://starter-foundry.tangle.tools/schemas/agent-roster.schema.json",
  "version": "0.1.0",
  "team": "startup-leadership-team",
  "defaultRespondent": "ceo",
  "coordinationProtocol": "coordination-protocol.md",
  "roles": [
    {
      "id": "ceo",
      "name": "CEO",
      "title": "Chief Executive — strategy, OKRs, weekly review, decision journal",
      "systemPromptPath": "roles/ceo/system-prompt.md",
      "methodologyDir": "roles/ceo/methodology/",
      "primaryFor": [
        "weekly-review",
        "okr-design",
        "decision-journal",
        "board-prep",
        "strategy",
        "operating-cadence"
      ],
      "advisoryOnly": true
    },
    {
      "id": "cto",
      "name": "CTO",
      "title": "Chief Technology — engineering 1:1s, sprint pace, tech-debt triage, architecture decisions",
      "systemPromptPath": "roles/cto/system-prompt.md",
      "methodologyDir": "roles/cto/methodology/",
      "primaryFor": [
        "one-on-one-cadence",
        "tech-debt-triage",
        "architecture-decision",
        "sprint-planning",
        "incident-postmortem"
      ],
      "advisoryOnly": true
    },
    {
      "id": "cmo",
      "name": "CMO",
      "title": "Chief Marketing — positioning, ICP, channel experiments, growth scoreboards",
      "systemPromptPath": "roles/cmo/system-prompt.md",
      "methodologyDir": "roles/cmo/methodology/",
      "primaryFor": [
        "positioning-canvas",
        "channel-experiment-design",
        "icp-research",
        "growth-scoreboard"
      ],
      "advisoryOnly": true
    },
    {
      "id": "hr",
      "name": "HR / Recruiter",
      "title": "Talent + recruiting — JD drafting, structured interview design, comp-band hygiene",
      "systemPromptPath": "roles/hr/system-prompt.md",
      "methodologyDir": "roles/hr/methodology/",
      "primaryFor": [
        "recruiting-loop-design",
        "interview-rubric",
        "jd-drafting",
        "comp-band-hygiene"
      ],
      "advisoryOnly": true,
      "biasSafeguards": {
        "protectedClassRefusal": true,
        "structuredInterviewDefault": true
      }
    },
    {
      "id": "cfo-advisor",
      "name": "CFO Advisor",
      "title": "Finance advisor — burn / runway model, unit economics, fundraise prep, board financials",
      "systemPromptPath": "roles/cfo-advisor/system-prompt.md",
      "methodologyDir": "roles/cfo-advisor/methodology/",
      "primaryFor": [
        "burn-runway-model",
        "fundraise-prep",
        "unit-economics",
        "board-financials"
      ],
      "advisoryOnly": true,
      "notALicensedAdvisor": true
    }
  ],
  "handoffBlock": {
    "marker": ":::handoff",
    "requiredFields": ["to", "reason", "context-summary"],
    "ackMarker": ":::handoff-ack"
  },
  "escalationBlock": {
    "marker": ":::escalation",
    "use": "outside-professional-only"
  },
  "jointDecisionCadence": [
    { "artifact": "quarterly-okrs", "cron": "quarter-boundary", "roles": ["ceo", "cto", "cmo", "cfo-advisor", "hr"] },
    { "artifact": "weekly-review", "cron": "0 14 * * 1", "roles": ["ceo", "cfo-advisor", "cto", "cmo"] },
    { "artifact": "monthly-board-update", "cron": "first-monday-after-month-close", "roles": ["ceo", "cfo-advisor", "cto", "cmo", "hr"] },
    { "artifact": "fundraise-prep", "cron": "ad-hoc", "roles": ["cfo-advisor", "ceo", "cmo"] },
    { "artifact": "major-incident-postmortem", "cron": "ad-hoc-within-48h", "roles": ["cto", "ceo", "cmo"] }
  ]
}
