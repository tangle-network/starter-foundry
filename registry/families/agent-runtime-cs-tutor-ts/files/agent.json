{
  "name": "cs-tutor",
  "description": "CS tutoring agent bundle — teaches programming fundamentals, data structures, algorithms, and debugging. Composes the agent-runtime substrate with the blocks output layer on the Tangle floor. Advisory only — never replaces a human instructor or academic advisor.",
  "version": "0.1.0",
  "tags": [
    "agent-runtime",
    "cs-tutor",
    "programming-tutor",
    "education",
    "cloudflare-worker"
  ],
  "prompt": {
    "systemPromptFile": "AGENTS.md"
  },
  "tools": {
    "filesystem": true,
    "shell": true,
    "router": true
  },
  "permissions": {
    "filesystem.write": "ask",
    "shell.exec": "ask",
    "network": "ask"
  },
  "resources": {
    "files": [
      {
        "source": "methodology/",
        "target": "/workspace/methodology/"
      },
      {
        "source": "README.md",
        "target": "/workspace/README.md"
      },
      {
        "source": "TOOLS.md",
        "target": "/workspace/TOOLS.md"
      }
    ]
  }
}
