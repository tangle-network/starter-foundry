{
  "id": "memory",
  "slot": "agent-base",
  "description": "In-process conversation memory layer. Per-thread markdown files at /home/agent/conversations/<thread-id>.md plus a zero-dep filesystem-grep search. Future: vector-store sibling layer.",
  "appliesTo": [],
  "provides": ["memory:conversations", "memory:grep-search"],
  "requires": [],
  "defaults": {
    "memoryEnabled": true,
    "conversationsDir": "/home/agent/conversations"
  },
  "files": [
    { "source": "files/lib/memory/index.ts", "target": "lib/memory/index.ts" },
    { "source": "files/lib/memory/types.ts", "target": "lib/memory/types.ts" },
    { "source": "files/lib/memory/grep.ts", "target": "lib/memory/grep.ts" }
  ],
  "validationChecks": [
    { "type": "file-exists", "path": "lib/memory/index.ts" },
    { "type": "file-exists", "path": "lib/memory/types.ts" },
    { "type": "file-exists", "path": "lib/memory/grep.ts" }
  ],
  "contextHints": {
    "extensionPoints": ["lib/memory/"],
    "commands": []
  }
}
