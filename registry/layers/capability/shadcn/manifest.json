{
  "id": "shadcn",
  "description": "Adds shadcn/ui component system with cn() utility, path aliases, and component registry config.",
  "appliesTo": [
    "react-vite-ts",
    "nextjs-ts",
    "fullstack-ts",
    "remix-ts",
    "sveltekit-ts",
    "vue-ts",
    "electron-desktop-ts",
    "tauri-desktop"
  ],
  "files": [
    {
      "source": "files/shadcn-config.json",
      "target": "shadcn-config.json"
    }
  ],
  "contextHints": {
    "extensionPoints": [
      "shadcn-config.json",
      "components.json",
      "src/lib/utils.ts",
      "src/components/ui/"
    ]
  },
  "keywords": [
    "shadcn",
    "shadcn/ui",
    "shadcn-ui",
    "radix ui",
    "radix primitives",
    "cn utility",
    "component library"
  ],
  "capabilityRequires": [
    "tailwind"
  ],
  "buildHints": {
    "architectureNotes": [
      "Generate components.json at project root",
      "Create src/lib/utils.ts with cn() utility",
      "Set up tsconfig paths: @/* -> ./src/*",
      "Install base components: npx shadcn@latest add button card input"
    ]
  }
}
