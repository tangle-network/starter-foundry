  "contextHints": {
    "extensionPoints": [
      "shadcn-config.json",
      "src/lib/utils.ts",
      "src/components/ui/"
    ]
  },
  "keywords": [
    "shadcn",
    "shadcn/ui",
    "shadcn-ui",
    "radix ui",
    "radix primitives",
    "cn utility",
    "component library",
    "professional",
    "production-ready",
    "design system"
  ],
  "capabilityRequires": [
    "tailwind"
  ],
  "defaults": {
    "presetCode": "aIkeymG",
    "presetOptions": {
      "neutral": "aIkeymG",
      "vibrant": "b2D0wqNxT",
      "minimal": "aFk3nPQ",
      "dark": "cR8mLvW",
      "playful": "dN5pKjX"
    }
  },
  "buildHints": {
    "architectureNotes": [
      "shadcn/ui components are pre-installed in src/components/ui/. Import directly: import { Button } from '@/components/ui/button'",
      "Add more components via: npx shadcn@latest add dialog sheet dropdown-menu",
      "The cn() utility in src/lib/utils.ts merges Tailwind classes. Use it in all custom components.",
      "Configure tsconfig.json paths: { '@/*': ['./src/*'] }",
      "Alternative to static component files: pnpm dlx shadcn@latest init --preset {{presetCode}}"
    ]
  },
  "packageDeps": {
    "dependencies": {
      "lucide-react": "^0.468.0",
      "clsx": "^2.1.1",
      "class-variance-authority": "^0.7.1",
      "tailwind-merge": "^2.6.0",
      "@radix-ui/react-slot": "^1.1.0",
      "@radix-ui/react-dialog": "^1.1.0",
      "@radix-ui/react-dropdown-menu": "^2.1.0"
    }
  }
}
