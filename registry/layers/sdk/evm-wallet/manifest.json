{
  "id": "evm-wallet",
  "slot": "sdk",
  "description": "Generic EVM wallet and RPC client profile for viem, ethers, and WalletConnect flows.",
  "appliesTo": [
    "api-service",
    "cloudflare-worker-ts",
    "python-api",
    "rust-service",
    "react-vite-ts",
    "nextjs-ts",
    "fullstack-ts",
    "go-api",
    "expo-react-native-ts",
    "browser-extension-ts",
    "electron-desktop-ts",
    "tauri-desktop",
    "mcp-server-ts",
    "dspy-pipeline-py",
    "agent-service-ts",
    "agent-service-py",
    "agent-service-rust",
    "x402-service",
    "zk-prover-service",
    "evm-infra-ts",
    "angular-ts",
    "remix-ts",
    "sveltekit-ts",
    "vue-ts"
  ],
  "defaults": {
    "sdkProvider": "evm-wallet"
  },
  "files": [
    {
      "source": "files/sdk-config.json",
      "target": "sdk-config.json"
    }
  ],
  "buildHints": {
    "components": [
      "WalletProvider",
      "ConnectButton",
      "AccountDisplay",
      "ChainSwitcher"
    ],
    "dataModels": [
      "ConnectedWallet",
      "Chain",
      "Transaction"
    ],
    "integrations": [
      "WalletConnect v2",
      "Coinbase Wallet SDK",
      "SIWE auth"
    ],
    "architectureNotes": [
      "Create lib/wagmi.ts with wagmi config (chains, transports, connectors).",
      "Wrap root layout: WagmiProvider → QueryClientProvider → RainbowKit/ConnectKit provider.",
      "Use useAccount(), useBalance(), useSendTransaction() hooks in components.",
      "For SIWE: generate nonce server-side, sign client-side, verify server-side."
    ]
  }
}
