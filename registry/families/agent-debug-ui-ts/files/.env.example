# Required — Tangle sandbox API key (operator-scoped)
VITE_TANGLE_SANDBOX_API_KEY=sk-tan-...

# Required — Tangle sandbox API base URL
VITE_TANGLE_SANDBOX_BASE_URL=https://api.tangle.tools

# Required — the sandbox ID to attach to (must already exist).
# Create one with: pnpm dlx @tangle-network/sandbox create
VITE_SANDBOX_ID=sbx_...

# Optional — override the default backend profile sent to streamPrompt().
# Leave unset to use the sandbox's resident default.
# VITE_BACKEND_PROFILE=named-profile
