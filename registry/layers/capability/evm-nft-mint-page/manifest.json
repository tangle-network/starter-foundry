{
  "id": "evm-nft-mint-page",
  "description": "EVM NFT mint page component — wallet connect + mint button + minted-count display + OpenSea link. Reads contract address from env.",
  "appliesTo": [
    "react-vite-ts",
    "nextjs-ts",
    "fullstack-ts"
  ],
  "defaults": {
    "contractAddress": "0x...",
    "walletProvider": "MetaMask",
    "openSeaApiKey": "YOUR_API_KEY"
  },
  "files": [
    {
      "source": "files/src/mint-page-config.json",
      "target": "src/mint-page-config.json"
    },
    {
      "source": "files/src/components/MintPage.tsx",
      "target": "src/components/MintPage.tsx"
    },
    {
      "source": "files/evm-nft-mint.md",
      "target": "evm-nft-mint.md"
    }
  ],
  "contextHints": {
    "extensionPoints": [
      "wallet connection customization",
      "mint button configuration",
      "OpenSea link modification",
      "contract address injection"
    ]
  },
  "capabilityRequires": [
    "wallet integration",
    "smart contract deployment",
    "OpenSea API access",
    "environment variable configuration"
  ],
  "keywords": [
    "EVM",
    "NFT",
    "minting",
    "wallet",
    "OpenSea",
    "blockchain",
    "React",
    "Vite",
    "Next.js",
    "TypeScript",
    "fullstack development"
  ],
  "tieredKeywords": {
    "tier1": [
      "EVM",
      "NFT",
      "minting",
      "wallet",
      "OpenSea"
    ],
    "tier2": [
      "blockchain",
      "React",
      "Vite",
      "Next.js",
      "TypeScript",
      "fullstack development"
    ]
  },
  "buildHints": {
    "whenToUse": "When building blockchain-based applications that require a user-friendly interface for minting NFTs, especially in scenarios where users need to connect their wallets and track minted counts."
  }
}
