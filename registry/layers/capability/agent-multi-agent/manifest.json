{
  "id": "agent-multi-agent",
  "description": "In-process sub-agent tool-routing for single agent-service starters — the main agent delegates to specialist sub-agents exposed as tools. For full graph-based swarm orchestration, use family:agent-swarm-ts instead.",
  "appliesTo": [
    "agent-service-ts",
    "agent-service-py",
    "agent-service-rust"
  ],
  "defaults": {
    "orchestrationStrategy": "supervisor",
    "maxAgentTurns": 10
  },
  "files": [
    {
      "source": "files/orchestration-config.json",
      "target": "orchestration-config.json"
    },
    {
      "source": "files/supervisor.ts",
      "target": "supervisor.ts"
    }
  ],
  "contextHints": {
    "extensionPoints": [
      "orchestration-config.json",
      "supervisor.ts"
    ]
  },
  "keywords": [
    "sub-agent tool",
    "sub-agent delegation",
    "parallel tool use",
    "agent-as-tool",
    "agent hierarchy",
    "nested agent",
    "tool-routing agent",
    "agent with sub-agents"
  ]
}
