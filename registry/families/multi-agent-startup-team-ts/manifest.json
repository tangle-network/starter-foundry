      },
      {
        "id": "scheduled-2",
        "cron": "0 15 * * 5",
        "capability": "burn-runway-model"
      }
    ],
    "outboundDomains": [
      "api.tangle.tools"
    ],
    "secrets": [
      "TANGLE_ROUTER_KEY"
    ],
