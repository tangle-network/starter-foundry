{
  "id": "better-auth",
  "slot": "auth",
  "description": "Better Auth with email/password, social login, and session management.",
  "appliesTo": [
    "react-vite-ts",
    "nextjs-ts",
    "fullstack-ts",
    "api-service",
    "cloudflare-worker-ts",
    "python-api",
    "rust-service",
    "go-api",
    "expo-react-native-ts",
    "browser-extension-ts",
    "electron-desktop-ts",
    "tauri-desktop",
    "mcp-server-ts",
    "dspy-pipeline-py",
    "agent-service-ts",
    "agent-service-py",
    "agent-service-rust",
    "x402-service",
    "zk-prover-service",
    "evm-infra-ts",
    "angular-ts",
    "remix-ts",
    "sveltekit-ts",
    "vue-ts"
  ],
  "defaults": {
    "authProvider": "better-auth"
  },
  "files": [
    {
      "source": "files/auth-config.json",
      "target": "auth-config.json"
    }
  ],
  "buildHints": {
    "pages": [
      "/sign-in",
      "/sign-up"
    ],
    "apiRoutes": [
      "/api/auth/[...all]"
    ],
    "components": [
      "SignInForm",
      "SignUpForm",
      "AuthProvider"
    ],
    "integrations": [
      "Better Auth",
      "Database adapter (Drizzle/Prisma)"
    ],
    "architectureNotes": [
      "Create lib/auth.ts with betterAuth() configuration.",
      "Create lib/auth-client.ts with createAuthClient().",
      "Mount catch-all API route at /api/auth/* that calls auth.handler.",
      "Protect pages by checking session in server loaders or middleware."
    ]
  },
  "keywords": []
}
