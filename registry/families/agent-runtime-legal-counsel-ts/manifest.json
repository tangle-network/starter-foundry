{
  "id": "agent-runtime-legal-counsel-ts",
  "description": "In-house-counsel reference agent — drafts redlines, runs contract review checklists (NDA, MSA), flags asymmetric provisions and binding-decision moments. Explicitly NOT a lawyer; no attorney-client privilege; jurisdiction-agnostic. Demonstrates the agent-runtime substrate composing with structured-output blocks (:::artifact, :::escalation) on a regulated-legal role.",
  "tags": [
    "agent-runtime",
    "legal",
    "contract-review",
    "regulated-domain",
    "cloudflare-worker"
  ],
  "taxonomy": {
    "language": "markdown",
    "runtime": "cloudflare-worker",
    "surface": "agent-runtime"
  },
  "includes": [
    "agent-base:tangle",
    "agent-output:blocks"
  ],
  "defaults": {
    "projectType": "agent-runtime-legal-counsel",
    "agentName": "legal-counsel",
    "allowedDomains": ["api.tangle.tools", "law.cornell.edu"],
    "allowedEnv": ["TANGLE_ROUTER_KEY"],
    "publicVars": ["AGENT_NAME"],
    "routes": [
      { "path": "/api/chat", "auth": "bearer", "callsTools": ["redline", "checklist", "escalation"] },
      { "path": "/api/health", "auth": "none", "callsTools": [] }
    ],
    "declaredCapabilities": [
      "contract-redline",
      "nda-review",
      "msa-review",
      "escalation-protocol"
    ],
    "runtime": {
      "sandbox": "tangle",
      "noNewPrivileges": true,
      "capDrop": "ALL"
    },
    "notLawyer": true,
    "attorneyClientPrivilege": false
  },
  "files": [
    { "source": "files/system-prompt.md", "target": "system-prompt.md" },
    { "source": "files/templates/index.json", "target": "templates/index.json" },
    { "source": "files/templates/contract-redline-protocol.md", "target": "templates/contract-redline-protocol.md" },
    { "source": "files/templates/nda-checklist.md", "target": "templates/nda-checklist.md" },
    { "source": "files/templates/msa-checklist.md", "target": "templates/msa-checklist.md" },
    { "source": "files/wrangler.toml", "target": "wrangler.toml" },
    { "source": "files/README.md", "target": "README.md" }
  ],
  "validationChecks": [
    { "type": "file-exists", "path": "system-prompt.md" },
    { "type": "file-exists", "path": "templates/index.json" },
    { "type": "file-exists", "path": "wrangler.toml" },
    { "type": "prompt-frontmatter-valid", "path": "system-prompt.md" },
    { "type": "template-index-valid", "path": "templates/index.json" }
  ],
  "contextHints": {
    "commands": [],
    "entrypoints": ["system-prompt.md"],
    "extensionPoints": ["templates/", "src/lib/tools/"]
  },
  "keywords": [
    "legal",
    "contract",
    "nda",
    "msa",
    "redline",
    "in-house-counsel"
  ],
  "tieredKeywords": {
    "tier1": ["legal-counsel", "legal counsel", "contract-review-agent", "contract review agent", "in-house-counsel", "in house counsel", "contract redline"],
    "tier2": ["NDA", "MSA", "SLA", "indemnification", "limitation-of-liability", "IP-assignment", "contract review"],
    "tier3": ["redline", "legal"],
    "archetypes": ["agent-in-sandbox", "advisory-agent", "regulated-legal"]
  }
}
