{
  "id": "api-service",
  "description": "Minimal Node HTTP API starter with health endpoint.",
  "tags": [
    "api",
    "backend"
  ],
  "taxonomy": {
    "language": "javascript",
    "runtime": "node",
    "surface": "api"
  },
  "slots": {
    "database": {
      "options": [
        "database:sqlite",
        "database:postgres",
        "database:mongodb",
        "database:convex"
      ],
      "default": "database:sqlite"
    },
    "sdk": {
      "options": [
        "sdk:none",
        "sdk:coinbase-cdp",
        "sdk:solana-web3",
        "sdk:evm-wallet"
      ],
      "default": "sdk:none"
    },
    "auth": {
      "options": [
        "auth:none",
        "auth:better-auth",
        "auth:clerk",
        "auth:supabase-auth"
      ],
      "default": "auth:none"
    },
    "payments": {
      "options": [
        "payments:none",
        "payments:stripe",
        "payments:coinbase-commerce"
      ],
      "default": "payments:none"
    },
    "queue": {
      "options": [
        "queue:none",
        "queue:bullmq",
        "queue:trigger-dev"
      ],
      "default": "queue:none"
    }
  },
  "defaults": {
    "projectType": "api",
    "port": 4180,
    "serviceName": "Starter Foundry API"
  },
  "files": [
    {
      "source": "files/package.json",
      "target": "package.json"
    }
  ],
  "validationChecks": [
    {
      "type": "file-exists",
      "path": "server.mjs"
    },
    {
      "type": "node-syntax",
      "path": "server.mjs"
    },
    {
      "type": "http-start",
      "command": [
        "node",
        "server.mjs"
      ],
      "port": "{{port}}",
      "path": "/health",
      "expect": "\"ok\""
    }
  ],
  "contextHints": {
    "commands": [
      "npm run start"
    ],
    "entrypoints": [
      "server.mjs"
    ],
    "preview": {
      "port": "{{port}}",
      "path": "/health"
    },
    "extensionPoints": [
      "hooks.mjs",
      "partner-config.json",
      "auth-config.json",
      "payments-config.json",
      "queue-config.json",
      "sdk-config.json"
    ]
  },
  "keywords": [
    "api",
    "server",
    "endpoint",
    "backend",
    "service",
    "webhook"
  ]
}
