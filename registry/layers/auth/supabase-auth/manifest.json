{
  "id": "supabase-auth",
  "slot": "auth",
  "description": "Supabase Auth with email, social login, and row-level security.",
  "appliesTo": [
    "react-vite-ts",
    "nextjs-ts",
    "fullstack-ts",
    "api-service",
    "cloudflare-worker-ts",
    "python-api",
    "rust-service",
    "go-api",
    "expo-react-native-ts",
    "browser-extension-ts",
    "electron-desktop-ts",
    "tauri-desktop",
    "mcp-server-ts",
    "dspy-pipeline-py",
    "agent-service-ts",
    "agent-service-py",
    "agent-service-rust",
    "x402-service",
    "zk-prover-service",
    "evm-infra-ts",
    "angular-ts",
    "remix-ts",
    "sveltekit-ts",
    "vue-ts"
  ],
  "defaults": {
    "authProvider": "supabase-auth"
  },
  "files": [
    {
      "source": "files/auth-config.json",
      "target": "auth-config.json"
    }
  ],
  "buildHints": {
    "pages": [
      "/login",
      "/signup",
      "/auth/callback"
    ],
    "apiRoutes": [
      "/auth/callback"
    ],
    "components": [
      "LoginForm",
      "SignupForm",
      "AuthProvider"
    ],
    "integrations": [
      "Supabase Auth",
      "Supabase RLS policies"
    ],
    "architectureNotes": [
      "Create lib/supabase/server.ts with createServerClient() using cookies.",
      "Create lib/supabase/client.ts with createBrowserClient().",
      "Add middleware.ts that calls supabase.auth.getUser() to refresh session.",
      "Auth callback route handles OAuth redirects from Supabase.",
      "All database queries go through the authenticated Supabase client — RLS enforces permissions."
    ]
  },
  "keywords": []
}
