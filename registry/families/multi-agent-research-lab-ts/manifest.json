{
  "id": "multi-agent-research-lab-ts",
  "description": "Curated cross-domain research lab — Lab Director + physics/chemistry/biology researchers with hand-tuned interdisciplinary handoff protocols. Citation-grounded, no diagnosis, no peer-review replacement.",
  "tags": [
    "multi-agent",
    "research",
    "literature",
    "cross-domain",
    "cloudflare-worker"
  ],
  "taxonomy": {
    "language": "markdown",
    "runtime": "multi-agent",
    "surface": "multi-agent-team"
  },
  "includes": [
    "agent-base:tangle",
    "agent-base:secure",
    "agent-tools:research-corpus",
    "agent-output:blocks"
  ],
  "defaults": {
    "projectType": "multi-agent-research-lab",
    "agentName": "research-lab",
    "publicVars": [
      "AGENT_NAME"
    ],
    "routes": [
      {
        "path": "/api/chat",
        "auth": "bearer",
        "callsTools": [
          "research:paper-search",
          "research:citation-graph"
        ]
      },
      {
        "path": "/api/health",
        "auth": "none",
        "callsTools": []
      }
    ],
    "declaredCapabilities": [
      "research-question-formulation",
      "cross-domain-synthesis",
      "literature-triage",
      "arxiv-literature-search",
      "experimental-design",
      "reaction-mechanism-analysis",
      "crossref-literature-search",
      "protein-structure-analysis",
      "bioinformatics-survey"
    ],
    "runtime": {
      "sandbox": "tangle",
      "noNewPrivileges": true,
      "capDrop": "ALL"
    },
    "stakes": "low",
    "advisoryOnly": true,
    "outboundDomains": [
      "api.tangle.tools",
      "export.arxiv.org",
      "api.semanticscholar.org",
      "api.openalex.org",
      "api.crossref.org",
      "pubchem.ncbi.nlm.nih.gov",
      "www.chemspider.com",
      "rest.uniprot.org",
      "www.ebi.ac.uk",
      "eutils.ncbi.nlm.nih.gov"
    ],
    "secrets": [
      "TANGLE_ROUTER_KEY"
    ],
    "defaultRespondent": "lab-director"
  },
  "files": [
    {
      "source": "files/agent.json",
      "target": "agent.json"
    },
    {
      "source": "files/orchestrator-system-prompt.md",
      "target": "orchestrator-system-prompt.md"
    },
    {
      "source": "files/coordination-protocol.md",
      "target": "coordination-protocol.md"
    },
    {
      "source": "files/agent-roster.json",
      "target": "agent-roster.json"
    },
    {
      "source": "files/README.md",
      "target": "README.md"
    },
    {
      "source": "files/roles/lab-director/system-prompt.md",
      "target": "roles/lab-director/system-prompt.md"
    },
    {
      "source": "files/roles/lab-director/methodology/research-question-formulation.md",
      "target": "roles/lab-director/methodology/research-question-formulation.md"
    },
    {
      "source": "files/roles/lab-director/methodology/cross-domain-synthesis.md",
      "target": "roles/lab-director/methodology/cross-domain-synthesis.md"
    },
    {
      "source": "files/roles/lab-director/methodology/literature-triage.md",
      "target": "roles/lab-director/methodology/literature-triage.md"
    },
    {
      "source": "files/roles/physics-researcher/system-prompt.md",
      "target": "roles/physics-researcher/system-prompt.md"
    },
    {
      "source": "files/roles/physics-researcher/methodology/arxiv-literature-search.md",
      "target": "roles/physics-researcher/methodology/arxiv-literature-search.md"
