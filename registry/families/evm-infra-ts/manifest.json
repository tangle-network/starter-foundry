{
  "id": "evm-infra-ts",
  "description": "Minimal EVM infrastructure service for RPC monitoring, viem scripts, and chain-aware APIs.",
  "tags": [
    "evm",
    "typescript",
    "infra",
    "api"
  ],
  "taxonomy": {
    "language": "javascript",
    "runtime": "node",
    "surface": "evm-infra"
  },
  "slots": {
    "database": {
      "options": [
        "database:sqlite",
        "database:postgres",
        "database:mongodb",
        "database:convex"
      ],
      "default": "database:sqlite"
    },
    "sdk": {
      "options": [
        "sdk:none",
        "sdk:coinbase-cdp",
        "sdk:solana-web3",
        "sdk:evm-wallet"
      ],
      "default": "sdk:none"
    },
    "auth": {
      "options": [
        "auth:none",
        "auth:better-auth",
        "auth:clerk",
        "auth:supabase-auth"
      ],
      "default": "auth:none"
    },
    "payments": {
      "options": [
        "payments:none",
        "payments:stripe",
        "payments:coinbase-commerce"
      ],
      "default": "payments:none"
    },
    "queue": {
      "options": [
        "queue:none",
        "queue:bullmq",
        "queue:trigger-dev"
      ],
      "default": "queue:none"
    }
  },
  "defaults": {
    "serviceName": "starter-foundry-evm-infra",
    "chainName": "ethereum",
    "nativeToken": "ETH",
    "port": 4197
  },
  "files": [
    {
      "source": "files/package.json",
      "target": "package.json"
    }
  ],
  "validationChecks": [
    {
      "type": "file-exists",
      "path": "server.mjs"
    },
    {
      "type": "file-exists",
      "path": "chain-config.json"
    },
    {
      "type": "node-syntax",
      "path": "server.mjs"
    },
    {
      "type": "http-start",
      "command": [
        "node",
        "server.mjs"
      ],
      "path": "/health",
      "expect": "\"evm-infra\""
    }
  ],
  "contextHints": {
    "commands": [
      "node server.mjs"
    ],
    "entrypoints": [
      "server.mjs",
      "chain-config.json"
    ],
    "preview": {
      "path": "/stats"
    },
    "extensionPoints": [
      "chain-config.json",
      "sdk-config.json",
      "database-config.json",
      "hooks.mjs"
    ]
  },
  "keywords": [
    "viem",
    "ethers",
    "rpc",
    "block monitor",
    "gas price",
    "transaction count",
    "multicall",
    "wallet balance",
    "okb",
    "oklink",
    "okx",
    "x layer",
    "xlayer",
    "/stats"
  ]
}
