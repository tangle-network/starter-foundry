{
  "id": "tangle-blueprint",
  "description": "Lean Tangle Blueprint starter with Rust job handler and manifest.",
  "tags": [
    "tangle",
    "blueprint",
    "rust",
    "infra"
  ],
  "taxonomy": {
    "language": "rust",
    "runtime": "tangle",
    "surface": "blueprint"
  },
  "defaults": {
    "blueprintName": "starter-blueprint",
    "jobName": "ProcessJob"
  },
  "validationChecks": [
    {
      "type": "file-exists",
      "path": "Cargo.toml"
    },
    {
      "type": "file-exists",
      "path": "blueprint.json"
    },
    {
      "type": "command-success",
      "command": [
        "cargo",
        "test",
        "--quiet"
      ],
      "expect": "test result: ok"
    }
  ],
  "contextHints": {
    "commands": [
      "cargo test",
      "cargo run -- --once"
    ],
    "entrypoints": [
      "src/main.rs",
      "src/lib.rs",
      "blueprint.json",
      "Cargo.toml"
    ],
    "preview": null,
    "extensionPoints": [
      "blueprint.json",
      "src/lib.rs"
    ]
  },
  "keywords": [
    "tangle blueprint",
    "blueprint sdk",
    "cargo tangle",
    "oracle blueprint",
    "storage blueprint",
    "tangle network",
    "tangle native",
    "tangle oracle",
    "tangle custody",
    "frost blueprint"
  ],
  "tieredKeywords": {
    "tier1": [
      "tangle blueprint",
      "cargo tangle"
    ],
    "tier2": [
      "blueprint sdk",
      "oracle blueprint",
      "storage blueprint",
      "tangle network",
      "tangle native",
      "tangle oracle",
      "tangle custody",
      "frost blueprint"
    ]
  }
}
