{
  "id": "agent-runtime-recruiter-ts",
  "description": "Technical-recruiter agent bundle — drafts JDs, designs structured screening rubrics, and composes interview loops. Hard-refuses any input or inference about protected-class attributes (race / gender / age / national-origin / disability). Hiring decisions stay with humans; the agent produces artifacts (`:::artifact`) the hiring team reviews, edits, and signs off on. Demonstrates the agent-runtime substrate composing with structured-output-blocks on the Tangle floor for a moderate-stakes operations workflow.",
  "tags": [
    "agent-runtime",
    "recruiting",
    "talent-acquisition",
    "structured-interviews",
    "cloudflare-worker"
  ],
  "taxonomy": {
    "language": "markdown",
    "runtime": "cloudflare-worker",
    "surface": "agent-runtime"
  },
  "includes": [
    "agent-base:tangle",
    "agent-output:blocks"
  ],
  "defaults": {
    "projectType": "agent-runtime-recruiter",
    "agentName": "technical-recruiter",
    "allowedDomains": ["api.tangle.tools"],
    "allowedEnv": ["TANGLE_ROUTER_KEY"],
    "publicVars": ["AGENT_NAME"],
    "routes": [
      { "path": "/api/chat", "auth": "bearer", "callsTools": ["jd-drafter", "rubric-builder", "loop-composer"] },
      { "path": "/api/health", "auth": "none", "callsTools": [] }
    ],
    "declaredCapabilities": ["jd-drafting", "screening-rubric-design", "interview-loop-design"],
    "runtime": {
      "sandbox": "tangle",
      "noNewPrivileges": true,
      "capDrop": "ALL"
    },
    "biasSafeguards": {
      "protectedClassRefusal": true,
      "compensationPolicy": "published-bands-only",
      "inclusiveLanguageAudit": true,
      "structuredInterviewDefault": true
    }
  },
  "files": [
    { "source": "files/system-prompt.md", "target": "system-prompt.md" },
    { "source": "files/templates/index.json", "target": "templates/index.json" },
    { "source": "files/templates/jd-drafting-protocol.md", "target": "templates/jd-drafting-protocol.md" },
    { "source": "files/templates/screening-rubric.md", "target": "templates/screening-rubric.md" },
    { "source": "files/templates/interview-loop-design.md", "target": "templates/interview-loop-design.md" },
    { "source": "files/wrangler.toml", "target": "wrangler.toml" },
    { "source": "files/README.md", "target": "README.md" }
  ],
  "validationChecks": [
    { "type": "file-exists", "path": "system-prompt.md" },
    { "type": "file-exists", "path": "templates/index.json" },
    { "type": "file-exists", "path": "wrangler.toml" },
    { "type": "prompt-frontmatter-valid", "path": "system-prompt.md" },
    { "type": "template-index-valid", "path": "templates/index.json" },
    { "type": "cron-syntax-valid", "path": "wrangler.toml" }
  ],
  "contextHints": {
    "commands": [],
    "entrypoints": ["system-prompt.md"],
    "extensionPoints": ["templates/", "src/lib/tools/"]
  },
  "keywords": [
    "recruiting",
    "talent-acquisition",
    "technical-recruiter",
    "screening",
    "interview-design",
    "compensation-bands"
  ],
  "tieredKeywords": {
    "tier1": ["technical-recruiter", "technical recruiter", "recruiter-agent", "recruiter agent", "talent-pipeline", "talent pipeline", "talent acquisition"],
    "tier2": ["sourcing", "screening", "interview-design", "interview design", "leveling", "compensation-bands", "compensation bands", "interview-loop", "interview loop"],
    "tier3": ["recruiter", "hiring"],
    "archetypes": ["agent-in-sandbox", "operations-agent"]
  }
}
